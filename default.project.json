            0.2902,
            0.3098,
            0.3608
          ],
          "Locked": true,
          "Material": "Slate",
          "Position": [
            0,
            -5,
            0
          ],
          "Size": [
            256,
            10,
            256
          ],
          "TopSurface": "Smooth"
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Neutral": true,
          "Enabled": true,
          "Duration": 10,
          "Size": [
            12,
            1,
            12
          ],
          "Color": [
            1,
            0,
            1
          ],
          "Position": [
            0,
            0.5,
            0
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0.30588,
          0.31373,
          0.37647
        ],
        "Brightness": 2.2,
        "ClockTime": 14,
        "EnvironmentDiffuseScale": 0.5,
        "EnvironmentSpecularScale": 0.4,
        "FogColor": [
          0.15686,
          0.16863,
          0.22745
        ],
        "FogEnd": 320,
        "FogStart": 140,
        "GlobalShadows": true,
        "Outlines": false,
