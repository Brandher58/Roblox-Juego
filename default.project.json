          "Position": [
            0,
            -5,
            0
          ],
          "Size": [
            256,
            10,
            256
          ]
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Neutral": true,
          "Enabled": true,
          "Duration": 10,
          "Size": [
            12,
            1,
            12
          ],
          "Color": [
            1,
            0,
            1
          ],
          "Position": [
            0,
            0.5,
            0
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
