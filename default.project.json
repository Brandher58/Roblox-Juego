{
  "name": "Roblox-Juego",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },

      "Remotes": {
        "$className": "Folder",

        "MatchStateChanged": {
          "$className": "RemoteEvent"
        },
        "RunSnapshot": {
          "$className": "RemoteEvent"
        },
        "UpgradeChosen": {
          "$className": "RemoteEvent"
        },
        "ClientReady": {
          "$className": "RemoteEvent"
        },
        "RequestUpgrade": {
          "$className": "RemoteEvent"
        },
        "CombatEffect": {
          "$className": "UnreliableRemoteEvent"
        }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "Baseplate": {
