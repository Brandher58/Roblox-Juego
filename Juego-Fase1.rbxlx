        <Item class="Folder" referent="103">
          <Properties>
            <string name="Name">Admin</string>
          </Properties>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">AdminMenu</string>
              <string name="Source"><![CDATA[--!strict
-- Menú de administración del cliente, SOLO en Studio. Botones de playtest que
-- envían comandos al servidor; el servidor valida cada uno (Admin.luau), el menú
-- solo pide. Se alterna con F2 y no se construye en builds de producción.
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared:WaitForChild("Registry"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local UIKit = require(script.Parent.Parent.UI.UIKit)

type RunSnapshot = Types.RunSnapshot

local AdminMenu = {}

local ROW = 28
local GAP = 4
local TITLE_HEIGHT = 34
local MAIN_BUTTONS = 5
local PANEL_WIDTH = 310
local PANEL_HEIGHT = 560

local weaponLevelLabels: { [string]: TextLabel } = {}
local upgradeLevelLabels: { [string]: TextLabel } = {}

local function mainButton(parent: Frame, y: number, text: string, command: string, value: unknown?)
	local row = Instance.new("TextButton")
	row.Name = command
	row.Size = UDim2.new(1, -16, 0, ROW)
	row.Position = UDim2.new(0, 8, 0, y)
	row.BackgroundColor3 = Color3.fromRGB(38, 44, 58)
	row.BackgroundTransparency = 0.08
	row.BorderSizePixel = 0
	row.Text = text
	row.TextColor3 = Color3.fromRGB(230, 235, 245)
	row.TextSize = 14
	row.Font = Enum.Font.GothamBold
	row.AutoButtonColor = true
	row.Parent = parent
	UIKit.corner(row, UDim.new(0, 8))
	row.Activated:Connect(function()
		Remotes.AdminCommand:FireServer(command, value)
	end)
end

--Header within the scrolling list: small, muted, uppercase.
local function section(parent: Instance, text: string)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -16, 0, 18)
	label.BackgroundTransparency = 1
	label.Text = "—— " .. string.upper(text) .. " ——"
	label.TextColor3 = Color3.fromRGB(114, 124, 148)
	label.TextSize = 10
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.Parent = parent
end

-- Row inside the scrolling list: name on the left, current level in the middle,
-- and a "+1" button that asks the server for exactly one more level.
local function itemRow(parent: Instance, name: string, command: string, id: string)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -4, 0, ROW)
	row.BackgroundColor3 = Color3.fromRGB(34, 40, 54)
	row.BackgroundTransparency = 0.12
	row.BorderSizePixel = 0
	row.Parent = parent
	UIKit.corner(row, UDim.new(0, 6))

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(0.55, 0, 1, 0)
	nameLabel.Position = UDim2.new(0, 10, 0, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = name
	nameLabel.TextColor3 = Color3.fromRGB(228, 232, 240)
	nameLabel.TextSize = 13
	nameLabel.Font = Enum.Font.Gotham
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = row

	local lvl = Instance.new("TextLabel")
	lvl.Size = UDim2.new(0.2, 0, 1, 0)
	lvl.Position = UDim2.new(0.58, 0, 0, 0)
	lvl.BackgroundTransparency = 1
	lvl.Text = "0"
	lvl.TextColor3 = Color3.fromRGB(155, 165, 190)
	lvl.TextSize = 12
	lvl.Font = Enum.Font.GothamBold
	lvl.TextXAlignment = Enum.TextXAlignment.Right
	lvl.Parent = row
	if command == "level_up" then
		weaponLevelLabels[id] = lvl
	else
		upgradeLevelLabels[id] = lvl
	end

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.18, 0, 0.7, 0)
	btn.Position = UDim2.new(0.8, 0, 0.15, 0)
	btn.BackgroundColor3 = Color3.fromRGB(58, 118, 215)
	btn.BorderSizePixel = 0
	btn.Text = "+1"
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 13
	btn.Font = Enum.Font.GothamBold
	btn.AutoButtonColor = true
	btn.Parent = row
	UIKit.corner(btn, UDim.new(0, 6))
	btn.Activated:Connect(function()
		Remotes.AdminCommand:FireServer(command, id)
	end)
end

function AdminMenu.build()
	if not RunService:IsStudio() then
		return
	end

	local gui = UIKit.screen("AdminMenu", 60)
	local bar = UIKit.frame(
		gui,
		"Bar",
		UDim2.new(0, PANEL_WIDTH, 0, PANEL_HEIGHT),
		UDim2.new(0, 12, 0, 12),
		Vector2.new(0, 0),
		Color3.fromRGB(14, 16, 22)
	)
	UIKit.corner(bar, UDim.new(0, 10))
	UIKit.stroke(bar, Color3.fromRGB(255, 214, 92), 1)

	-- Título de la barra
	UIKit.label(
		bar,
		"Title",
		"DEV · ADMIN",
		UDim2.new(1, -16, 0, 20),
		UDim2.new(0, 12, 0, 7),
		nil,
		Color3.fromRGB(255, 214, 92),
		true
	)

	UIKit.label(
		bar,
		"Subtitle",
		"+1 por arma / mejora · F2 para ocultar",
		UDim2.new(1, -16, 0, 14),
		UDim2.new(0, 12, 0, 24),
		nil,
		Color3.fromRGB(140, 150, 170),
		false
	)

	mainButton(bar, TITLE_HEIGHT, "Desbloquear todo", "unlock_all")
	mainButton(bar, TITLE_HEIGHT + (ROW + GAP), "Armas y mejoras al tope", "max_all")
	mainButton(bar, TITLE_HEIGHT + (ROW + GAP) * 2, "+500 XP", "grant_xp", 500)
	mainButton(bar, TITLE_HEIGHT + (ROW + GAP) * 3, "Curar", "heal")
	mainButton(bar, TITLE_HEIGHT + (ROW + GAP) * 4, "+30 s", "skip_time", 30)

	-- Lista desplazable de armas y mejoras.
	local list = Instance.new("ScrollingFrame")
	list.Name = "WeaponList"
	list.Size = UDim2.new(1, -24, 1, -TITLE_HEIGHT - 20 - MAIN_BUTTONS * (ROW + GAP) - GAP)
	list.Position = UDim2.new(0, 12, 0, TITLE_HEIGHT + 20 + MAIN_BUTTONS * (ROW + GAP))
	list.BackgroundColor3 = Color3.fromRGB(11, 13, 19)
	list.BackgroundTransparency = 0.35
	list.BorderSizePixel = 0
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ScrollBarThickness = 8
	list.Parent = bar
	UIKit.corner(list, UDim.new(0, 6))

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, GAP)
	layout.Parent = list

	section(list, "Armas")
	for weaponId, weapon in pairs(Registry.Weapons) do
		itemRow(list, weapon.Name, "level_up", weaponId)
	end

	section(list, "Mejoras")
	for upgradeId, upgrade in pairs(Registry.Upgrades) do
		if upgrade.Kind == "NewWeapon" then
			continue
		end
		itemRow(list, upgrade.Name, "upgrade_level_up", upgradeId)
	end

	-- Refresca el nivel actual de cada fila cuando el servidor empuja un
	-- snapshot nuevo.
	Remotes.RunSnapshot.OnClientEvent:Connect(function(snapshot: RunSnapshot)
		for _, weapon in snapshot.Weapons do
			local lab = weaponLevelLabels[weapon.Id]
			if lab then
				lab.Text = `${weapon.Level}/${weapon.MaxLevel}`
			end
		end
		for _, passive in snapshot.Passives do
			local lab = upgradeLevelLabels[passive.Id]
			if lab then
				lab.Text = `${passive.Level}/${passive.MaxLevel}`
			end
		end
	end)

	-- F2 para apartarlo o volverlo a traer durante la prueba.
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.F2 then
			gui.Enabled = not gui.Enabled
		end
	end)
end

return AdminMenu
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="105">
          <Properties>
            <string name="Name">Camera</string>
          </Properties>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">TopDownCamera</string>
              <string name="Source"><![CDATA[--!strict
-- Cámara top-down isométrica ligera. Scriptable para que el motor no la sobrescriba,
-- y PreRender (nunca Heartbeat) para que la imagen vaya sincronizada con el frame.
-- No lee nada de la partida: sigue al personaje, y el servidor decide dónde está.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local localPlayer = game:GetService("Players").LocalPlayer
local camera = workspace.CurrentCamera

local connection: RBXScriptConnection? = nil

local TopDownCamera = {}

function TopDownCamera.start()
	if connection or not camera then
		return
	end

	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = Config.Camera.FieldOfView

	connection = RunService.PreRender:Connect(function(dt)
		local character = localPlayer.Character
		if not character then
			return
		end

		-- CameraSubject solo no puede ser nil: ponerlo lo revierte al anterior.
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid and camera.CameraSubject ~= humanoid then
			camera.CameraSubject = humanoid
		end

		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return
		end

		local focus = root.Position
		local goal = CFrame.lookAt(focus + Config.Camera.Offset, focus)
		camera.CFrame = camera.CFrame:Lerp(goal, math.min(dt * Config.Camera.Smoothing, 1))
	end)
end

function TopDownCamera.stop()
	if connection then
		connection:Disconnect()
		connection = nil
	end
end

return TopDownCamera
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="107">
          <Properties>
            <string name="Name">Input</string>
          </Properties>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">RunInput</string>
              <string name="Source"><![CDATA[--!strict
-- Entrada: usa los controles por defecto de Roblox (que ya cubren teclado, mando y
-- joystick táctil) y solo los desactiva cuando la partida está pausada. No se crea un
-- sistema de input paralelo: el HUD de móvil y el mando siguen funcionando igual.
--
-- El ControlModule interno de Roblox avisa ("Player:Move ... no character") si se le
-- pide moverse sin personaje. Con `CharacterAutoLoads = false` ese es justamente el
-- arranque del jugador, así que aquí hay dos defensas:
--   1. Los controles solo se habilitan cuando existe un Humanoid (estado deseado
--      recordado y aplicado en el CharacterAdded).
--   2. Su `moveFunction` se envuelve para que jamás mueva nada sin un Humanoid, lo
--      que cubre también la ventana anterior a que este script pueda desactivarlos.
local Players = game:GetService("Players")

local localPlayer = Players.LocalPlayer
local playerModule = require(localPlayer.PlayerScripts:WaitForChild("PlayerModule"))
local controls = playerModule:GetControls()

local function hasHumanoid(): boolean
	local character = localPlayer.Character
	return character ~= nil and character:FindFirstChildOfClass("Humanoid") ~= nil
end

-- Parche del ControlModule: el warning es interno, esto lo corta en la raíz sin
-- cambiar el comportamiento con personaje (el resto de la lógica de movimiento es
-- la original).
local originalMove = controls.moveFunction :: any
if type(originalMove) == "function" then
	controls.moveFunction = function(...)
		if not hasHumanoid() then
			return
		end
		return originalMove(...)
	end
end

-- Esta es la marca: `enabled` es lo que el juego quiere, `applied` es lo que los
-- controles tienen de verdad. Nunca se habilitan sin un Humanoid presente.
local enabled = false
local applied = false

local function apply()
	local shouldEnable = enabled and hasHumanoid()
	if shouldEnable == applied then
		return
	end
	applied = shouldEnable
	if shouldEnable then
		controls:Enable()
	else
		controls:Disable()
	end
end

local RunInput = {}

function RunInput.setEnabled(next: boolean)
	enabled = next
	apply()
end

function RunInput.isEnabled(): boolean
	return enabled
end

-- Al aparecer o desaparecer el personaje se reevalúa el estado deseado (y se apaga
-- al instante al morir, antes de que el ControlModule intente mover a nadie). Se
-- espera al Humanoid: en el CharacterAdded el modelo suele traerlo ya, pero un
-- frame perdido aquí dejaría al jugador sin moverse toda la partida.
localPlayer.CharacterAdded:Connect(function(character: Model)
	if not character:WaitForChild("Humanoid", 10) then
		return
	end
	apply()
end)
localPlayer.CharacterRemoving:Connect(function()
	if applied then
		applied = false
		controls:Disable()
	end
end)

-- Arranque: con `CharacterAutoLoads=false` el jugador aún no tiene personaje, así
-- que los controles empiezan desactivados en lugar de emitir el warning interno.
if localPlayer.Character then
	apply()
else
	controls:Disable()
	applied = false
end

return RunInput
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="109">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Arranque del cliente: construye la UI, conecta los listeners y avisa de que está
-- listo. Nada de aquí concede nada; el cliente pide y el servidor decide.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local TopDownCamera = require(script.Parent.Camera.TopDownCamera)
local RunInput = require(script.Parent.Input.RunInput)
local Hud = require(script.Parent.UI.Hud)
local LevelUpPanel = require(script.Parent.UI.LevelUpPanel)
local ResultPanel = require(script.Parent.UI.ResultPanel)
local MissionPanel = require(script.Parent.UI.MissionPanel)
local MissionHud = require(script.Parent.UI.MissionHud)
local CombatFeedback = require(script.Parent.VFX.CombatFeedback)
local AdminMenu = require(script.Parent.Admin.AdminMenu)

type MatchState = Types.MatchState
type RunSnapshot = Types.RunSnapshot
type UpgradeOffer = Types.UpgradeOffer
type MissionSummary = Types.MissionSummary
type MissionSnapshot = Types.MissionSnapshot
type MissionResult = Types.MissionResult

Hud.build()
LevelUpPanel.build(function(upgradeId: string)
	Remotes.RequestUpgrade:FireServer(upgradeId)
end)
ResultPanel.build()
MissionPanel.build(function(missionId: string)
	Remotes.RequestMission:FireServer(missionId)
end)
MissionHud.build()
CombatFeedback.build()
AdminMenu.build()
TopDownCamera.start()

local lastLevel = 1
local lastElapsed = 0
local lastResult: MissionResult? = nil
local lastResultState: MatchState? = nil
local currentState: MatchState = "Lobby"

Remotes.RunSnapshot.OnClientEvent:Connect(function(snapshot: RunSnapshot)
	lastLevel = snapshot.Level
	Hud.apply(snapshot)
end)

Remotes.MatchStateChanged.OnClientEvent:Connect(
	function(state: MatchState, elapsed: number, offers: { UpgradeOffer }?)
		currentState = state
		-- Los estados "Event" y "Boss" también simulan: la partida sigue viva, así que el
		-- jugador mantiene el control. En "MissionSelect" el panel de misión manda.
		local simulated = state == "Playing" or state == "Event" or state == "Boss"
		RunInput.setEnabled(simulated)

		if state == "LevelUp" and offers and #offers > 0 then
			LevelUpPanel.show(offers)
		else
			LevelUpPanel.hide()
		end

		if state == "Defeat" or state == "Victory" then
			lastElapsed = elapsed
			lastResultState = state
			ResultPanel.show(state, elapsed, lastLevel, lastResult)
		else
			lastResultState = nil
			ResultPanel.hide()
		end

		MissionPanel.setVisible(state == "MissionSelect")
		if state == "MissionSelect" then
			lastResult = nil
		end
	end
)

-- Lista de misiones con el estado de ESTE jugador. El panel solo es visible en el
-- estado de selección; si la lista llega antes, ya se pinta para cuando toque.
Remotes.MissionList.OnClientEvent:Connect(function(missions: { MissionSummary })
	MissionPanel.setMissions(missions)
	MissionPanel.setVisible(currentState == "MissionSelect")
end)

Remotes.MissionUpdate.OnClientEvent:Connect(function(snapshot: MissionSnapshot?)
	MissionHud.apply(snapshot)
end)

-- Resultado final: se guarda para que la pantalla de resultado lo muestre cuando
-- llegue el estado Victory/Defeat (viaja en el mismo frame, antes que el estado).
Remotes.MissionFinished.OnClientEvent:Connect(function(result: MissionResult)
	lastResult = result
	-- Si el estado Victory/Defeat llegó antes, se repinta con el resultado ya presente.
	if lastResultState then
		ResultPanel.show(lastResultState, lastElapsed, lastLevel, lastResult)
	end
end)

Remotes.UpgradeChosen.OnClientEvent:Connect(function(_upgradeId: string)
	LevelUpPanel.hide()
end)

Remotes.CombatEffect.OnClientEvent:Connect(
	function(kind: string, position: Vector3, magnitude: number, target: Vector3?)
		CombatFeedback.play(kind, position, magnitude, target)
	end
)

-- Todos los listeners estan registrados: ahora si el servidor puede enviar el estado.
Remotes.ClientReady:FireServer()
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="110">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- HUD de la partida: reloj, nivel y XP, vida, y el resumen de la build (armas y
-- mejoras). Solo pinta el snapshot que envía el servidor: un botón del HUD nunca
-- concede nada, así que aquí no hay ninguna autoridad.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Utilities = Shared:WaitForChild("Utilities")
local Format = require(Utilities:WaitForChild("Format"))
local UIKit = require(script.Parent.UIKit)

type RunSnapshot = Types.RunSnapshot
type WeaponView = Types.WeaponView
type PassiveView = Types.PassiveView

local ROWS = 12
local PANEL_BG = Color3.fromRGB(14, 16, 22)

local timerLabel: TextLabel
local levelLabel: TextLabel
local xpBar: { Root: Frame, Fill: Frame }
local hpBar: { Root: Frame, Fill: Frame }
local hpLabel: TextLabel
local buffLabel: TextLabel
local rows: { { Root: Frame, Icon: TextLabel, Name: TextLabel, Level: TextLabel } } = {}

local function clampSize(frame: Frame, minimum: Vector2, maximum: Vector2)
	local constraint = Instance.new("UISizeConstraint")
	constraint.MinSize = minimum
	constraint.MaxSize = maximum
	constraint.Parent = frame
end

local Hud = {}

function Hud.build()
	local gui = UIKit.screen("Hud", 10)

	-- TOP: reloj + nivel + barra de XP
	local top =
		UIKit.frame(gui, "Top", UDim2.new(0.36, 0, 0, 74), UDim2.new(0.5, 0, 0, 10), Vector2.new(0.5, 0))
	clampSize(top, Vector2.new(220, 74), Vector2.new(420, 74))

	timerLabel = UIKit.label(
		top,
		"Timer",
		"0:00",
		UDim2.new(1, 0, 0, 34),
		nil,
		nil,
		Color3.fromRGB(245, 247, 252),
		true
	)
	timerLabel.TextXAlignment = Enum.TextXAlignment.Center
	timerLabel.TextSize = 26

	xpBar = UIKit.bar(top, "XPBar", 14, Color3.fromRGB(255, 214, 92))
	xpBar.Root.Position = UDim2.new(0, 0, 0, 40)

	levelLabel = UIKit.label(
		xpBar.Root,
		"Level",
		"NIV 1",
		UDim2.new(1, -12, 1, 0),
		UDim2.new(0, 6, 0, 0),
		nil,
		Color3.fromRGB(18, 20, 26),
		true
	)
	levelLabel.TextSize = 11

	-- Debajo del reloj: buffs temporales con su cuenta atrás. Se oculta solo cuando no
	-- hay ninguno, así que no ocupa sitio en el 99% de la partida.
	buffLabel = UIKit.label(
		gui,
		"Buffs",
		"",
		UDim2.new(0.7, 0, 0, 22),
		UDim2.new(0.5, 0, 0, 92),
		Vector2.new(0.5, 0),
		Config.UI.Accent,
		true
	)
	buffLabel.TextSize = 14
	buffLabel.TextXAlignment = Enum.TextXAlignment.Center

	-- ABAJO IZQUIERDA: vida
	local health = UIKit.frame(
		gui,
		"Health",
		UDim2.new(0.22, 0, 0, 46),
		UDim2.new(0, 20, 1, -20),
		Vector2.new(0, 1),
		PANEL_BG
	)
	clampSize(health, Vector2.new(190, 46), Vector2.new(330, 46))

	hpBar = UIKit.bar(health, "HPBar", 14, Color3.fromRGB(226, 84, 96))
	hpBar.Root.Position = UDim2.new(0, 10, 0, 8)
	hpBar.Root.Size = UDim2.new(1, -20, 0, 14)

	hpLabel = UIKit.label(
		health,
		"HPText",
		"100 / 100",
		UDim2.new(1, 0, 0, 16),
		UDim2.new(0, 0, 0, 26),
		nil,
		Color3.fromRGB(214, 219, 228)
	)
	hpLabel.TextSize = 13

	-- ABAJO DERECHA: armas y mejoras
	local build = UIKit.frame(
		gui,
		"Build",
		UDim2.new(0.2, 0, 0, 26 + ROWS * 26),
		UDim2.new(1, -20, 1, -20),
		Vector2.new(1, 1),
		PANEL_BG
	)
	clampSize(build, Vector2.new(180, 120), Vector2.new(300, 340))

	for index = 1, ROWS do
		local row = UIKit.frame(
			build,
			`Row{index}`,
			UDim2.new(1, -16, 0, 22),
			UDim2.new(0, 8, 0, 6 + (index - 1) * 26),
			nil,
			Color3.fromRGB(24, 27, 35)
		)
		local icon = UIKit.label(row, "Icon", "", UDim2.new(0, 24, 1, 0))
		icon.TextSize = 15
		local name = UIKit.label(row, "Name", "", UDim2.new(1, -66, 1, 0), UDim2.new(0, 26, 0, 0))
		name.TextSize = 13
		local level = UIKit.label(
			row,
			"Level",
			"",
			UDim2.new(0, 44, 1, 0),
			UDim2.new(1, -6, 0, 0),
			nil,
			Color3.fromRGB(168, 175, 188)
		)
		level.TextSize = 12
		level.TextXAlignment = Enum.TextXAlignment.Right
		table.insert(rows, { Root = row, Icon = icon, Name = name, Level = level })
	end
end

function Hud.apply(snapshot: RunSnapshot)
	timerLabel.Text = Format.clock(snapshot.Elapsed)

	local xpRatio = if snapshot.XPToNext > 0 then snapshot.XP / snapshot.XPToNext else 0
	xpBar.Fill.Size = UDim2.new(math.clamp(xpRatio, 0, 1), 0, 1, 0)
	levelLabel.Text = `NIV {snapshot.Level}`

	local healthRatio = if snapshot.MaxHealth > 0 then snapshot.Health / snapshot.MaxHealth else 0
	hpBar.Fill.Size = UDim2.new(math.clamp(healthRatio, 0, 1), 0, 1, 0)
	hpLabel.Text = `{math.ceil(snapshot.Health)} / {math.ceil(snapshot.MaxHealth)}`

	if #snapshot.Buffs > 0 then
		local active = {}
		for _, buff in snapshot.Buffs do
			table.insert(active, `{buff.Name} {math.ceil(buff.Remaining)}s`)
		end
		buffLabel.Text = table.concat(active, "   ")
		buffLabel.Visible = true
	else
		buffLabel.Visible = false
	end

	local index = 1
	local overflow = 0
	local function place(icon: string, name: string, level: number, maxLevel: number)
		if index > ROWS then
			overflow += 1
			return
		end
		local row = rows[index]
		row.Icon.Text = icon
		row.Name.Text = name
		row.Level.Text = `{level}/{maxLevel}`
		row.Root.Visible = true
		index += 1
	end

	for _, weapon in snapshot.Weapons do
		place(weapon.Icon, weapon.Name, weapon.Level, weapon.MaxLevel)
	end
	for _, passive in snapshot.Passives do
		place(passive.Icon, passive.Name, passive.Level, passive.MaxLevel)
	end
	for slot = index, ROWS do
		rows[slot].Root.Visible = false
	end

	-- Una build larga no puede esconder entradas sin avisar: la ultima fila tella
	-- cuantas quedan fuera en vez de dejar al jugador creyendo que se las comio.
	if overflow > 0 then
		local row = rows[ROWS]
		row.Icon.Text = "+"
		row.Name.Text = `{overflow} mas`
		row.Level.Text = ""
		row.Root.Visible = true
	end
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">LevelUpPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Panel de subida de nivel. Es presentacion pura: muestra las ofertas que envia el
-- servidor y devuelve el identificador elegido. La carta se aplica en el servidor.
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local UIKit = require(script.Parent.UIKit)

type UpgradeOffer = Types.UpgradeOffer

local GAP = Config.UI.CardGap
local MIN_CARD_WIDTH = 150
local SIDE_MARGIN = 24

local CARD_BG = Color3.fromRGB(19, 21, 28)
local MUTED = Color3.fromRGB(158, 165, 178)

local gui: ScreenGui? = nil
local row: Frame? = nil
local onChoose: ((string) -> ())? = nil
local current: { UpgradeOffer } = {}

local function viewport(): Vector2
	local camera = workspace.CurrentCamera
	return if camera then camera.ViewportSize else Vector2.new(1280, 720)
end

local function clearCards()
	if not row then
		return
	end
	for _, child in row:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- Tarjeta de una oferta. El hueco y el centrado los pone un UIListLayout, no una
-- cuenta de posiciones: asi el grupo queda centrado para cualquier numero de cartas
-- y en cualquier viewport sin tocar la aritmetica.
local function buildCard(offer: UpgradeOffer, size: UDim2, index: number): TextButton
	local color = UIKit.rarityColor(offer.Rarity)

	local card = UIKit.frame(row :: Instance, "Card", size, UDim2.new(0, 0, 0, 0), Vector2.new(0, 0), CARD_BG)
	card.LayoutOrder = index
	local stroke = UIKit.stroke(card, color, 2)

	-- Tinte de raton/mando. Se crea antes que las etiquetas para quedar detras de ellas.
	local hover = UIKit.frame(card, "Hover", UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), nil, color)
	hover.BackgroundTransparency = 1

	local button = Instance.new("TextButton")
	button.Name = "Pick"
	button.Size = UDim2.new(1, 0, 1, 0)
	button.BackgroundTransparency = 1
	button.Text = ""
	button.AutoButtonColor = false
	button.Parent = card

	local strip = UIKit.frame(card, "Rarity", UDim2.new(1, 0, 0, 5), UDim2.new(0, 0, 0, 0), nil, color)
	strip.BackgroundTransparency = 0

	local icon = UIKit.label(card, "Icon", offer.Icon, UDim2.new(1, 0, 0, 74), UDim2.new(0, 0, 0, 16))
	icon.TextSize = 46
	icon.TextXAlignment = Enum.TextXAlignment.Center

	local name = UIKit.label(card, "Name", offer.Name, UDim2.new(1, -16, 0, 28), UDim2.new(0, 8, 0, 92))
	name.TextSize = 21
	name.TextXAlignment = Enum.TextXAlignment.Center

	local levelText = if offer.Kind == "NewWeapon"
		then "NUEVA ARMA"
		else `{offer.CurrentLevel}  >  {offer.NextLevel}`
	local levelLabel = UIKit.label(
		card,
		"Level",
		levelText,
		UDim2.new(1, -16, 0, 20),
		UDim2.new(0, 8, 0, 122),
		nil,
		color,
		true
	)
	levelLabel.TextSize = 14
	levelLabel.TextXAlignment = Enum.TextXAlignment.Center

	local rarityLabel = UIKit.label(
		card,
		"Rarity",
		string.upper(offer.Rarity),
		UDim2.new(1, -16, 0, 16),
		UDim2.new(0, 8, 0, 144),
		nil,
		MUTED
	)
	rarityLabel.TextSize = 11
	rarityLabel.TextXAlignment = Enum.TextXAlignment.Center

	local description = UIKit.label(
		card,
		"Description",
		offer.Description,
		UDim2.new(1, -22, 1, -212),
		UDim2.new(0, 11, 0, 168)
	)
	description.TextSize = 14
	description.TextColor3 = Color3.fromRGB(186, 192, 204)
	description.TextXAlignment = Enum.TextXAlignment.Center

	-- Atajo de teclado: en PC es la forma mas rapida de elegir, y el numero coincide con
	-- la posicion de la carta.
	local badge = UIKit.frame(
		card,
		"Badge",
		UDim2.fromOffset(24, 24),
		UDim2.new(1, -34, 1, -34),
		Vector2.new(0, 0),
		Color3.fromRGB(32, 35, 44)
	)
	local badgeLabel =
		UIKit.label(badge, "Text", tostring(index), UDim2.new(1, 0, 1, 0), nil, nil, color, true)
	badgeLabel.TextSize = 13
	badgeLabel.TextXAlignment = Enum.TextXAlignment.Center

	local function choose()
		if onChoose then
			onChoose(offer.Id)
		end
	end

	local function setHover(entered: boolean)
		hover.BackgroundTransparency = if entered then 0.88 else 1
		stroke.Thickness = if entered then 3 else 2
	end

	button.Activated:Connect(choose)
	button.MouseEnter:Connect(function()
		setHover(true)
	end)
	button.MouseLeave:Connect(function()
		setHover(false)
	end)
	button.MouseButton1Down:Connect(function()
		setHover(true)
	end)
	button.Selectable = true
	return button
end

local LevelUpPanel = {}

function LevelUpPanel.build(chooseHandler: (string) -> ())
	onChoose = chooseHandler

	gui = UIKit.screen("LevelUpPanel", 20)
	gui.Enabled = false

	local dim =
		UIKit.frame(gui, "Dim", UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), nil, Color3.fromRGB(7, 8, 12))
	dim.BackgroundTransparency = 0.45

	local title = UIKit.label(
		gui,
		"Title",
		"NIVEL SUPERADO",
		UDim2.new(1, 0, 0, 46),
		UDim2.new(0, 0, 0.2, 0),
		nil,
		Config.UI.Accent,
		true
	)
	title.TextSize = 34
	title.TextXAlignment = Enum.TextXAlignment.Center

	local subtitle = UIKit.label(
		gui,
		"Subtitle",
		"Elige una mejora",
		UDim2.new(1, 0, 0, 22),
		UDim2.new(0, 0, 0.2, 46),
		nil,
		MUTED
	)
	subtitle.TextSize = 16
	subtitle.TextXAlignment = Enum.TextXAlignment.Center

	row = UIKit.frame(
		gui,
		"Row",
		UDim2.new(1, -SIDE_MARGIN * 2, 0.5, 0),
		UDim2.new(0.5, 0, 0.55, 0),
		Vector2.new(0.5, 0.5)
	)
	row.BackgroundTransparency = 1

	-- El centrado lo hace el layout, no la posicion de cada carta: asi el grupo queda
	-- centrado con 3 o con 4 ofertas y en cualquier resolucion sin aritmetica.
	local layout = Instance.new("UIListLayout")
	layout.Name = "Layout"
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, GAP)
	layout.Parent = row

	-- En movil y consola las cartas cambian de tamano; reconstruirlas es mas barato
	-- que mantener un layout manual sincronizado con el viewport.
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if #current > 0 then
				LevelUpPanel.show(current)
			end
		end)
	end

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or #current == 0 then
			return
		end
		local index = if input.KeyCode == Enum.KeyCode.One
			then 1
			elseif input.KeyCode == Enum.KeyCode.Two then 2
			elseif input.KeyCode == Enum.KeyCode.Three then 3
			elseif input.KeyCode == Enum.KeyCode.Four then 4
			else nil
		if index and current[index] then
			onChoose(current[index].Id)
		end
	end)
end

function LevelUpPanel.show(offers: { UpgradeOffer })
	if not gui or not row then
		return
	end

	current = offers
	clearCards()

	local size = viewport()
	local count = math.max(1, #offers)
	local available = size.X - SIDE_MARGIN * 2 - GAP * (count - 1)
	local width = math.clamp(available / count, MIN_CARD_WIDTH, Config.UI.CardWidth)
	local height = math.min(Config.UI.CardHeight, size.Y * 0.55)
	local cardSize = UDim2.fromOffset(width, height)

	local firstButton: TextButton? = nil
	for index, offer in offers do
		local button = buildCard(offer, cardSize, index)
		firstButton = firstButton or button
	end

	gui.Enabled = true
	GuiService.SelectedObject = firstButton
end

function LevelUpPanel.hide()
	if not gui then
		return
	end
	current = {}
	gui.Enabled = false
	GuiService.SelectedObject = nil
	clearCards()
end

return LevelUpPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">MissionHud</string>
              <string name="Source"><![CDATA[--!strict
-- HUD de misión: objetivos en curso y barra del jefe. Presentación pura: solo pinta
-- la instantánea que envía el servidor.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Format = require(Shared:WaitForChild("Utilities"):WaitForChild("Format"))
local UIKit = require(script.Parent.UIKit)

type MissionSnapshot = Types.MissionSnapshot

local PANEL_BG = Color3.fromRGB(14, 16, 22)
local MUTED = Color3.fromRGB(158, 165, 178)

local gui: ScreenGui? = nil
local title: TextLabel? = nil
local clock: TextLabel? = nil
local objectiveLabel: TextLabel? = nil
local bossRoot: Frame? = nil
local bossName: TextLabel? = nil
local bossBar: { Root: Frame, Fill: Frame }? = nil
local bossHp: TextLabel? = nil

local MissionHud = {}

function MissionHud.build()
	gui = UIKit.screen("MissionHud", 11)
	gui.Enabled = false

	local panel =
		UIKit.frame(gui, "Objectives", UDim2.new(0, 300, 0, 110), UDim2.new(0, 20, 0, 100), nil, PANEL_BG)
	local constraint = Instance.new("UISizeConstraint")
	constraint.MinSize = Vector2.new(220, 90)
	constraint.MaxSize = Vector2.new(380, 220)
	constraint.Parent = panel

	title = UIKit.label(
		panel,
		"Title",
		"",
		UDim2.new(1, -20, 0, 24),
		UDim2.new(0, 10, 0, 8),
		nil,
		Color3.fromRGB(255, 214, 92),
		true
	)
	title.TextSize = 16

	clock = UIKit.label(panel, "Clock", "", UDim2.new(1, -20, 0, 18), UDim2.new(0, 10, 0, 30), nil, MUTED)
	clock.TextSize = 13

	objectiveLabel = UIKit.label(
		panel,
		"Lines",
		"",
		UDim2.new(1, -20, 1, -58),
		UDim2.new(0, 10, 0, 50),
		nil,
		Color3.fromRGB(214, 219, 228)
	)
	objectiveLabel.TextSize = 14
	objectiveLabel.TextYAlignment = Enum.TextYAlignment.Top

	-- Barra del jefe: solo aparece cuando hay jefe activo.
	bossRoot = UIKit.frame(
		gui,
		"Boss",
		UDim2.new(0, 460, 0, 54),
		UDim2.new(0.5, 0, 1, -120),
		Vector2.new(0.5, 0),
		PANEL_BG
	)
	bossRoot.Visible = false

	bossName = UIKit.label(
		bossRoot,
		"Name",
		"",
		UDim2.new(1, -20, 0, 20),
		UDim2.new(0, 10, 0, 6),
		nil,
		Color3.fromRGB(238, 116, 116),
		true
	)
	bossName.TextSize = 15

	bossBar = UIKit.bar(bossRoot, "BossBar", 14, Color3.fromRGB(226, 84, 96))
	bossBar.Root.Position = UDim2.new(0, 10, 0, 28)
	bossBar.Root.Size = UDim2.new(1, -20, 0, 14)

	bossHp = UIKit.label(bossRoot, "Hp", "", UDim2.new(1, -20, 0, 14), UDim2.new(0, 10, 0, 40), nil, MUTED)
	bossHp.TextSize = 11
	bossHp.TextXAlignment = Enum.TextXAlignment.Right
end

function MissionHud.apply(snapshot: MissionSnapshot?)
	if
		not gui
		or not title
		or not clock
		or not objectiveLabel
		or not bossRoot
		or not bossBar
		or not bossName
		or not bossHp
	then
		return
	end

	if not snapshot then
		gui.Enabled = false
		return
	end

	gui.Enabled = true
	title.Text = snapshot.DisplayName
	clock.Text = if snapshot.Remaining
		then `{Format.clock(snapshot.Elapsed)}  ·  quedan {Format.clock(snapshot.Remaining)}`
		else Format.clock(snapshot.Elapsed)

	local lines: { string } = {}
	for _, objective in snapshot.Objectives do
		local mark = if objective.Complete then "✔" else "•"
		local progress = `{math.floor(objective.Current)}/{objective.Required}`
		table.insert(lines, `{mark} {objective.Label}   {progress}`)
	end
	objectiveLabel.Text = table.concat(lines, "\n")

	local boss = snapshot.Boss
	if boss and boss.Active then
		bossRoot.Visible = true
		bossName.Text = boss.Name
		local ratio = if boss.MaxHealth > 0 then boss.Health / boss.MaxHealth else 0
		bossBar.Fill.Size = UDim2.new(math.clamp(ratio, 0, 1), 0, 1, 0)
		bossHp.Text = `{math.ceil(boss.Health)} / {math.ceil(boss.MaxHealth)}`
	else
		bossRoot.Visible = false
	end
end

return MissionHud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">MissionPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Panel de selección de misión. Presentación pura: pinta los resúmenes que envía el
-- servidor y manda una petición al pulsar. Nunca cambia el estado ni concede nada.
--
-- Layout: cada tarjeta calcula su altura en píxeles fila a fila (título, meta,
-- objetivos, descripción, recompensas y pie con el botón). Nada usa tamaños en
-- porcentaje dentro de la tarjeta, así no hay texto que se pise ni que se salga.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local UIKit = require(script.Parent.UIKit)

type MissionSummary = Types.MissionSummary

local PANEL_BG = Color3.fromRGB(16, 18, 25)
local CARD_BG = Color3.fromRGB(21, 24, 32)
local CARD_BG_HOVER = Color3.fromRGB(29, 33, 43)
local DIVIDER = Color3.fromRGB(40, 44, 56)
local MUTED = Color3.fromRGB(158, 165, 178)
local TEXT_MAIN = Color3.fromRGB(240, 243, 250)
local OBJ_TEXT = Color3.fromRGB(200, 206, 218)
local GOLD_SOFT = Color3.fromRGB(214, 186, 122)
local GOLD = Color3.fromRGB(255, 214, 92)
local GREEN = Color3.fromRGB(108, 214, 122)

local STATE_COLORS = {
	Available = GOLD,
	Completed = GREEN,
	Locked = Color3.fromRGB(120, 126, 138),
}

local STATE_TEXT = {
	Available = "DISPONIBLE",
	Completed = "COMPLETADA",
	Locked = "BLOQUEADA",
}

local STATE_HINTS = {
	Available = "Pulsa EMPEZAR y entra al mapa",
	Completed = "Superada · progreso guardado",
	Locked = "Completa la misión anterior para desbloquear",
}

-- Métricas de fila de la tarjeta (píxeles, apiladas sin ambigüedad).
local TOP = 14
local HEAD_H = 30
local META_H = 18
local GAP = 6
local OBJ_LINE = 18
local DESC_H = 36
local REWARD_H = 16
local FOOTER_H = 40
local PAD_BOTTOM = 14

local gui: ScreenGui? = nil
local list: ScrollingFrame? = nil
local onStart: ((string) -> ())? = nil
local missions: { MissionSummary } = {}
local visible = false

local MissionPanel = {}

local function buildRewardText(mission: MissionSummary): string
	local parts: { string } = {}
	if mission.Rewards.Currency > 0 then
		table.insert(parts, `+{mission.Rewards.Currency} moneda`)
	end
	for _, unlocked in mission.Rewards.Missions do
		table.insert(parts, `Desbloquea {unlocked}`)
	end
	for _, unlocked in mission.Rewards.Maps do
		table.insert(parts, `Nuevo mapa: {unlocked}`)
	end
	if #parts == 0 then
		return ""
	end
	return "Recompensas: " .. table.concat(parts, "  ·  ")
end

local function missionNumber(mission: MissionSummary): string
	local part = mission.Id:match("_(%d+)$")
	return if part then `MISIÓN {part}` else "MISIÓN"
end

local function buildCard(mission: MissionSummary, index: number)
	if not list then
		return
	end

	local objectives: { string } = {}
	for _, objective in mission.Objectives do
		table.insert(objectives, `• {objective.Label} ({objective.Required})`)
	end

	local objectiveLines = math.max(1, #objectives)
	local rewardsText = buildRewardText(mission)
	local hasRewards = #rewardsText > 0

	local headY = TOP
	local metaY = headY + HEAD_H + GAP
	local objY = metaY + META_H + GAP
	local objH = objectiveLines * OBJ_LINE
	local descY = objY + objH + GAP
	local dividerY = descY + DESC_H + 3
	local rewardsY = dividerY + 1 + GAP
	local footerY = rewardsY + (if hasRewards then REWARD_H + GAP else 0)
	local height = footerY + FOOTER_H + PAD_BOTTOM

	local accent = STATE_COLORS[mission.State] or MUTED
	local isLocked = mission.State == "Locked"
	local isAvailable = mission.State == "Available"

	local card = UIKit.frame(
		list,
		`Mission_{mission.Id}`,
		UDim2.new(1, -14, 0, height),
		UDim2.new(0, 0, 0, 0),
		nil,
		CARD_BG
	)
	card.LayoutOrder = index
	card.ClipsDescendants = true

	local stroke = UIKit.stroke(card, accent, 1)
	stroke.Transparency = if isAvailable then 0.25 else 0.55

	-- Barra de acento superior (centrada, sutil).
	local strip = UIKit.frame(card, "Strip", UDim2.new(1, -32, 0, 3), UDim2.new(0, 16, 0, 0), nil, accent)
	strip.BackgroundTransparency = 0

	local title = UIKit.label(
		card,
		"Title",
		mission.DisplayName,
		UDim2.new(1, -190, 0, 26),
		UDim2.new(0, 16, 0, headY),
		nil,
		TEXT_MAIN,
		true
	)
	title.TextSize = 18

	-- Píldora de estado a la derecha, con fondo tintado y texto en contraste.
	local badge = UIKit.label(
		card,
		"State",
		STATE_TEXT[mission.State] or mission.State,
		UDim2.new(0, 130, 0, 24),
		UDim2.new(1, -146, 0, headY + 3),
		nil,
		if isLocked then MUTED else Color3.fromRGB(15, 17, 23),
		true,
		Enum.TextXAlignment.Center
	)
	badge.TextSize = 12
	badge.BackgroundTransparency = if isLocked then 0.6 else 0
	badge.BackgroundColor3 = accent
	UIKit.corner(badge, UDim.new(1, 0))

	local durationText = if mission.Duration > 0 then `objetivo {mission.Duration} s` else "jefe"
	local meta = UIKit.label(
		card,
		"Meta",
		`{missionNumber(mission)}  ·  {mission.MapName}  ·  {durationText}`,
		UDim2.new(1, -32, 0, META_H),
		UDim2.new(0, 16, 0, metaY),
		nil,
		MUTED
	)
	meta.TextSize = 13

	local objectiveLabel = UIKit.label(
		card,
		"Objectives",
		table.concat(objectives, "\n"),
		UDim2.new(1, -32, 0, objH),
		UDim2.new(0, 16, 0, objY),
		nil,
		OBJ_TEXT
	)
	objectiveLabel.TextSize = 13

	local description = UIKit.label(
		card,
		"Description",
		mission.Description,
		UDim2.new(1, -32, 0, DESC_H),
		UDim2.new(0, 16, 0, descY),
		nil,
		MUTED
	)
	description.TextSize = 12

	local divider =
		UIKit.frame(card, "Divider", UDim2.new(1, -32, 0, 1), UDim2.new(0, 16, 0, dividerY), nil, DIVIDER)
	divider.BackgroundTransparency = 0

	if hasRewards then
		local rewards = UIKit.label(
			card,
			"Rewards",
			rewardsText,
			UDim2.new(1, -32, 0, REWARD_H),
			UDim2.new(0, 16, 0, rewardsY),
			nil,
			GOLD_SOFT
		)
		rewards.TextSize = 12
	end

	-- Pie: botón de acción o pista según el estado. La fila está dedicada, así el
	-- botón nunca toca el texto de recompensas.
	if isAvailable then
		local button = Instance.new("TextButton")
		button.Name = "Start"
		button.Size = UDim2.new(0, 130, 0, 34)
		button.Position = UDim2.new(1, -150, 0, footerY + 3)
		button.BackgroundColor3 = accent
		button.BorderSizePixel = 0
		button.AutoButtonColor = true
		button.Font = Enum.Font.GothamBold
		button.Text = "EMPEZAR"
		button.TextColor3 = Color3.fromRGB(15, 17, 23)
		button.TextSize = 14
		button.Parent = card
		UIKit.corner(button, UDim.new(0, 8))
		button.Activated:Connect(function()
			if onStart then
				onStart(mission.Id)
			end
		end)

		-- Resalte al pasar el ratón (solo misiones jugables).
		card.MouseEnter:Connect(function()
			card.BackgroundColor3 = CARD_BG_HOVER
		end)
		card.MouseLeave:Connect(function()
			card.BackgroundColor3 = CARD_BG
		end)
	end

	local hint = UIKit.label(
		card,
		"Hint",
		STATE_HINTS[mission.State] or "",
		UDim2.new(1, -32, 0, FOOTER_H),
		UDim2.new(0, 16, 0, footerY),
		nil,
		if mission.State == "Completed" then GREEN else MUTED
	)
	hint.TextSize = 12
end

local function rebuild()
	if not list then
		return
	end
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for index, mission in missions do
		buildCard(mission, index)
	end
end

function MissionPanel.build(startHandler: (string) -> ())
	onStart = startHandler

	gui = UIKit.screen("MissionPanel", 25)
	gui.Enabled = false

	local dim =
		UIKit.frame(gui, "Dim", UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), nil, Color3.fromRGB(7, 8, 12))
	dim.BackgroundTransparency = 0.4

	local panel = UIKit.frame(
		gui,
		"Panel",
		UDim2.new(0, 760, 0, 600),
		UDim2.new(0.5, 0, 0.5, 0),
		Vector2.new(0.5, 0.5),
		PANEL_BG
	)
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new(Color3.fromRGB(26, 29, 39), Color3.fromRGB(12, 13, 19))
	gradient.Parent = panel

	local panelStroke = UIKit.stroke(panel, GOLD, 1)
	panelStroke.Transparency = 0.45

	local constraint = Instance.new("UISizeConstraint")
	constraint.MinSize = Vector2.new(380, 320)
	constraint.MaxSize = Vector2.new(820, 680)
	constraint.Parent = panel

	local title = UIKit.label(
		panel,
		"Title",
		"SELECCIONA MISIÓN",
		UDim2.new(1, 0, 0, 40),
		UDim2.new(0, 0, 0, 12),
		nil,
		TEXT_MAIN,
		true,
		Enum.TextXAlignment.Center
	)
	title.TextSize = 28

	local underline =
		UIKit.frame(panel, "Underline", UDim2.new(0, 120, 0, 3), UDim2.new(0.5, -60, 0, 54), nil, GOLD)
	underline.BackgroundTransparency = 0

	list = Instance.new("ScrollingFrame")
	list.Name = "List"
	list.Size = UDim2.new(1, -20, 1, -78)
	list.Position = UDim2.new(0, 10, 0, 68)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 6
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.Name = "Layout"
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 10)
	layout.Parent = list

	rebuild()
end

function MissionPanel.setMissions(nextMissions: { MissionSummary })
	missions = nextMissions
	rebuild()
	if gui then
		gui.Enabled = visible and #missions > 0
	end
end

function MissionPanel.setVisible(next: boolean)
	visible = next
	if gui then
		gui.Enabled = visible and #missions > 0
	end
end

return MissionPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">ResultPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Fin de partida: derrota o victoria, con el resultado de misión si lo hay. Solo pinta
-- lo que recibe del servidor.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Format = require(Shared:WaitForChild("Utilities"):WaitForChild("Format"))
local UIKit = require(script.Parent.UIKit)

type MissionResult = Types.MissionResult

local gui: ScreenGui? = nil
local title: TextLabel? = nil
local subtitle: TextLabel? = nil
local detail: TextLabel? = nil

local ResultPanel = {}

local function rewardText(result: MissionResult): string
	local parts: { string } = {}
	if result.Currency > 0 then
		table.insert(parts, `+{result.Currency} moneda`)
	end
	for _, unlocked in result.UnlockedMissions do
		table.insert(parts, `Nueva misión: {unlocked}`)
	end
	for _, unlocked in result.UnlockedMaps do
		table.insert(parts, `Nuevo mapa: {unlocked}`)
	end
	return table.concat(parts, "   ·   ")
end

function ResultPanel.build()
	gui = UIKit.screen("ResultPanel", 40)
	gui.Enabled = false

	local dim =
		UIKit.frame(gui, "Dim", UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), nil, Color3.fromRGB(10, 6, 8))
	dim.BackgroundTransparency = 0.45

	title = UIKit.label(
		gui,
		"Title",
		"",
		UDim2.new(1, 0, 0, 60),
		UDim2.new(0, 0, 0.32, 0),
		nil,
		Color3.fromRGB(240, 240, 245),
		true
	)
	title.TextSize = 52
	title.TextXAlignment = Enum.TextXAlignment.Center

	subtitle = UIKit.label(
		gui,
		"Subtitle",
		"",
		UDim2.new(1, 0, 0, 28),
		UDim2.new(0, 0, 0.32, 0) + UDim2.new(0, 66, 0, 0)
	)
	subtitle.TextSize = 20
	subtitle.TextColor3 = Color3.fromRGB(206, 210, 220)
	subtitle.TextXAlignment = Enum.TextXAlignment.Center

	detail = UIKit.label(
		gui,
		"Detail",
		"",
		UDim2.new(1, -80, 0, 44),
		UDim2.new(0.5, 0, 0.32, 0) + UDim2.new(0, 104, 0, 0),
		Vector2.new(0.5, 0),
		Color3.fromRGB(255, 214, 92),
		true
	)
	detail.TextSize = 17
	detail.TextXAlignment = Enum.TextXAlignment.Center
end

function ResultPanel.show(state: string, elapsed: number, level: number, result: MissionResult?)
	if not gui or not title or not subtitle or not detail then
		return
	end

	if state == "Victory" then
		title.Text = "VICTORIA"
		title.TextColor3 = Color3.fromRGB(255, 214, 92)
		if result then
			subtitle.Text = `{result.DisplayName}  ·  Nivel {level}  ·  {Format.clock(elapsed)}`
			detail.Text = rewardText(result)
		else
			subtitle.Text = `Nivel {level}  ·  {Format.clock(elapsed)} sobrevividos`
			detail.Text = ""
		end
		gui.Enabled = true
	elseif state == "Defeat" then
		title.Text = "DERROTA"
		title.TextColor3 = Color3.fromRGB(238, 116, 116)
		if result and result.Outcome == "Failed" then
			subtitle.Text = `{result.DisplayName} fallida  ·  Nivel {level}  ·  {Format.clock(elapsed)}`
			detail.Text = "Sin recompensas. La misión sigue disponible para reintentar."
		else
			subtitle.Text = `Nivel {level}  ·  {Format.clock(elapsed)} sobrevividos  ·  reiniciando...`
			detail.Text = ""
		end
		gui.Enabled = true
	else
		gui.Enabled = false
	end
end

function ResultPanel.hide()
	if gui then
		gui.Enabled = false
	end
end

return ResultPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">UIKit</string>
              <string name="Source"><![CDATA[--!strict
-- Fábrica mínima de widgets. Solo crea instancias y aplica propiedades: no guarda
-- estado de juego ni decide qué se muestra. Quien lo usa (Hud, LevelUpPanel) es
-- dueño de sus referencias y de su limpieza.
local Players = game:GetService("Players")

local UIKit = {}

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")

local FONT_BOLD = Enum.Font.GothamBold
local FONT = Enum.Font.Gotham

local RARITY_COLORS = {
	Common = Color3.fromRGB(198, 205, 214),
	Uncommon = Color3.fromRGB(108, 214, 122),
	Rare = Color3.fromRGB(96, 168, 255),
	Epic = Color3.fromRGB(196, 116, 255),
	Legendary = Color3.fromRGB(255, 186, 66),
}

function UIKit.rarityColor(rarity: string): Color3
	return RARITY_COLORS[rarity] or RARITY_COLORS.Common
end

function UIKit.screen(name: string, displayOrder: number): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.DisplayOrder = displayOrder
	gui.Parent = playerGui
	return gui
end

function UIKit.frame(
	parent: Instance,
	name: string,
	size: UDim2,
	position: UDim2,
	anchor: Vector2?,
	color: Color3?
): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Size = size
	frame.Position = position
	frame.AnchorPoint = anchor or Vector2.new(0, 0)
	frame.BackgroundColor3 = color or Color3.fromRGB(16, 18, 24)
	frame.BackgroundTransparency = if color then 0 else 0.35
	frame.BorderSizePixel = 0
	frame.Parent = parent
	UIKit.corner(frame, UDim.new(0, 10))
	return frame
end

function UIKit.corner(frame: Instance, radius: UDim)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius
	corner.Parent = frame
	return corner
end

function UIKit.stroke(frame: Instance, color: Color3, thickness: number)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness
	stroke.Transparency = 0.35
	stroke.Parent = frame
	return stroke
end

function UIKit.label(
	parent: Instance,
	name: string,
	text: string,
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?,
	bold: boolean?,
	alignment: Enum.TextXAlignment?
): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position or UDim2.new(0, 0, 0, 0)
	label.AnchorPoint = anchor or Vector2.new(0, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or Color3.fromRGB(235, 238, 245)
	label.TextSize = 18
	label.Font = if bold then FONT_BOLD else FONT
	label.TextXAlignment = alignment or Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextWrapped = true
	label.Parent = parent
	return label
end

-- Barra con relleno: devuelve el frame raíz y el relleno para poder actualizarlo sin
-- volver a buscar por nombre en cada frame.
function UIKit.bar(
	parent: Instance,
	name: string,
	height: number,
	color: Color3
): { Root: Frame, Fill: Frame }
	local root = UIKit.frame(
		parent,
		name,
		UDim2.new(1, 0, 0, height),
		UDim2.new(0, 0, 0, 0),
		nil,
		Color3.fromRGB(30, 32, 40)
	)
	UIKit.corner(root, UDim.new(1, 0))

	local fill = UIKit.frame(root, "Fill", UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), nil, color)
	UIKit.corner(fill, UDim.new(1, 0))
	return { Root = root, Fill = fill }
end

return UIKit
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="117">
          <Properties>
            <string name="Name">VFX</string>
          </Properties>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">CombatFeedback</string>
              <string name="Source"><![CDATA[--!strict
-- Feedback visual de combate. Vive en el cliente a propósito: el servidor ya decidió
-- el impacto y solo manda un aviso descartable. Los emisores, los rayos y los anillos
-- están en pool y se reciclan con un reloj, así que un impacto no crea ni destruye
-- instancias ni lanza una tarea por evento.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UIKit = require(script.Parent.Parent.UI.UIKit)

local POOL_SIZE = 14
local BEAM_POOL_SIZE = 12
local RING_POOL_SIZE = 6
local BUSY_SECONDS = 0.6
-- Altura del anillo de choque: un cilindro sobre el suelo que se lee aun con la
-- cámara top-down.
local RING_HEIGHT = 1.2

-- Colores de presentación de cada efecto.
local BOLT = Color3.fromRGB(255, 246, 220)
local CRIT = Color3.fromRGB(255, 208, 96)
local DEATH = Color3.fromRGB(226, 96, 96)
local BLAST = Color3.fromRGB(255, 158, 66)
local NOVA = Color3.fromRGB(126, 208, 255)
local CHAIN = Color3.fromRGB(150, 226, 255)
local SLASH = Color3.fromRGB(224, 242, 255)

type Burst = {
	Part: Part,
	Emitter: ParticleEmitter,
	BusyUntil: number,
}

-- Un rayo es un Beam con dos attachments sobre una pieza ancla. Los attachments se
-- posicionan en el mundo (el CFrame de Attachment es mundial), así que el ancla solo
-- da un hogar y el Beam se dibuja exactamente entre los dos puntos pedidos.
type BeamFX = {
	Part: Part,
	Beam: Beam,
	Attach0: Attachment,
	Attach1: Attachment,
	BusyUntil: number,
	FadeStart: number,
	FadeDuration: number,
	FadeFrom: number,
}

-- Anillo expansivo (onda de choque): un cilindro delgado que crece en el suelo y se
-- funde. Lo comparten la Nova y las explosiones para darle volumen al impacto.
type Ring = {
	Part: Part,
	BusyUntil: number,
	StartAt: number,
	Radius: number,
	FadeFrom: number,
}

local bursts: { Burst } = {}
local beams: { BeamFX } = {}
local rings: { Ring } = {}
local flash: Frame? = nil
local flashTween: Tween? = nil

local function buildBurst(color: Color3): Burst
	local part = Instance.new("Part")
	part.Size = Vector3.new(1, 1, 1)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.3, 0.55)
	emitter.Speed = NumberRange.new(6, 13)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.5),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.6
	emitter.Parent = part

	return { Part = part, Emitter = emitter, BusyUntil = 0 }
end

local function buildBeam(): BeamFX
	local part = Instance.new("Part")
	part.Name = "BeamAnchor"
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Parent = workspace

	local attach0 = Instance.new("Attachment")
	attach0.Name = "Attach0"
	local attach1 = Instance.new("Attachment")
	attach1.Name = "Attach1"

	local beam = Instance.new("Beam")
	beam.Name = "Beam"
	beam.Attachment0 = attach0
	beam.Attachment1 = attach1
	beam.Color = ColorSequence.new(CHAIN)
	beam.Transparency = NumberSequence.new(0.2)
	beam.Width0 = 0.45
	beam.Width1 = 0.45
	beam.FaceCamera = true
	beam.LightEmission = 0.8
	beam.Brightness = 2
	beam.Enabled = false
	beam.Parent = part
	attach0.Parent = part
	attach1.Parent = part

	return {
		Part = part,
		Beam = beam,
		Attach0 = attach0,
		Attach1 = attach1,
		BusyUntil = 0,
		FadeStart = 0,
		FadeDuration = 0,
		FadeFrom = 0,
	}
end

local function buildRing(): Ring
	local part = Instance.new("Part")
	part.Name = "Shockwave"
	part.Shape = Enum.PartType.Cylinder
	part.Material = Enum.Material.Neon
	part.Color = NOVA
	part.Size = Vector3.new(0.3, 0.1, 0.3)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Parent = workspace
	return { Part = part, BusyUntil = 0, StartAt = 0, Radius = 0, FadeFrom = 0 }
end

local CombatFeedback = {}

function CombatFeedback.build()
	for index = 1, POOL_SIZE do
		bursts[index] = buildBurst(BOLT)
	end
	for index = 1, BEAM_POOL_SIZE do
		beams[index] = buildBeam()
	end
	for index = 1, RING_POOL_SIZE do
		rings[index] = buildRing()
	end

	local gui = UIKit.screen("CombatFeedback", 25)
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 25
	flash = UIKit.frame(
		gui,
		"Flash",
		UDim2.new(1, 0, 1, 0),
		UDim2.new(0, 0, 0, 0),
		nil,
		Color3.fromRGB(200, 40, 40)
	)
	flash.BackgroundTransparency = 1

	RunService.RenderStepped:Connect(function()
		local now = os.clock()

		for _, burst in bursts do
			if burst.BusyUntil > 0 and now >= burst.BusyUntil then
				burst.BusyUntil = 0
				burst.Part.Transparency = 1
			end
		end

		for _, beam in beams do
			if beam.BusyUntil > 0 then
				if now >= beam.BusyUntil then
					beam.Beam.Enabled = false
					beam.BusyUntil = 0
				else
					-- Fade-out manual: TweenService no puede animar NumberSequence.
					local t = (now - beam.FadeStart) / beam.FadeDuration
					local alpha = beam.FadeFrom + (1 - beam.FadeFrom) * t
					beam.Beam.Transparency = NumberSequence.new(alpha)
				end
			end
		end

		for _, ring in rings do
			if ring.BusyUntil > 0 then
				if now >= ring.BusyUntil then
					ring.Part.Transparency = 1
					ring.BusyUntil = 0
				else
					local duration = ring.BusyUntil - ring.StartAt
					local t = (now - ring.StartAt) / math.max(duration, 0.001)
					-- Ease-out quad: crece rápido al contacto y frena, como una onda
					-- que pierde empuje. Deja el anillo en 1 solo perfil robusto.
					local eased = 1 - (1 - t) * (1 - t)
					local diameter = ring.Radius * 2 * eased + 0.3
					ring.Part.Size = Vector3.new(RING_HEIGHT, diameter, diameter)
					ring.Part.Transparency = ring.FadeFrom + (1 - ring.FadeFrom) * t
				end
			end
		end
	end)
end

local function emit(position: Vector3, count: number, color: Color3)
	local now = os.clock()
	for _, burst in bursts do
		if burst.BusyUntil <= now then
			burst.BusyUntil = now + BUSY_SECONDS
			burst.Part.CFrame = CFrame.new(position)
			burst.Emitter.Color = ColorSequence.new(color)
			burst.Emitter:Emit(count)
			return
		end
	end
end

-- Rayo entre dos puntos (cadena o slash). Empieza con un alfa inicial y se funde
-- hasta opaco antes de apagarse; el beam vuelve al pool al llegar a cero su reloj.
local function beamBetween(from: Vector3, to: Vector3, color: Color3, width: number, fadeDuration: number)
	if (to - from).Magnitude < 0.05 then
		return
	end

	local now = os.clock()
	for _, beam in beams do
		if beam.BusyUntil <= now then
			beam.Beam.Enabled = true
			beam.Beam.Color = ColorSequence.new(color)
			beam.Beam.Width0 = width
			beam.Beam.Width1 = width
			beam.Part.CFrame = CFrame.new((from + to) * 0.5)
			beam.Attach0.CFrame = CFrame.new(from)
			beam.Attach1.CFrame = CFrame.new(to)
			-- Los efectos fugaces (slash) nacen más transparentes que el rayo.
			beam.FadeFrom = if fadeDuration > 0.06 then 0.14 else 0.3
			beam.FadeStart = now
			beam.FadeDuration = fadeDuration
			beam.BusyUntil = now + fadeDuration
			return
		end
	end
end

-- Anillo expansivo sobre un punto del suelo. La Y la manda el servidor (ras de
-- suelo) y el cilindro crece en el plano XZ.
local function playRing(position: Vector3, radius: number, color: Color3, duration: number, fadeFrom: number)
	local now = os.clock()
	for _, ring in rings do
		if ring.BusyUntil <= now then
			ring.BusyUntil = now + duration
			ring.StartAt = now
			ring.Radius = radius
			ring.FadeFrom = fadeFrom
			ring.Part.Color = color
			ring.Part.Transparency = fadeFrom
			ring.Part.CFrame = CFrame.new(position.X, position.Y + RING_HEIGHT / 2, position.Z)
				* CFrame.Angles(0, 0, math.rad(90))
			ring.Part.Size = Vector3.new(RING_HEIGHT, 0.3, 0.3)
			return
		end
	end
end

local function playFlash()
	if not flash then
		return
	end
	if flashTween then
		flashTween:Cancel()
	end
	flash.BackgroundTransparency = 0.55
	flashTween = TweenService:Create(
		flash,
		TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 1 }
	)
	flashTween:Play()
end

-- El servidor manda `magnitude` como radios o conteos segun el tipo; el cliente solo
-- decide cómo se ve. `target` lo usan los efectos que unen dos puntos.
function CombatFeedback.play(kind: string, position: Vector3, magnitude: number, target: Vector3?)
	if kind == "hit" then
		local crit = magnitude > 1
		emit(position, if crit then 10 else 5, if crit then CRIT else BOLT)
	elseif kind == "death" then
		emit(position, 16, DEATH)
	elseif kind == "explosion" then
		-- Silueta clara primero: núcleo brillante y luego la onda que se expande.
		local scale = math.clamp(magnitude / 8, 0.6, 2)
		emit(position, math.round(22 * scale), BLAST)
		playRing(position, magnitude * 1.1, BLAST, 0.4, 0.12)
	elseif kind == "nova" then
		-- Chispazo central + el anillo de choque que empuja a la horda.
		local scale = math.clamp(magnitude / 8, 0.6, 2)
		emit(position, math.round(18 * scale), NOVA)
		playRing(position, magnitude * 1.15, NOVA, 0.5, 0.15)
	elseif kind == "chain" then
		-- Eco en el origen del salto y chispazo en el impacto (target); el primer
		-- rayo nace en el arma del jugador, así que siempre hay un segmento visible.
		emit(position, 3, CHAIN)
		if target then
			emit(target, 6, CHAIN)
			beamBetween(position, target, CHAIN, 0.45, 0.24)
		end
	elseif kind == "slash" then
		-- Arco de corte de la cuchilla: rayo fino, breve y brillante.
		emit(position, 4, SLASH)
		if target then
			beamBetween(position, target, SLASH, 0.12, 0.12)
		end
	elseif kind == "playerHurt" then
		playFlash()
	end
end

return CombatFeedback
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
