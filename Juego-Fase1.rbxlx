          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">Nova</string>
              <string name="Source"><![CDATA[--!strict

-- Range (cuándo se activa el pulso) y Radius (a quién golpea) se suben siempre juntos
-- en la misma clave: si se separaran, el arma empezaría a pulsar en el vacío.
local areaGrowth = {
	{ stat = "Radius", kind = "Add", value = 1.5, source = "nova_scaling" },
	{ stat = "Range", kind = "Add", value = 1.5, source = "nova_scaling" },
}

local damageGrowth = {
	{ stat = "Damage", kind = "Add", value = 2, source = "nova_scaling" },
}

local levels = {
	[2] = damageGrowth,
	[3] = areaGrowth,
	[4] = {
		{ stat = "Damage", kind = "Add", value = 2, source = "nova_scaling" },
		{ stat = "Radius", kind = "Add", value = 1.5, source = "nova_scaling" },
		{ stat = "Range", kind = "Add", value = 1.5, source = "nova_scaling" },
	},
	[5] = damageGrowth,
	[6] = {
		{ stat = "Damage", kind = "Add", value = 2, source = "nova_scaling" },
		{ stat = "AttackSpeed", kind = "Multiply", value = 1.12, source = "nova_scaling" },
	},
	[7] = areaGrowth,
	[8] = {
		{ stat = "Damage", kind = "Multiply", value = 1.25, source = "nova_scaling" },
		{ stat = "Radius", kind = "Add", value = 2, source = "nova_scaling" },
		{ stat = "Range", kind = "Add", value = 2, source = "nova_scaling" },
	},
}

local definition = {
	Id = "nova",
	Name = "Pulso Nova",
	Description = "Estalla a tu alrededor y daña a todo lo que tengas encima.",
	Icon = "🌊",
	MaxLevel = 8,
	Behavior = "Nova",
	BaseStats = {
		Damage = 8,
		AttackSpeed = 1.15,
		Range = 9,
		Radius = 9,
		ProjectileSpeed = 1,
		ProjectileCount = 0,
	},
	Scaling = levels,
	Tags = { "area", "self", "no_target" },
}

return definition
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">Orbit</string>
              <string name="Source"><![CDATA[--!strict

-- El único arma que no dispara por cadencia: son piezas persistentes que giran y
-- muelen por contacto. Por eso no necesita un enemigo al que apuntar, y por eso
-- AttackSpeed es la frecuencia con la que se refrescan sus parámetros, no un
-- intervalo de daño (ese ritmo lo lleva HitCooldown, por enemigo).
local bladeGrowth = {
	{ stat = "Damage", kind = "Add", value = 2, source = "orbit_scaling" },
}

local levels = {
	[2] = bladeGrowth,
	[3] = {
		{ stat = "Damage", kind = "Add", value = 2, source = "orbit_scaling" },
		{ stat = "BladeCount", kind = "Add", value = 1, source = "orbit_scaling" },
	},
	[4] = bladeGrowth,
	[5] = {
		{ stat = "Damage", kind = "Add", value = 2, source = "orbit_scaling" },
		{ stat = "BladeCount", kind = "Add", value = 1, source = "orbit_scaling" },
		{ stat = "OrbitSpeed", kind = "Multiply", value = 1.15, source = "orbit_scaling" },
	},
	[6] = bladeGrowth,
	[7] = {
		{ stat = "Damage", kind = "Multiply", value = 1.2, source = "orbit_scaling" },
		{ stat = "HitCooldown", kind = "Multiply", value = 0.85, source = "orbit_scaling" },
	},
	[8] = bladeGrowth,
}

local definition = {
	Id = "orbit",
	Name = "Cuchillas",
	Description = "Cuchillas orbitando: cortan por contacto una y otra vez.",
	Icon = "🗡",
	MaxLevel = 8,
	Behavior = "Orbit",
	BaseStats = {
		Damage = 6,
		AttackSpeed = 2,
		BladeCount = 2,
		OrbitRadius = 6.5,
		OrbitSpeed = 2.6,
		HitCooldown = 0.45,
	},
	RequiresTarget = false,
	Scaling = levels,
	Tags = { "orbit", "contact", "no_target" },
}

return definition
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Shotgun</string>
              <string name="Source"><![CDATA[--!strict

local pelletGrowth = {
	{ stat = "Damage", kind = "Add", value = 1.5, source = "shotgun_scaling" },
	{ stat = "Pellets", kind = "Add", value = 1, source = "shotgun_scaling" },
}

local levels = {
	[2] = pelletGrowth,
	[3] = pelletGrowth,
	[4] = {
		{ stat = "Damage", kind = "Add", value = 1.5, source = "shotgun_scaling" },
		{ stat = "Pellets", kind = "Add", value = 1, source = "shotgun_scaling" },
		{ stat = "AttackSpeed", kind = "Multiply", value = 1.08, source = "shotgun_scaling" },
	},
	[5] = pelletGrowth,
	[6] = pelletGrowth,
	[7] = {
		{ stat = "Damage", kind = "Multiply", value = 1.18, source = "shotgun_scaling" },
		{ stat = "Spread", kind = "Add", value = -4, source = "shotgun_scaling" },
	},
	[8] = pelletGrowth,
}

local definition = {
	Id = "shotgun",
	Name = "Breacher",
	Description = "Ráfaga de perdigones en cono a corta distancia.",
	Icon = "💥",
	MaxLevel = 8,
	Behavior = "Projectile",
	BaseStats = {
		Damage = 5,
		AttackSpeed = 1.1,
		Range = 32,
		ProjectileSpeed = 78,
		ProjectileCount = 1,
		Pellets = 6,
		Spread = 32,
	},
	Scaling = levels,
	Tags = { "projectile", "spread", "close" },
}

return definition
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">GameAssets</string>
          <string name="Source"><![CDATA[--!strict
-- Encuentra visuales de armas cargados por el usuario.
-- Coloca los modelos de Roblox Assets en:
--   ReplicatedStorage → Shared → Assets → (Blade.rbx, Bomb.rbx, Projectile.rbx, …)
-- Si un modelo no existe, el juego vuelve al Part de reserva: no se rompe nada.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local GameAssets = {}

local function getFolder(): Folder?
	local assets = Shared:FindFirstChild("Assets")
	return if assets and assets:IsA("Folder") then assets else nil
end

-- Devuelve una copia de una pieza de modelo cualquiera que exista dentro de
-- Shared/Assets con el nombre indicado. Devuelve nil si no hay nada con ese nombre.
function GameAssets.find(name: string): Instance?
	local assets = getFolder()
	if not assets then
		return nil
	end
	return assets:FindFirstChild(name)
end

-- Misma idea pero obligada a ser una BasePart (MeshPart o Part). Perfecta para
-- proyectiles y miradas de OrbitBlades porque son BasePart que el resto del código
-- ya mueve con CFrame.
function GameAssets.findPart(name: string): BasePart?
	local obj = GameAssets.find(name)
	if obj and obj:IsA("BasePart") then
		return obj :: BasePart
	end
	return nil
end

return GameAssets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--!strict
-- Curva de experiencia. Función pura: sin Roblox, testeable headless.
local Progression = {}

-- XP necesaria para pasar de `level` a `level + 1`.
function Progression.xpForNext(level: number): number
	local steps = math.max(0, level - 1)
	return 6 + steps * 5 + math.floor(steps ^ 1.6)
end

function Progression.xpForLevel(level: number): number
	if level <= 1 then
		return 0
	end
	local total = 0
	for step = 1, level - 1 do
		total += Progression.xpForNext(step)
	end
	return total
end

-- Aplica la XP y devuelve el nuevo nivel, la XP dentro del nivel y cuántos
-- niveles se ganaron (puede ser más de uno con pickups grandes).
function Progression.addXp(currentLevel: number, currentXp: number, amount: number): (number, number, number)
	local level = math.max(1, currentLevel)
	local xp = math.max(0, currentXp) + math.max(0, amount)
	local gained = 0

	while true do
		local needed = Progression.xpForNext(level)
		if xp < needed then
			break
		end
		xp -= needed
		level += 1
		gained += 1
	end

	return level, xp, gained
end

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Rarity</string>
          <string name="Source"><![CDATA[--!strict
-- Rareza de las mejoras. El peso base sigue la curva estándar 55/27/12/5/1; la
-- estadística Luck multiplica el peso de las rarezas altas, de modo que un jugador
-- con Luck = 2 ve casi el doble de Rare y el doble de Legendario.
local Rarity = {}

export type RarityId = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary"

Rarity.Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }

Rarity.BaseWeight = {
	Common = 55,
	Uncommon = 27,
	Rare = 12,
	Epic = 5,
	Legendary = 1,
}

function Rarity.indexOf(rarity: RarityId): number
	for index, id in Rarity.Order do
		if id == rarity then
			return index - 1
		end
	end
	error(`[Rarity] rareza desconocida: {tostring(rarity)}`)
end

function Rarity.weightOf(rarity: RarityId, luck: number): number
	local factor = luck ^ Rarity.indexOf(rarity)
	return Rarity.BaseWeight[rarity] * factor
end

-- Sortea una rareza. El generador se inyecta para poder probar la curva sin Roblox.
function Rarity.roll(rand: () -> number, luck: number): RarityId
	local total = 0
	local weights: { number } = {}
	for index, rarity in Rarity.Order do
		local weight = Rarity.weightOf(rarity, luck)
		weights[index] = weight
		total += weight
	end

	local target = rand() * total
	local accumulated = 0
	for index, rarity in Rarity.Order do
		accumulated += weights[index]
		if target <= accumulated then
			return rarity
		end
	end
	return "Legendary"
end

return Rarity
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[--!strict
-- Registro de contenido: indexa y valida las definiciones de armas, enemigos y
-- mejoras. Servidor y cliente cargan este mismo registro, así que un error de
-- contenido (id duplicado, stat inexistente, rareza inválida) revienta al cargar en
-- los dos lados, en lugar de aparecer a mitad de una partida.
-- Import dual (ver StatMath.luau): el módulo vecino se resuelve por `script` en Roblox y
-- por ruta relativa en las pruebas headless con Lune.
local Types = require(script and script.Parent.Types or "./Types")
local Rarity = require(script and script.Parent.Rarity or "./Rarity")

local weaponList = {
	require(script and script.Parent.Definitions.Weapons.Gun or "./Definitions/Weapons/Gun"),
	require(script and script.Parent.Definitions.Weapons.Shotgun or "./Definitions/Weapons/Shotgun"),
	require(script and script.Parent.Definitions.Weapons.Chain or "./Definitions/Weapons/Chain"),
	require(script and script.Parent.Definitions.Weapons.Nova or "./Definitions/Weapons/Nova"),
	require(script and script.Parent.Definitions.Weapons.Bomb or "./Definitions/Weapons/Bomb"),
	require(script and script.Parent.Definitions.Weapons.Orbit or "./Definitions/Weapons/Orbit"),
}

local enemyList = {
	require(script and script.Parent.Definitions.Enemies.Basic or "./Definitions/Enemies/Basic"),
}

local upgradeList = {
	require(script and script.Parent.Definitions.Upgrades.GunDamage or "./Definitions/Upgrades/GunDamage"),
	require(
		script and script.Parent.Definitions.Upgrades.GunAttackSpeed
			or "./Definitions/Upgrades/GunAttackSpeed"
	),
	require(
		script and script.Parent.Definitions.Upgrades.ShotgunUnlock or "./Definitions/Upgrades/ShotgunUnlock"
	),
	require(
		script and script.Parent.Definitions.Upgrades.ShotgunDamage or "./Definitions/Upgrades/ShotgunDamage"
	),
	require(
		script and script.Parent.Definitions.Upgrades.ChainUnlock or "./Definitions/Upgrades/ChainUnlock"
	),
	require(
		script and script.Parent.Definitions.Upgrades.ChainDamage or "./Definitions/Upgrades/ChainDamage"
	),
	require(script and script.Parent.Definitions.Upgrades.NovaUnlock or "./Definitions/Upgrades/NovaUnlock"),
	require(script and script.Parent.Definitions.Upgrades.NovaDamage or "./Definitions/Upgrades/NovaDamage"),
	require(script and script.Parent.Definitions.Upgrades.BombUnlock or "./Definitions/Upgrades/BombUnlock"),
	require(script and script.Parent.Definitions.Upgrades.BombDamage or "./Definitions/Upgrades/BombDamage"),
	require(
		script and script.Parent.Definitions.Upgrades.OrbitUnlock or "./Definitions/Upgrades/OrbitUnlock"
	),
	require(
		script and script.Parent.Definitions.Upgrades.OrbitDamage or "./Definitions/Upgrades/OrbitDamage"
	),
	require(script and script.Parent.Definitions.Upgrades.Vitality or "./Definitions/Upgrades/Vitality"),
}

local VALID_STATS: { [string]: boolean } = {
	MaxHealth = true,
	Armor = true,
	MoveSpeed = true,
	Damage = true,
	AttackSpeed = true,
	CriticalChance = true,
	CriticalDamage = true,
	Range = true,
	ProjectileSpeed = true,
	ProjectileCount = true,
	Pellets = true,
	Spread = true,
	PickupRadius = true,
	XPModifier = true,
	Luck = true,
	-- Stats de los comportamientos de area, cadena y contacto.
	Radius = true,
	BlastRadius = true,
	Arc = true,
	ChainCount = true,
	ChainRange = true,
	ChainFalloff = true,
	BladeCount = true,
	OrbitRadius = true,
	OrbitSpeed = true,
	HitCooldown = true,
}

local STARTING_WEAPON_ID = "gun"

local function indexById<T>(list: { T }, kind: string): { [string]: T }
	local byId = {}
	for _, entry in list do
		local id = entry.Id :: string
		if byId[id] then
			error(`[Registry] id duplicado en {kind}: {id}`)
		end
		byId[id] = entry
	end
	return byId
end

local function validateModifiers(source: string, modifiers: { Types.StatModifier })
	for _, modifier in modifiers do
		if not VALID_STATS[modifier.stat] then
			error(`[Registry] stat desconocido "{tostring(modifier.stat)}" en {source}`)
		end
		if modifier.kind ~= "Add" and modifier.kind ~= "Multiply" then
			error(`[Registry] tipo de modificador inválido en {source}`)
		end
	end
end

local VALID_UPGRADE_KINDS: { [string]: boolean } = {
	NewWeapon = true,
	WeaponUpgrade = true,
	Stat = true,
	Passive = true,
}

local VALID_BEHAVIORS: { [string]: boolean } = {
	Projectile = true,
	Nova = true,
	Chain = true,
	Bomb = true,
	Orbit = true,
}

local Weapons = indexById(weaponList, "Weapons")
local Enemies = indexById(enemyList, "Enemies")
local Upgrades = indexById(upgradeList, "Upgrades")

for _, weapon in weaponList do
	if weapon.MaxLevel < 1 then
		error(`[Registry] arma {weapon.Id} con MaxLevel inválido`)
	end
	for level, modifiers in weapon.Scaling do
		if level < 2 or level > weapon.MaxLevel then
			error(`[Registry] arma {weapon.Id} escala en nivel {level}, fuera de 2..{weapon.MaxLevel}`)
		end
		validateModifiers(weapon.Id, modifiers)
	end
	local base = weapon.BaseStats
	if (base.Damage or 0) <= 0 or (base.AttackSpeed or 0) <= 0 then
		error(`[Registry] arma {weapon.Id} necesita Damage y AttackSpeed base`)
	end
	if not VALID_BEHAVIORS[weapon.Behavior] then
		error(`[Registry] arma {weapon.Id} tiene un comportamiento desconocido {weapon.Behavior}`)
	end
end

for _, enemy in enemyList do
	if enemy.Health <= 0 or enemy.Speed <= 0 then
		error(`[Registry] enemigo {enemy.Id} con Health o Speed inválidos`)
	end
end

for _, upgrade in upgradeList do
	if upgrade.MaxLevel < 1 or upgrade.Weight <= 0 then
		error(`[Registry] mejora {upgrade.Id} con MaxLevel o Weight inválidos`)
	end
	if not VALID_UPGRADE_KINDS[upgrade.Kind] then
		error(`[Registry] mejora {upgrade.Id} con Kind inválido {tostring(upgrade.Kind)}`)
	end
	if not Rarity.BaseWeight[upgrade.Rarity] then
		error(`[Registry] mejora {upgrade.Id} con rareza desconocida {tostring(upgrade.Rarity)}`)
	end
	if upgrade.TargetId and not Weapons[upgrade.TargetId] then
		error(`[Registry] mejora {upgrade.Id} apunta al arma inexistente {upgrade.TargetId}`)
	end
	if upgrade.Kind == "NewWeapon" and not upgrade.Requires then
		error(`[Registry] mejora {upgrade.Id} de tipo NewWeapon necesita Requires`)
	end
	validateModifiers(upgrade.Id, upgrade.Modifiers)
end

-- Un arma que ni es la inicial ni tiene una carta que la desbloquee es contenido
-- muerto: existe en el registro pero nunca puede aparecer en una partida.
local unlockable: { [string]: boolean } = { [STARTING_WEAPON_ID] = true }
for _, upgrade in upgradeList do
	if upgrade.Kind == "NewWeapon" and upgrade.TargetId then
		unlockable[upgrade.TargetId] = true
	end
end
for _, weapon in weaponList do
	if not unlockable[weapon.Id] then
		error(`[Registry] el arma {weapon.Id} no tiene mejora que la desbloquee`)
	end
end

return {
	Weapons = Weapons,
	Enemies = Enemies,
	Upgrades = Upgrades,
	StartingWeaponId = STARTING_WEAPON_ID,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Contrato de red. Un solo punto de acceso a los remotes: el cliente nunca los
-- busca por su cuenta y el servidor siempre los referencia desde aquí.
--
-- Los payloads son datos de presentación o peticiones. Nunca se acepta desde el
-- cliente daño, XP, recompensas ni precios.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function remote(name: string, className: string): Instance
	local folder = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not folder then
		error("[Remotes] ReplicatedStorage.Remotes no llegó desde el servidor")
	end
	local instance = folder:WaitForChild(name, 10)
	if not instance then
		error(`[Remotes] falta el remote "{name}"`)
	end
	if not instance:IsA(className) then
		error(`[Remotes] "{name}" debería ser {className}`)
	end
	return instance
end

return {
	-- Servidor → cliente: (state: MatchState, elapsed: number, offers: {UpgradeOffer}?)
	MatchStateChanged = remote("MatchStateChanged", "RemoteEvent") :: RemoteEvent,
	-- Servidor → cliente: snapshot completo del HUD (RunSnapshot).
	RunSnapshot = remote("RunSnapshot", "RemoteEvent") :: RemoteEvent,
	-- Servidor → cliente: una carta ya elegida (string id).
	UpgradeChosen = remote("UpgradeChosen", "RemoteEvent") :: RemoteEvent,
	-- Cliente → servidor: el cliente ya registró sus listeners; pide su estado.
	ClientReady = remote("ClientReady", "RemoteEvent") :: RemoteEvent,
	-- Cliente → servidor: petición de elegir carta (string id). Se valida contra
	-- el conjunto de ofertas pendientes y se consume una sola vez.
	RequestUpgrade = remote("RequestUpgrade", "RemoteEvent") :: RemoteEvent,
	-- Servidor → cliente: feedback visual descartable (kind: string, position, magnitude).
	CombatEffect = remote("CombatEffect", "UnreliableRemoteEvent") :: UnreliableRemoteEvent,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">StatMath</string>
          <string name="Source"><![CDATA[--!strict
-- Cálculo de estadísticas. Todo puro, sin Roblox: se puede probar headless.
--
-- Pipeline de jugador:
--   base (Config.PlayerBaseStats)
--   + modificadores Add
--   x modificadores Multiply
--   = stats finales
--
-- Pipeline de arma:
--   base de la definición
--   + scaling por nivel
--   + modificadores de mejoras dirigidas a esa arma
--   x multiplicadores globales del jugador
--   = stats del arma
-- Import dual: en Roblox se resuelve el ModuleScript vecino; fuera de Studio (las
-- pruebas headless con Lune) cae a la ruta relativa, porque Lune no expone `script`.
local Types = require(script and script.Parent.Types or "./Types")

type StatModifier = Types.StatModifier
type StatBlock = Types.StatBlock
type WeaponDefinition = Types.WeaponDefinition

local StatMath = {}

function StatMath.apply(stats: StatBlock, modifier: StatModifier)
	local current = stats[modifier.stat] or 0
	if modifier.kind == "Add" then
		stats[modifier.stat] = current + modifier.value
	else
		stats[modifier.stat] = current * modifier.value
	end
end

-- Los "Add" se resuelven antes que los "Multiply" para que el resultado no dependa
-- del orden en el que se registraron los modificadores.
function StatMath.resolve(base: StatBlock, modifiers: { StatModifier }): StatBlock
	local stats = table.clone(base)
	for _, modifier in modifiers do
		if modifier.kind == "Add" then
			StatMath.apply(stats, modifier)
		end
	end
	for _, modifier in modifiers do
		if modifier.kind == "Multiply" then
			StatMath.apply(stats, modifier)
		end
	end
	return stats
end

-- Las estadísticas globales del jugador son multiplicadores por diseño:
-- Config.PlayerBaseStats deja Damage/AttackSpeed/Range/ProjectileSpeed en 1 y
-- ProjectileCount/Pellets/Spread en 0, así que añadir una mejora global nunca
-- pisa el valor propio del arma.
local GLOBAL_MULTIPLIERS: { Types.StatKey } = { "Damage", "AttackSpeed", "Range", "ProjectileSpeed" }
local GLOBAL_ADDITIONS: { Types.StatKey } = { "ProjectileCount", "Pellets", "Spread" }

function StatMath.weapon(
	definition: WeaponDefinition,
	level: number,
	upgrades: { StatModifier },
	playerStats: StatBlock
): StatBlock
	local stats = table.clone(definition.BaseStats)

	for step = 2, level do
		local modifiers = definition.Scaling[step]
		if modifiers then
			for _, modifier in modifiers do
				StatMath.apply(stats, modifier)
			end
		end
	end

	for _, modifier in upgrades do
		StatMath.apply(stats, modifier)
	end

	for _, stat in GLOBAL_MULTIPLIERS do
		stats[stat] = (stats[stat] or 0) * (playerStats[stat] or 1)
	end
	for _, stat in GLOBAL_ADDITIONS do
		stats[stat] = (stats[stat] or 0) + (playerStats[stat] or 0)
	end

	return stats
end

return StatMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Tipos compartidos entre servidor y cliente.
-- Regla: este módulo no toca la API de Roblox, para que los módulos puros que lo
-- consumen (definiciones, progresión, rareza) se puedan probar fuera de Studio.

export type StatKey =
	| "MaxHealth"
	| "Armor"
	| "MoveSpeed"
	| "Damage"
	| "AttackSpeed"
	| "CriticalChance"
	| "CriticalDamage"
	| "Range"
	| "ProjectileSpeed"
	| "ProjectileCount"
	| "Pellets"
	| "Spread"
	| "PickupRadius"
	| "XPModifier"
	| "Luck"
	| "Radius"
	| "BlastRadius"
	| "Arc"
	| "ChainCount"
	| "ChainRange"
	| "ChainFalloff"
	| "BladeCount"
	| "OrbitRadius"
	| "OrbitSpeed"
	| "HitCooldown"

-- "Add" suma el valor, "Multiply" escala el acumulado. Se aplican en ese orden
-- sobre el bloque base para que el resultado sea intuitivo de leer.
export type ModifierKind = "Add" | "Multiply"

export type StatModifier = {
	stat: StatKey,
	kind: ModifierKind,
	value: number,
	source: string,
	-- Duración en segundos. nil = permanente durante la partida.
	duration: number?,
}

export type StatBlock = { [StatKey]: number }

export type Rarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary"

-- Identificador de comportamiento de ataque. Un comportamiento nuevo se registra
-- en Server/Combat/WeaponBehaviors.luau sin tocar WeaponRuntime ni las definiciones.
export type WeaponBehaviorId = "Projectile" | "Nova" | "Chain" | "Bomb" | "Orbit"

export type WeaponDefinition = {
	Id: string,
	Name: string,
	Description: string,
	Icon: string,
	MaxLevel: number,
	Behavior: WeaponBehaviorId,
	BaseStats: StatBlock,
	-- Clave = nivel mínimo en el que se aplican sus modificadores.
	Scaling: { [number]: { StatModifier } },
	Tags: { string },
	-- false = el arma no necesita un enemigo al que apuntar, así que WeaponRuntime se
	-- ahorra la búsqueda del objetivo más cercano. Por defecto true.
	RequiresTarget: boolean?,
}

export type EnemyAttackType = "Contact" | "Projectile" | "None"

export type EnemyDefinition = {
	Id: string,
	Name: string,
	Health: number,
	Speed: number,
	Damage: number,
	AttackInterval: number,
	AttackRange: number,
	XPReward: number,
	Size: number,
	AttackType: EnemyAttackType,
	Tags: { string },
}

export type UpgradeKind = "NewWeapon" | "WeaponUpgrade" | "Stat" | "Passive"

-- Vista de la partida que las definiciones consultan para requisitos y evolución.
export type RunView = {
	level: number,
	weaponLevels: { [string]: number },
	upgradeLevels: { [string]: number },
}

export type UpgradeDefinition = {
	Id: string,
	Kind: UpgradeKind,
	Rarity: Rarity,
	Name: string,
	Description: string,
	Icon: string,
	MaxLevel: number,
	Weight: number,
	-- Arma a la que aplica: "NewWeapon" y "WeaponUpgrade" lo requieren.
	TargetId: string?,
	Modifiers: { StatModifier },
	-- Punto de extensión para evoluciones: sin requisitos devuelve nil.
	Requires: ((run: RunView) -> boolean)?,
}

-- Payload que el cliente pinta en las cartas de subida de nivel.
export type UpgradeOffer = {
	Id: string,
	Kind: UpgradeKind,
	Rarity: Rarity,
	Name: string,
	Description: string,
	Icon: string,
	TargetId: string?,
	CurrentLevel: number,
	NextLevel: number,
	MaxLevel: number,
}

export type WeaponView = {
	Id: string,
	Name: string,
	Icon: string,
	Level: number,
	MaxLevel: number,
}

export type PassiveView = {
	Id: string,
	Name: string,
	Icon: string,
	Level: number,
	MaxLevel: number,
}

export type BuffView = {
	Name: string,
	Remaining: number,
}

export type RunSnapshot = {
	State: MatchState,
	Elapsed: number,
	Health: number,
	MaxHealth: number,
	Level: number,
	XP: number,
	XPToNext: number,
	Weapons: { WeaponView },
	Passives: { PassiveView },
	Buffs: { BuffView },
	MoveSpeed: number,
	PickupRadius: number,
}

export type MatchState = "Lobby" | "Starting" | "Playing" | "LevelUp" | "Event" | "Boss" | "Victory" | "Defeat"

-- Este módulo solo exporta tipos. La tabla vacía evita que el require devuelva nil y
-- que el analizador de Studio marque los usos `Types.Algo` como acceso a nil.
return {}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">UpgradeOffers</string>
          <string name="Source"><![CDATA[--!strict
-- Generación de las ofertas de subida de nivel.
--
-- Es una función pura a propósito: el servidor la llama, pero se puede probar sin
-- Studio. Además del peso por rareza hay garantías explícitas, porque el diseño
-- pide que ninguna partida se vuelva frustrante por mala suerte.
-- Import dual (ver StatMath.luau): el vecino se resuelve por `script` en Roblox y por
-- ruta relativa en las pruebas headless con Lune.
local Types = require(script and script.Parent.Types or "./Types")
local Registry = require(script and script.Parent.Registry or "./Registry")
local Rarity = require(script and script.Parent.Rarity or "./Rarity")

type RunView = Types.RunView
type UpgradeDefinition = Types.UpgradeDefinition
type UpgradeOffer = Types.UpgradeOffer

-- Orden estable para que las pruebas y el reparto de pesos sean deterministas.
local UPGRADE_IDS: { string } = {}
for id in Registry.Upgrades do
	table.insert(UPGRADE_IDS, id)
end
table.sort(UPGRADE_IDS)

local function isEligible(definition: UpgradeDefinition, run: RunView): boolean
	local current = run.upgradeLevels[definition.Id] or 0
	if current >= definition.MaxLevel then
		return false
	end
	return if definition.Requires then definition.Requires(run) else true
end

local function rarityWeight(definition: UpgradeDefinition, luck: number): number
	return definition.Weight * Rarity.weightOf(definition.Rarity, luck)
end

local function weightedPick(
	candidates: { UpgradeDefinition },
	luck: number,
	rand: () -> number
): UpgradeDefinition?
	local weights = table.create(#candidates)
	local total = 0
	for index, definition in candidates do
		weights[index] = rarityWeight(definition, luck)
		total += weights[index]
	end
	if total <= 0 then
		return nil
	end

	local target = rand() * total
	local accumulated = 0
	for index, definition in candidates do
		accumulated += weights[index]
		if target <= accumulated then
			return definition
		end
	end
	return candidates[#candidates]
end

local function remaining(
	candidates: { UpgradeDefinition },
	taken: { [string]: boolean },
	predicate: ((UpgradeDefinition) -> boolean)?
): { UpgradeDefinition }
	local pool = {}
	for _, definition in candidates do
		if not taken[definition.Id] and (not predicate or predicate(definition)) then
			table.insert(pool, definition)
		end
	end
	return pool
end

local function ownsWeapon(run: RunView, weaponId: string?): boolean
	return weaponId ~= nil and (run.weaponLevels[weaponId] or 0) > 0
end

local Offers = {}

function Offers.generate(run: RunView, luck: number, rand: () -> number, count: number?): { UpgradeOffer }
	local wanted = count or 3
	local luckValue = math.max(0.05, luck)

	local eligible: { UpgradeDefinition } = {}
	for _, id in UPGRADE_IDS do
		local definition = Registry.Upgrades[id]
		if isEligible(definition, run) then
			table.insert(eligible, definition)
		end
	end

	local chosen: { UpgradeDefinition } = {}
	local taken: { [string]: boolean } = {}

	local ownedWeapons = 0
	for _, level in run.weaponLevels do
		if level > 0 then
			ownedWeapons += 1
		end
	end

	local function isNewWeapon(definition: UpgradeDefinition): boolean
		return definition.Kind == "NewWeapon"
	end

	local function isOwnedWeaponUpgrade(definition: UpgradeDefinition): boolean
		return definition.Kind == "WeaponUpgrade" and ownsWeapon(run, definition.TargetId)
	end

	-- Garantía 1: con una sola arma siempre hay una carta de arma nueva, para que
	-- la build pueda diversificar aunque el sorteo sea pobre.
	if ownedWeapons < 2 and #chosen < wanted then
		local definition = weightedPick(remaining(eligible, taken, isNewWeapon), luckValue, rand)
		if definition then
			table.insert(chosen, definition)
			taken[definition.Id] = true
		end
	end

	-- Garantía 2: siempre incluir la mejora de un arma que el jugador ya lleva, para
	-- que exista una elección segura.
	local hasOwnedUpgrade = false
	for _, definition in chosen do
		if isOwnedWeaponUpgrade(definition) then
			hasOwnedUpgrade = true
			break
		end
	end
	if not hasOwnedUpgrade and #chosen < wanted then
		local definition = weightedPick(remaining(eligible, taken, isOwnedWeaponUpgrade), luckValue, rand)
		if definition then
			table.insert(chosen, definition)
			taken[definition.Id] = true
		end
	end

	while #chosen < wanted do
		local definition = weightedPick(remaining(eligible, taken, nil), luckValue, rand)
		if not definition then
			break
		end
		table.insert(chosen, definition)
		taken[definition.Id] = true
	end

	local offers: { UpgradeOffer } = {}
	for index, definition in chosen do
		local current = run.upgradeLevels[definition.Id] or 0
		local isUnlock = definition.Kind == "NewWeapon"
		offers[index] = {
			Id = definition.Id,
			Kind = definition.Kind,
			Rarity = definition.Rarity,
			Name = definition.Name,
			Description = definition.Description,
			Icon = definition.Icon,
			TargetId = definition.TargetId,
			CurrentLevel = if isUnlock then 0 else current,
			NextLevel = if isUnlock then 1 else current + 1,
			MaxLevel = definition.MaxLevel,
		}
	end

	return offers
end

return Offers
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="44">
        <Properties>
          <string name="Name">Utilities</string>
        </Properties>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Utilidades de presentación sin estado.
local Format = {}

function Format.clock(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	local minutes = math.floor(total / 60)
	local rest = total % 60
	return `{minutes}:{if rest < 10 then "0" else ""}{rest}`
end

function Format.percent(value: number, decimals: number?): string
	local places = decimals or 0
	return `{math.floor(value * 10 ^ places + 0.5) / 10 ^ places * 100}%`
end

return Format
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="46">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="47">
