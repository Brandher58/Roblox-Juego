      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">GameAssets</string>
          <string name="Source"><![CDATA[--!strict
-- Encuentra visuales de armas cargados por el usuario.
-- Coloca los modelos de Roblox Assets en:
--   ReplicatedStorage → Shared → Assets → (Blade.rbx, Bomb.rbx, Projectile.rbx, …)
-- Si un modelo no existe, el juego vuelve al Part de reserva: no se rompe nada.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local GameAssets = {}

local function getFolder(): Folder?
	local assets = Shared:FindFirstChild("Assets")
	return if assets and assets:IsA("Folder") then assets else nil
end

-- Devuelve una copia de una pieza de modelo cualquiera que exista dentro de
-- Shared/Assets con el nombre indicado. Devuelve nil si no hay nada con ese nombre.
function GameAssets.find(name: string): Instance?
	local assets = getFolder()
	if not assets then
		return nil
	end
	return assets:FindFirstChild(name)
end

-- Misma idea pero obligada a ser una BasePart (MeshPart o Part). Perfecta para
-- proyectiles y miradas de OrbitBlades porque son BasePart que el resto del código
-- ya mueve con CFrame.
function GameAssets.findPart(name: string): BasePart?
	local obj = GameAssets.find(name)
	if obj and obj:IsA("BasePart") then
		return obj :: BasePart
	end
	return nil
end

return GameAssets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--!strict
-- Curva de experiencia. Función pura: sin Roblox, testeable headless.
local Progression = {}

-- XP necesaria para pasar de `level` a `level + 1`.
function Progression.xpForNext(level: number): number
	local steps = math.max(0, level - 1)
	return 6 + steps * 5 + math.floor(steps ^ 1.6)
end

function Progression.xpForLevel(level: number): number
	if level <= 1 then
		return 0
	end
	local total = 0
	for step = 1, level - 1 do
		total += Progression.xpForNext(step)
	end
	return total
end

-- Aplica la XP y devuelve el nuevo nivel, la XP dentro del nivel y cuántos
-- niveles se ganaron (puede ser más de uno con pickups grandes).
function Progression.addXp(currentLevel: number, currentXp: number, amount: number): (number, number, number)
	local level = math.max(1, currentLevel)
	local xp = math.max(0, currentXp) + math.max(0, amount)
	local gained = 0

	while true do
		local needed = Progression.xpForNext(level)
		if xp < needed then
			break
		end
		xp -= needed
		level += 1
		gained += 1
	end

	return level, xp, gained
end

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">Rarity</string>
          <string name="Source"><![CDATA[--!strict
-- Rareza de las mejoras. El peso base sigue la curva estándar 55/27/12/5/1; la
-- estadística Luck multiplica el peso de las rarezas altas, de modo que un jugador
-- con Luck = 2 ve casi el doble de Rare y el doble de Legendario.
local Rarity = {}

export type RarityId = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary"

Rarity.Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }

Rarity.BaseWeight = {
	Common = 55,
	Uncommon = 27,
	Rare = 12,
	Epic = 5,
	Legendary = 1,
}

function Rarity.indexOf(rarity: RarityId): number
	for index, id in Rarity.Order do
		if id == rarity then
			return index - 1
		end
	end
	error(`[Rarity] rareza desconocida: {tostring(rarity)}`)
end

function Rarity.weightOf(rarity: RarityId, luck: number): number
	local factor = luck ^ Rarity.indexOf(rarity)
	return Rarity.BaseWeight[rarity] * factor
end

-- Sortea una rareza. El generador se inyecta para poder probar la curva sin Roblox.
function Rarity.roll(rand: () -> number, luck: number): RarityId
	local total = 0
	local weights: { number } = {}
	for index, rarity in Rarity.Order do
		local weight = Rarity.weightOf(rarity, luck)
		weights[index] = weight
		total += weight
	end

	local target = rand() * total
	local accumulated = 0
	for index, rarity in Rarity.Order do
		accumulated += weights[index]
		if target <= accumulated then
			return rarity
		end
	end
	return "Legendary"
end

return Rarity
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[--!strict
-- Registro de contenido: indexa y valida las definiciones de armas, enemigos y
-- mejoras. Servidor y cliente cargan este mismo registro, así que un error de
-- contenido (id duplicado, stat inexistente, rareza inválida) revienta al cargar en
-- los dos lados, en lugar de aparecer a mitad de una partida.
-- Import dual (ver StatMath.luau): el módulo vecino se resuelve por `script` en Roblox y
-- por ruta relativa en las pruebas headless con Lune.
local Types = require(script and script.Parent.Types or "./Types")
local Rarity = require(script and script.Parent.Rarity or "./Rarity")
local MapList = require(script and script.Parent.Definitions.Maps or "./Definitions/Maps")
local MissionList = require(script and script.Parent.Definitions.Missions or "./Definitions/Missions")

local weaponList = {
	require(script and script.Parent.Definitions.Weapons.Gun or "./Definitions/Weapons/Gun"),
	require(script and script.Parent.Definitions.Weapons.Shotgun or "./Definitions/Weapons/Shotgun"),
	require(script and script.Parent.Definitions.Weapons.Chain or "./Definitions/Weapons/Chain"),
	require(script and script.Parent.Definitions.Weapons.Nova or "./Definitions/Weapons/Nova"),
	require(script and script.Parent.Definitions.Weapons.Bomb or "./Definitions/Weapons/Bomb"),
	require(script and script.Parent.Definitions.Weapons.Orbit or "./Definitions/Weapons/Orbit"),
}

local enemyList = {
	require(script and script.Parent.Definitions.Enemies.Basic or "./Definitions/Enemies/Basic"),
	require(script and script.Parent.Definitions.Enemies.Fast or "./Definitions/Enemies/Fast"),
	require(script and script.Parent.Definitions.Enemies.Tank or "./Definitions/Enemies/Tank"),
	require(script and script.Parent.Definitions.Enemies.Elite or "./Definitions/Enemies/Elite"),
	require(
		script and script.Parent.Definitions.Enemies.MineGuardian or "./Definitions/Enemies/MineGuardian"
	),
}

local upgradeList = {
	require(script and script.Parent.Definitions.Upgrades.GunDamage or "./Definitions/Upgrades/GunDamage"),
	require(
		script and script.Parent.Definitions.Upgrades.GunAttackSpeed
			or "./Definitions/Upgrades/GunAttackSpeed"
	),
	require(
		script and script.Parent.Definitions.Upgrades.ShotgunUnlock or "./Definitions/Upgrades/ShotgunUnlock"
	),
	require(
		script and script.Parent.Definitions.Upgrades.ShotgunDamage or "./Definitions/Upgrades/ShotgunDamage"
	),
	require(
		script and script.Parent.Definitions.Upgrades.ChainUnlock or "./Definitions/Upgrades/ChainUnlock"
	),
	require(
		script and script.Parent.Definitions.Upgrades.ChainDamage or "./Definitions/Upgrades/ChainDamage"
	),
	require(script and script.Parent.Definitions.Upgrades.NovaUnlock or "./Definitions/Upgrades/NovaUnlock"),
	require(script and script.Parent.Definitions.Upgrades.NovaDamage or "./Definitions/Upgrades/NovaDamage"),
	require(script and script.Parent.Definitions.Upgrades.BombUnlock or "./Definitions/Upgrades/BombUnlock"),
	require(script and script.Parent.Definitions.Upgrades.BombDamage or "./Definitions/Upgrades/BombDamage"),
	require(
		script and script.Parent.Definitions.Upgrades.OrbitUnlock or "./Definitions/Upgrades/OrbitUnlock"
	),
	require(
		script and script.Parent.Definitions.Upgrades.OrbitDamage or "./Definitions/Upgrades/OrbitDamage"
	),
	require(script and script.Parent.Definitions.Upgrades.Vitality or "./Definitions/Upgrades/Vitality"),
}

local VALID_STATS: { [string]: boolean } = {
	MaxHealth = true,
	Armor = true,
	MoveSpeed = true,
	Damage = true,
	AttackSpeed = true,
	CriticalChance = true,
	CriticalDamage = true,
	Range = true,
	ProjectileSpeed = true,
	ProjectileCount = true,
	Pellets = true,
	Spread = true,
	PickupRadius = true,
	XPModifier = true,
	Luck = true,
	-- Stats de los comportamientos de area, cadena y contacto.
	Radius = true,
	BlastRadius = true,
	Arc = true,
	ChainCount = true,
	ChainRange = true,
	ChainFalloff = true,
	BladeCount = true,
	OrbitRadius = true,
	OrbitSpeed = true,
	HitCooldown = true,
}

local STARTING_WEAPON_ID = "gun"

local function indexById<T>(list: { T }, kind: string): { [string]: T }
	local byId = {}
	for _, entry in list do
		local id = entry.Id :: string
		if byId[id] then
			error(`[Registry] id duplicado en {kind}: {id}`)
		end
		byId[id] = entry
	end
	return byId
end

local function validateModifiers(source: string, modifiers: { Types.StatModifier })
	for _, modifier in modifiers do
		if not VALID_STATS[modifier.stat] then
			error(`[Registry] stat desconocido "{tostring(modifier.stat)}" en {source}`)
		end
		if modifier.kind ~= "Add" and modifier.kind ~= "Multiply" then
			error(`[Registry] tipo de modificador inválido en {source}`)
		end
	end
end

local VALID_UPGRADE_KINDS: { [string]: boolean } = {
	NewWeapon = true,
	WeaponUpgrade = true,
	Stat = true,
	Passive = true,
}

local VALID_BEHAVIORS: { [string]: boolean } = {
	Projectile = true,
	Nova = true,
	Chain = true,
	Bomb = true,
	Orbit = true,
}

local VALID_OBJECTIVE_TYPES: { [string]: boolean } = {
	Survive = true,
	KillEnemy = true,
	KillElite = true,
	DefeatBoss = true,
}

local Weapons = indexById(weaponList, "Weapons")
local Enemies = indexById(enemyList, "Enemies")
local Upgrades = indexById(upgradeList, "Upgrades")

-- Mapas y misiones se indexan desde diccionarios ya claveados por id. La clave y
-- `Id` deben coincidir; si no, el contenido se busca por una y se encuentra por otra.
local Maps: { [string]: Types.MapDefinition } = {}
for id, map in MapList do
	if Maps[id] then
		error(`[Registry] id duplicado en Maps: {id}`)
	end
	if map.Id ~= id then
		error(`[Registry] el mapa {id} declara Id "{map.Id}"`)
	end
	if map.Arena.HalfExtent <= 0 or map.Arena.FloorY ~= map.Arena.FloorY then
		error(`[Registry] el mapa {id} tiene un arena inválido`)
	end
	if #map.SpawnZones == 0 then
		error(`[Registry] el mapa {id} no declara ninguna zona de spawn`)
	end
	Maps[id] = map
end

local Missions: { [string]: Types.MissionDefinition } = {}
for id, mission in MissionList do
	if Missions[id] then
		error(`[Registry] id duplicado en Missions: {id}`)
	end
	if mission.Id ~= id then
		error(`[Registry] la misión {id} declara Id "{mission.Id}"`)
	end
	if mission.Duration < 0 then
		error(`[Registry] la misión {id} tiene Duration negativa`)
	end
	if #mission.Objectives == 0 then
		error(`[Registry] la misión {id} no declara objetivos`)
	end
	Missions[id] = mission
end

for _, weapon in weaponList do
	if weapon.MaxLevel < 1 then
		error(`[Registry] arma {weapon.Id} con MaxLevel inválido`)
	end
	for level, modifiers in weapon.Scaling do
		if level < 2 or level > weapon.MaxLevel then
			error(`[Registry] arma {weapon.Id} escala en nivel {level}, fuera de 2..{weapon.MaxLevel}`)
		end
		validateModifiers(weapon.Id, modifiers)
	end
	local base = weapon.BaseStats
	if (base.Damage or 0) <= 0 or (base.AttackSpeed or 0) <= 0 then
		error(`[Registry] arma {weapon.Id} necesita Damage y AttackSpeed base`)
	end
	if not VALID_BEHAVIORS[weapon.Behavior] then
		error(`[Registry] arma {weapon.Id} tiene un comportamiento desconocido {weapon.Behavior}`)
	end
end

for _, enemy in enemyList do
	if enemy.Health <= 0 or enemy.Speed <= 0 then
		error(`[Registry] enemigo {enemy.Id} con Health o Speed inválidos`)
	end
end

for _, upgrade in upgradeList do
	if upgrade.MaxLevel < 1 or upgrade.Weight <= 0 then
		error(`[Registry] mejora {upgrade.Id} con MaxLevel o Weight inválidos`)
	end
	if not VALID_UPGRADE_KINDS[upgrade.Kind] then
		error(`[Registry] mejora {upgrade.Id} con Kind inválido {tostring(upgrade.Kind)}`)
	end
	if not Rarity.BaseWeight[upgrade.Rarity] then
		error(`[Registry] mejora {upgrade.Id} con rareza desconocida {tostring(upgrade.Rarity)}`)
	end
	if upgrade.TargetId and not Weapons[upgrade.TargetId] then
		error(`[Registry] mejora {upgrade.Id} apunta al arma inexistente {upgrade.TargetId}`)
	end
	if upgrade.Kind == "NewWeapon" and not upgrade.Requires then
		error(`[Registry] mejora {upgrade.Id} de tipo NewWeapon necesita Requires`)
	end
	validateModifiers(upgrade.Id, upgrade.Modifiers)
end

-- Un arma que ni es la inicial ni tiene una carta que la desbloquee es contenido
-- muerto: existe en el registro pero nunca puede aparecer en una partida.
local unlockable: { [string]: boolean } = { [STARTING_WEAPON_ID] = true }
for _, upgrade in upgradeList do
	if upgrade.Kind == "NewWeapon" and upgrade.TargetId then
		unlockable[upgrade.TargetId] = true
	end
end
for _, weapon in weaponList do
	if not unlockable[weapon.Id] then
		error(`[Registry] el arma {weapon.Id} no tiene mejora que la desbloquee`)
	end
end

-- Validación cruzada de misiones: toda referencia (mapa, enemigo, jefe, desbloqueo)
-- tiene que existir. Un contenido roto revienta al cargar en servidor y cliente, no
-- a mitad de una partida.
for id, mission in Missions do
	if not Maps[mission.MapId] then
		error(`[Registry] la misión {id} apunta al mapa inexistente {mission.MapId}`)
	end

	for index, objective in mission.Objectives do
		if not VALID_OBJECTIVE_TYPES[objective.Type] then
			error(`[Registry] la misión {id} tiene un objetivo desconocido {tostring(objective.Type)}`)
		end
		if objective.Type == "Survive" then
			if (objective.Duration or 0) <= 0 then
				error(`[Registry] la misión {id} objetivo {index}: Survive necesita Duration > 0`)
			end
		elseif objective.Type == "KillEnemy" or objective.Type == "KillElite" then
			if (objective.Amount or 0) < 1 then
				error(`[Registry] la misión {id} objetivo {index}: {objective.Type} necesita Amount >= 1`)
			end
			if objective.Type == "KillEnemy" and objective.TargetId and not Enemies[objective.TargetId] then
				error(`[Registry] la misión {id} objetivo {index}: enemigo inexistente {objective.TargetId}`)
			end
		elseif objective.Type == "DefeatBoss" then
			local boss = objective.TargetId and Enemies[objective.TargetId]
			if not boss then
				error(`[Registry] la misión {id} objetivo {index}: jefe inexistente`)
			end
			if not table.find(boss.Tags, "boss") then
				error(`[Registry] la misión {id} objetivo {index}: {boss.Id} no está etiquetado como boss`)
			end
		end
	end

	for enemyId, entry in mission.EnemyConfiguration do
		if not Enemies[enemyId] then
			error(`[Registry] la misión {id} configura el enemigo inexistente {enemyId}`)
		end
		if typeof(entry.Enabled) ~= "boolean" or entry.Weight < 0 then
			error(`[Registry] la misión {id} tiene una entrada inválida para {enemyId}`)
		end
	end

	if mission.Boss then
		local boss = Enemies[mission.Boss.Id]
		if not boss or not table.find(boss.Tags, "boss") then
			error(`[Registry] la misión {id} invoca un jefe inexistente {mission.Boss.Id}`)
		end
		if (mission.Boss.SpawnAt or 0) < 0 then
			error(`[Registry] la misión {id} tiene un SpawnAt negativo`)
		end
	end

	for _, unlocked in mission.Rewards.MissionUnlocks do
		if not Missions[unlocked] then
			error(`[Registry] la misión {id} desbloquea la misión inexistente {unlocked}`)
		end
	end
	for _, unlocked in mission.Rewards.MapUnlocks do
		if not Maps[unlocked] then
			error(`[Registry] la misión {id} desbloquea el mapa inexistente {unlocked}`)
		end
	end
end

return {
	Weapons = Weapons,
	Enemies = Enemies,
	Upgrades = Upgrades,
	Maps = Maps,
	Missions = Missions,
	StartingWeaponId = STARTING_WEAPON_ID,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Contrato de red. Un solo punto de acceso a los remotes: el cliente nunca los
-- busca por su cuenta y el servidor siempre los referencia desde aquí.
--
-- Los payloads son datos de presentación o peticiones. Nunca se acepta desde el
-- cliente daño, XP, recompensas ni precios.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function remote(name: string, className: string): Instance
	local folder = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not folder then
		error("[Remotes] ReplicatedStorage.Remotes no llegó desde el servidor")
	end
	local instance = folder:WaitForChild(name, 10)
	if not instance then
		error(`[Remotes] falta el remote "{name}"`)
	end
	if not instance:IsA(className) then
		error(`[Remotes] "{name}" debería ser {className}`)
	end
	return instance
end

return {
	-- Servidor → cliente: (state: MatchState, elapsed: number, offers: {UpgradeOffer}?)
	MatchStateChanged = remote("MatchStateChanged", "RemoteEvent") :: RemoteEvent,
	-- Servidor → cliente: snapshot completo del HUD (RunSnapshot).
	RunSnapshot = remote("RunSnapshot", "RemoteEvent") :: RemoteEvent,
	-- Servidor → cliente: una carta ya elegida (string id).
	UpgradeChosen = remote("UpgradeChosen", "RemoteEvent") :: RemoteEvent,
	-- Cliente → servidor: el cliente ya registró sus listeners; pide su estado.
	ClientReady = remote("ClientReady", "RemoteEvent") :: RemoteEvent,
	-- Cliente → servidor: petición de elegir carta (string id). Se valida contra
	-- el conjunto de ofertas pendientes y se consume una sola vez.
	RequestUpgrade = remote("RequestUpgrade", "RemoteEvent") :: RemoteEvent,
	-- Servidor → cliente: feedback visual descartable (kind: string, position, magnitude).
	CombatEffect = remote("CombatEffect", "UnreliableRemoteEvent") :: UnreliableRemoteEvent,
	-- Cliente → servidor: comando de desarrollo (solo Studio; fuera de Studio no hay
	-- handler). Payload: (command: string, value: unknown).
	AdminCommand = remote("AdminCommand", "RemoteEvent") :: RemoteEvent,
	-- Cliente → servidor: petición de empezar una misión (string missionId). El
	-- servidor valida existencia y desbloqueo; el cliente nunca cambia de estado.
	RequestMission = remote("RequestMission", "RemoteEvent") :: RemoteEvent,
	-- Servidor → cliente: lista de misiones con su estado para este jugador
	-- ({MissionSummary}).
	MissionList = remote("MissionList", "RemoteEvent") :: RemoteEvent,
	-- Servidor → cliente: instantánea de la misión en curso (MissionSnapshot) o nil.
	MissionUpdate = remote("MissionUpdate", "RemoteEvent") :: RemoteEvent,
	-- Servidor → cliente: resultado final de la misión (MissionResult).
	MissionFinished = remote("MissionFinished", "RemoteEvent") :: RemoteEvent,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">StatMath</string>
          <string name="Source"><![CDATA[--!strict
-- Cálculo de estadísticas. Todo puro, sin Roblox: se puede probar headless.
--
-- Pipeline de jugador:
--   base (Config.PlayerBaseStats)
--   + modificadores Add
--   x modificadores Multiply
--   = stats finales
--
-- Pipeline de arma:
--   base de la definición
--   + scaling por nivel
--   + modificadores de mejoras dirigidas a esa arma
--   x multiplicadores globales del jugador
--   = stats del arma
-- Import dual: en Roblox se resuelve el ModuleScript vecino; fuera de Studio (las
-- pruebas headless con Lune) cae a la ruta relativa, porque Lune no expone `script`.
local Types = require(script and script.Parent.Types or "./Types")

type StatModifier = Types.StatModifier
type StatBlock = Types.StatBlock
type WeaponDefinition = Types.WeaponDefinition

local StatMath = {}

function StatMath.apply(stats: StatBlock, modifier: StatModifier)
	local current = stats[modifier.stat] or 0
	if modifier.kind == "Add" then
		stats[modifier.stat] = current + modifier.value
	else
		stats[modifier.stat] = current * modifier.value
	end
end

-- Los "Add" se resuelven antes que los "Multiply" para que el resultado no dependa
-- del orden en el que se registraron los modificadores.
function StatMath.resolve(base: StatBlock, modifiers: { StatModifier }): StatBlock
	local stats = table.clone(base)
	for _, modifier in modifiers do
		if modifier.kind == "Add" then
			StatMath.apply(stats, modifier)
		end
	end
	for _, modifier in modifiers do
		if modifier.kind == "Multiply" then
			StatMath.apply(stats, modifier)
		end
	end
	return stats
end

-- Las estadísticas globales del jugador son multiplicadores por diseño:
-- Config.PlayerBaseStats deja Damage/AttackSpeed/Range/ProjectileSpeed en 1 y
-- ProjectileCount/Pellets/Spread en 0, así que añadir una mejora global nunca
-- pisa el valor propio del arma.
local GLOBAL_MULTIPLIERS: { Types.StatKey } = { "Damage", "AttackSpeed", "Range", "ProjectileSpeed" }
local GLOBAL_ADDITIONS: { Types.StatKey } = { "ProjectileCount", "Pellets", "Spread" }

function StatMath.weapon(
	definition: WeaponDefinition,
	level: number,
	upgrades: { StatModifier },
	playerStats: StatBlock
): StatBlock
	local stats = table.clone(definition.BaseStats)

	for step = 2, level do
		local modifiers = definition.Scaling[step]
		if modifiers then
			for _, modifier in modifiers do
				StatMath.apply(stats, modifier)
			end
		end
	end

	for _, modifier in upgrades do
		StatMath.apply(stats, modifier)
	end

	for _, stat in GLOBAL_MULTIPLIERS do
		stats[stat] = (stats[stat] or 0) * (playerStats[stat] or 1)
	end
	for _, stat in GLOBAL_ADDITIONS do
		stats[stat] = (stats[stat] or 0) + (playerStats[stat] or 0)
	end

	return stats
end

return StatMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Tipos compartidos entre servidor y cliente.
-- Regla: este módulo no toca la API de Roblox, para que los módulos puros que lo
-- consumen (definiciones, progresión, rareza) se puedan probar fuera de Studio.

export type StatKey =
	| "MaxHealth"
	| "Armor"
	| "MoveSpeed"
	| "Damage"
	| "AttackSpeed"
	| "CriticalChance"
	| "CriticalDamage"
	| "Range"
	| "ProjectileSpeed"
	| "ProjectileCount"
	| "Pellets"
	| "Spread"
	| "PickupRadius"
	| "XPModifier"
	| "Luck"
	| "Radius"
	| "BlastRadius"
	| "Arc"
	| "ChainCount"
	| "ChainRange"
	| "ChainFalloff"
	| "BladeCount"
	| "OrbitRadius"
	| "OrbitSpeed"
	| "HitCooldown"

-- "Add" suma el valor, "Multiply" escala el acumulado. Se aplican en ese orden
-- sobre el bloque base para que el resultado sea intuitivo de leer.
export type ModifierKind = "Add" | "Multiply"

export type StatModifier = {
	stat: StatKey,
	kind: ModifierKind,
	value: number,
	source: string,
	-- Duración en segundos. nil = permanente durante la partida.
	duration: number?,
}

export type StatBlock = { [StatKey]: number }

export type Rarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary"

-- Identificador de comportamiento de ataque. Un comportamiento nuevo se registra
-- en Server/Combat/WeaponBehaviors.luau sin tocar WeaponRuntime ni las definiciones.
export type WeaponBehaviorId = "Projectile" | "Nova" | "Chain" | "Bomb" | "Orbit"

export type WeaponDefinition = {
	Id: string,
	Name: string,
	Description: string,
	Icon: string,
	MaxLevel: number,
	Behavior: WeaponBehaviorId,
	BaseStats: StatBlock,
	-- Clave = nivel mínimo en el que se aplican sus modificadores.
	Scaling: { [number]: { StatModifier } },
	Tags: { string },
	-- false = el arma no necesita un enemigo al que apuntar, así que WeaponRuntime se
	-- ahorra la búsqueda del objetivo más cercano. Por defecto true.
	RequiresTarget: boolean?,
}

export type EnemyAttackType = "Contact" | "Projectile" | "None"

export type EnemyDefinition = {
	Id: string,
	Name: string,
	Health: number,
	Speed: number,
	Damage: number,
	AttackInterval: number,
	AttackRange: number,
	XPReward: number,
	Size: number,
	AttackType: EnemyAttackType,
	Tags: { string },
}

export type UpgradeKind = "NewWeapon" | "WeaponUpgrade" | "Stat" | "Passive"

-- Vista de la partida que las definiciones consultan para requisitos y evolución.
export type RunView = {
	level: number,
	weaponLevels: { [string]: number },
	upgradeLevels: { [string]: number },
}

export type UpgradeDefinition = {
	Id: string,
	Kind: UpgradeKind,
	Rarity: Rarity,
	Name: string,
	Description: string,
	Icon: string,
	MaxLevel: number,
	Weight: number,
	-- Arma a la que aplica: "NewWeapon" y "WeaponUpgrade" lo requieren.
	TargetId: string?,
	Modifiers: { StatModifier },
	-- Punto de extensión para evoluciones: sin requisitos devuelve nil.
	Requires: ((run: RunView) -> boolean)?,
}

-- Payload que el cliente pinta en las cartas de subida de nivel.
export type UpgradeOffer = {
	Id: string,
	Kind: UpgradeKind,
	Rarity: Rarity,
	Name: string,
	Description: string,
	Icon: string,
	TargetId: string?,
	CurrentLevel: number,
	NextLevel: number,
	MaxLevel: number,
}

export type WeaponView = {
	Id: string,
	Name: string,
	Icon: string,
	Level: number,
	MaxLevel: number,
}

export type PassiveView = {
	Id: string,
	Name: string,
	Icon: string,
	Level: number,
	MaxLevel: number,
}

export type BuffView = {
	Name: string,
	Remaining: number,
}

export type RunSnapshot = {
	State: MatchState,
	Elapsed: number,
	Health: number,
	MaxHealth: number,
	Level: number,
	XP: number,
	XPToNext: number,
	Weapons: { WeaponView },
	Passives: { PassiveView },
	Buffs: { BuffView },
	MoveSpeed: number,
	PickupRadius: number,
}

export type MatchState =
	"Lobby"
	| "Starting"
	| "Playing"
	| "LevelUp"
	| "Event"
	| "Boss"
	| "MissionSelect"
	| "Victory"
	| "Defeat"

-- Un mapa es geometría + puntos de interés declarados con números planos, para que
-- el registro de contenido se pueda validar headless (sin la API de Roblox).
export type MapDefinition = {
	Id: string,
	DisplayName: string,
	Description: string?,
	Arena: { HalfExtent: number, FloorY: number },
	PlayerSpawn: { X: number, Y: number, Z: number },
	SpawnZones: { { Name: string, X: number, Y: number, Z: number, Radius: number } },
}

export type MissionObjectiveType = "Survive" | "KillEnemy" | "KillElite" | "DefeatBoss"

export type MissionObjective = {
	Type: MissionObjectiveType,
	Duration: number?,
	TargetId: string?,
	Amount: number?,
}

export type MissionState =
	"Locked"
	| "Available"
	| "Preparing"
	| "Active"
	| "Completing"
	| "Completed"
	| "Failed"

export type EnemyConfiguration = {
	[string]: { Enabled: boolean, Weight: number },
}

-- Global difficulty traits specific to a mission. The Spawner uses them.
export type MissionDifficulty = {
	EnemyHealthMultiplier: number,
	EnemyDamageMultiplier: number,
	EnemySpawnRateMultiplier: number,
	EliteChance: number?,
}

export type MissionRewards = {
	Currency: number,
	MissionUnlocks: { string },
	MapUnlocks: { string },
}

export type MissionDefinition = {
	Id: string,
	MapId: string,
	DisplayName: string,
	Description: string,
	Duration: number,
	Objectives: { MissionObjective },
	EnemyConfiguration: EnemyConfiguration,
	Boss: { Id: string, SpawnAt: number? }?,
	Rewards: MissionRewards,
	DifficultyMultipliers: MissionDifficulty,
}

export type MapDefinitions = { [string]: MapDefinition }
export type MissionDefinitions = { [string]: MissionDefinition }

-- Vista de un objetivo concreto durante una misión. `Required` es siempre el total
-- normalizado (1 para objetivos booleanos como derrotar al jefe), para que la UI no
-- tenga que conocer la forma de cada tipo de objetivo.
export type MissionObjectiveState = {
	Type: MissionObjectiveType,
	Label: string,
	Current: number,
	Required: number,
	Complete: boolean,
}

export type MissionBossView = {
	Id: string,
	Name: string,
	Active: boolean,
	Health: number,
	MaxHealth: number,
}

-- Instantánea autoritativa que el servidor envía al cliente mientras hay misión.
export type MissionSnapshot = {
	MissionId: string,
	DisplayName: string,
	MapId: string,
	State: MissionState,
	Elapsed: number,
	Remaining: number?,
	Objectives: { MissionObjectiveState },
	Boss: MissionBossView?,
}

-- Resumen de misión para el panel de selección (estado por jugador incluido).
export type MissionSummary = {
	Id: string,
	MapId: string,
	MapName: string,
	DisplayName: string,
	Description: string,
	Duration: number,
	State: MissionState,
	Objectives: { { Type: MissionObjectiveType, Label: string, Required: number } },
	Rewards: { Currency: number, Missions: { string }, Maps: { string } },
}

export type MissionResult = {
	MissionId: string,
	DisplayName: string,
	Outcome: "Completed" | "Failed",
	Duration: number,
	BossDefeated: boolean,
	Currency: number,
	UnlockedMissions: { string },
	UnlockedMaps: { string },
}

-- Este módulo solo exporta tipos. La tabla vacía evita que el require devuelva nil y
-- que el analizador de Studio marque los usos `Types.Algo` como acceso a nil.
return {}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">UpgradeOffers</string>
          <string name="Source"><![CDATA[--!strict
-- Generación de las ofertas de subida de nivel.
--
-- Es una función pura a propósito: el servidor la llama, pero se puede probar sin
-- Studio. Además del peso por rareza hay garantías explícitas, porque el diseño
-- pide que ninguna partida se vuelva frustrante por mala suerte.
-- Import dual (ver StatMath.luau): el vecino se resuelve por `script` en Roblox y por
-- ruta relativa en las pruebas headless con Lune.
local Types = require(script and script.Parent.Types or "./Types")
local Registry = require(script and script.Parent.Registry or "./Registry")
local Rarity = require(script and script.Parent.Rarity or "./Rarity")

type RunView = Types.RunView
type UpgradeDefinition = Types.UpgradeDefinition
type UpgradeOffer = Types.UpgradeOffer

-- Orden estable para que las pruebas y el reparto de pesos sean deterministas.
local UPGRADE_IDS: { string } = {}
for id in Registry.Upgrades do
	table.insert(UPGRADE_IDS, id)
end
table.sort(UPGRADE_IDS)

local function isEligible(definition: UpgradeDefinition, run: RunView): boolean
	local current = run.upgradeLevels[definition.Id] or 0
	if current >= definition.MaxLevel then
		return false
	end
	return if definition.Requires then definition.Requires(run) else true
end

local function rarityWeight(definition: UpgradeDefinition, luck: number): number
	return definition.Weight * Rarity.weightOf(definition.Rarity, luck)
end

local function weightedPick(
	candidates: { UpgradeDefinition },
	luck: number,
	rand: () -> number
): UpgradeDefinition?
	local weights = table.create(#candidates)
	local total = 0
	for index, definition in candidates do
		weights[index] = rarityWeight(definition, luck)
		total += weights[index]
	end
	if total <= 0 then
		return nil
	end

	local target = rand() * total
	local accumulated = 0
	for index, definition in candidates do
		accumulated += weights[index]
		if target <= accumulated then
			return definition
		end
	end
	return candidates[#candidates]
end

local function remaining(
	candidates: { UpgradeDefinition },
	taken: { [string]: boolean },
	predicate: ((UpgradeDefinition) -> boolean)?
): { UpgradeDefinition }
	local pool = {}
	for _, definition in candidates do
		if not taken[definition.Id] and (not predicate or predicate(definition)) then
			table.insert(pool, definition)
		end
	end
	return pool
end

local function ownsWeapon(run: RunView, weaponId: string?): boolean
	return weaponId ~= nil and (run.weaponLevels[weaponId] or 0) > 0
end

local Offers = {}

function Offers.generate(run: RunView, luck: number, rand: () -> number, count: number?): { UpgradeOffer }
	local wanted = count or 3
	local luckValue = math.max(0.05, luck)

	local eligible: { UpgradeDefinition } = {}
	for _, id in UPGRADE_IDS do
		local definition = Registry.Upgrades[id]
		if isEligible(definition, run) then
			table.insert(eligible, definition)
		end
	end

	local chosen: { UpgradeDefinition } = {}
	local taken: { [string]: boolean } = {}

	local ownedWeapons = 0
	for _, level in run.weaponLevels do
		if level > 0 then
			ownedWeapons += 1
		end
	end

	local function isNewWeapon(definition: UpgradeDefinition): boolean
		return definition.Kind == "NewWeapon"
	end

	local function isOwnedWeaponUpgrade(definition: UpgradeDefinition): boolean
		return definition.Kind == "WeaponUpgrade" and ownsWeapon(run, definition.TargetId)
	end

	-- Garantía 1: con una sola arma siempre hay una carta de arma nueva, para que
	-- la build pueda diversificar aunque el sorteo sea pobre.
	if ownedWeapons < 2 and #chosen < wanted then
		local definition = weightedPick(remaining(eligible, taken, isNewWeapon), luckValue, rand)
		if definition then
			table.insert(chosen, definition)
			taken[definition.Id] = true
		end
	end

	-- Garantía 2: siempre incluir la mejora de un arma que el jugador ya lleva, para
	-- que exista una elección segura.
	local hasOwnedUpgrade = false
	for _, definition in chosen do
		if isOwnedWeaponUpgrade(definition) then
			hasOwnedUpgrade = true
			break
		end
	end
	if not hasOwnedUpgrade and #chosen < wanted then
		local definition = weightedPick(remaining(eligible, taken, isOwnedWeaponUpgrade), luckValue, rand)
		if definition then
			table.insert(chosen, definition)
			taken[definition.Id] = true
		end
	end

	while #chosen < wanted do
		local definition = weightedPick(remaining(eligible, taken, nil), luckValue, rand)
		if not definition then
			break
		end
		table.insert(chosen, definition)
		taken[definition.Id] = true
	end

	local offers: { UpgradeOffer } = {}
	for index, definition in chosen do
		local current = run.upgradeLevels[definition.Id] or 0
		local isUnlock = definition.Kind == "NewWeapon"
		offers[index] = {
			Id = definition.Id,
			Kind = definition.Kind,
			Rarity = definition.Rarity,
			Name = definition.Name,
			Description = definition.Description,
			Icon = definition.Icon,
			TargetId = definition.TargetId,
			CurrentLevel = if isUnlock then 0 else current,
			NextLevel = if isUnlock then 1 else current + 1,
			MaxLevel = definition.MaxLevel,
		}
	end

	return offers
end

return Offers
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="55">
        <Properties>
          <string name="Name">Utilities</string>
        </Properties>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Utilidades de presentación sin estado.
local Format = {}

function Format.clock(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	local minutes = math.floor(total / 60)
	local rest = total % 60
	return `{minutes}:{if rest < 10 then "0" else ""}{rest}`
end

function Format.percent(value: number, decimals: number?): string
	local places = decimals or 0
	return `{math.floor(value * 10 ^ places + 0.5) / 10 ^ places * 100}%`
end

return Format
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="57">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="58">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">Admin</string>
          <string name="Source"><![CDATA[--!strict
-- Menú de administración SOLO en Studio: otorga armas, sube mejoras a tope, da XP
-- y cura, para poder playtestear el arsenal sin depender del sorteo de cartas.
--
-- El remote existe también en builds de producción (el árbol de ReplicatedStorage
-- no difiere), pero "un botón no es autoridad": fuera de Studio no hay handler, así
-- que FireServer no tiene ningún efecto. Y aunque un cliente llegara a usarlo en un
-- servidor de Studio, los comandos son una lista fija con tipos validados.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared:WaitForChild("Registry"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Run = require(script.Parent.Run)
local Stats = require(script.Parent.Stats)
local PlayerAvatar = require(script.Parent.PlayerAvatar)
local Match = require(script.Parent.Match)
local WeaponRuntime = require(script.Parent.Combat.WeaponRuntime)
local MissionManager = require(script.Parent.Missions.MissionManager)

type RunState = Run.Run

local Admin = {}

local function heal(player: Player)
	local humanoid = PlayerAvatar.humanoid(player)
	local stats = Stats.get(player)
	if humanoid then
		humanoid.Health = math.min(humanoid.MaxHealth, stats.MaxHealth or 100)
	end
end

-- Refresca la proyección al avatar, reinicia los relojes de armas (para que
-- disparen ya con las stats nuevas) y empuja un snapshot al HUD.
local function commit(player: Player)
	PlayerAvatar.applyStats(player, Stats.get(player))
	WeaponRuntime.reset(player)
	Match.pushSnapshot(player)
end

local function handle(player: Player, command: unknown, value: unknown): boolean
	if typeof(command) ~= "string" then
		return false
	end

	local state = Run.get(player)
	if command == "unlock_all" then
		for weaponId, _weapon in Registry.Weapons do
			state.weaponLevels[weaponId] = math.max(1, state.weaponLevels[weaponId] or 0)
		end
	elseif command == "max_all" then
		for weaponId, weapon in Registry.Weapons do
			state.weaponLevels[weaponId] = weapon.MaxLevel
		end
		for upgradeId, upgrade in Registry.Upgrades do
			if upgrade.Kind ~= "NewWeapon" then
				state.upgradeLevels[upgradeId] = upgrade.MaxLevel
			end
		end
	elseif command == "grant_xp" then
		if typeof(value) ~= "number" then
			return false
		end
		Match.grantXp(player, value)
		return true
	elseif command == "level_up" then
		-- Subir el nivel de UN arma manualmente (o desbloquearla si todavía no
		-- estaba en el inventario).
		if typeof(value) ~= "string" then
			return false
		end
		local weapon = Registry.Weapons[value]
		if not weapon then
			return false
		end
		state.weaponLevels[value] = math.min((state.weaponLevels[value] or 0) + 1, weapon.MaxLevel)
	elseif command == "upgrade_level_up" then
		-- Subir el nivel de UNA mejora manualmente.
		if typeof(value) ~= "string" then
			return false
		end
		local upgrade = Registry.Upgrades[value]
		if not upgrade or upgrade.Kind == "NewWeapon" then
			return false
		end
		state.upgradeLevels[value] = math.min((state.upgradeLevels[value] or 0) + 1, upgrade.MaxLevel)
	elseif command == "skip_time" then
		-- Dev: adelanta el reloj de partida y los objetivos de supervivencia para
		-- probar fases tardías del mapa sin esperar.
		if typeof(value) ~= "number" or value <= 0 or value > 600 then
			return false
		end
		Match.advanceTime(value)
		MissionManager.skipTime(value)
		return true
	elseif command == "heal" then
		heal(player)
	else
		return false
	end

	commit(player)
	return true
end

function Admin.init()
	if not RunService:IsStudio() then
		return
	end
	Remotes.AdminCommand.OnServerEvent:Connect(function(player: Player, command: unknown, value: unknown)
		if not handle(player, command, value) then
			warn(`[Admin] comando rechazado de {player.Name}`)
		end
	end)
end

return Admin
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="60">
        <Properties>
          <string name="Name">Combat</string>
        </Properties>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">OrbitBlades</string>
            <string name="Source"><![CDATA[--!strict
-- Cuchillas orbitando al jugador. Es el unico arma que no dispara por cadencia: son
-- piezas persistentes que giran alrededor del personaje y cortan por contacto.
--
-- El ritmo de corte lo lleva un enfriamiento POR ENEMIGO guardado en el propio
-- enemigo, no en un mapa aparte: asi no hay nada que limpiar y el recorte es gratis
-- cuando la horda se vacia.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local GameAssets = require(Shared:WaitForChild("GameAssets"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Pool = require(script.Parent.Parent.Utility.Pool)
local EnemyRegistry = require(script.Parent.Parent.Enemies.EnemyRegistry)
local PlayerAvatar = require(script.Parent.Parent.PlayerAvatar)

type Blade = {
	Part: Part,
	Lease: any,
}

type Orbit = {
	Blades: { Blade },
	Damage: number,
	IsCrit: boolean,
	Radius: number,
	Speed: number,
	Cooldown: number,
	Angle: number,
}

-- Margen que se anade al radio de contacto al pedir celdas a la rejilla, para
-- incluir el cuerpo completo de un enemigo grande sin conocer su tamano antes.
local QUERY_PAD = 8

local sets: { [Player]: Orbit } = {}
local container: Folder = nil
local pool: Pool.Pooled = nil

local function buildTemplate(): Part
	-- El usuario puede sustituir una Part de reserva por un modelo. Si Shared/Assets
	-- contiene "Blade", ese modelo se usa; si no, se cae a un Part neon básico.
	local fromAssets = GameAssets.findPart("Blade")
	if fromAssets then
		return fromAssets:Clone()
	end

	local part = Instance.new("Part")
	part.Name = "Blade"
	part.Size = Config.Orbit.BladeSize
	part.Color = Config.Orbit.BladeColor
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	return part
end

local OrbitBlades = {}

function OrbitBlades.init()
	if container then
		return
	end
	container = Instance.new("Folder")
	container.Name = "OrbitBlades"
	container.Parent = workspace
	pool = Pool.new(buildTemplate(), Config.Orbit.MaxBlades * 4)
end

function OrbitBlades.reset(player: Player)
	local orbit = sets[player]
	if not orbit or not pool then
		return
	end
	for _, blade in orbit.Blades do
		pool:Release(blade.Part, blade.Lease)
	end
	sets[player] = nil
end

function OrbitBlades.clearAll()
	local players = table.create(0)
	for player in sets do
		table.insert(players, player)
	end
	for _, player in players do
		OrbitBlades.reset(player)
	end
end

-- Reconcilia el juego de cuchillas de un jugador con sus estadisticas actuales. Lo
-- llama el comportamiento del arma a su propia cadencia, asi que subir de nivel o
-- comprar una mejora se refleja en el siguiente disparo sin tocar nada mas.
function OrbitBlades.configure(player: Player, stats: { [string]: number }, damage: number, isCrit: boolean)
	if not pool then
		return
	end

	local wanted = math.clamp(math.round(stats.BladeCount or 0), 0, Config.Orbit.MaxBlades)
	if wanted <= 0 then
		OrbitBlades.reset(player)
		return
	end

	local orbit = sets[player]
	if not orbit then
		orbit = {
			Blades = {},
			Damage = damage,
			IsCrit = isCrit,
			Radius = 6,
			Speed = 2.5,
			Cooldown = 0.45,
			Angle = 0,
		}
		sets[player] = orbit
	end

	orbit.Damage = damage
	orbit.IsCrit = isCrit
	orbit.Radius = math.max(2, stats.OrbitRadius or 6)
	orbit.Speed = math.max(0.2, stats.OrbitSpeed or 2.5)
	orbit.Cooldown = math.max(Config.Orbit.HitCooldownFloor, stats.HitCooldown or 0.45)

	while #orbit.Blades > wanted do
		local blade = table.remove(orbit.Blades)
		pool:Release(blade.Part, blade.Lease)
	end
	while #orbit.Blades < wanted do
		local acquired, lease = pool:Get(function(instance)
			local part = instance :: Part
			part.Size = Config.Orbit.BladeSize
			part.Color = Config.Orbit.BladeColor
			part.Parent = container
		end)
		table.insert(orbit.Blades, { Part = acquired :: Part, Lease = lease })
	end
end

local function cut(position: Vector3, tangent: Vector3, orbit: Orbit, now: number)
	local contact = Config.Orbit.ContactRadius
	for _, enemy in EnemyRegistry.queryRadius(position, contact + QUERY_PAD) do
		if enemy.HitLockUntil <= now then
			local dx = enemy.Position.X - position.X
			local dz = enemy.Position.Z - position.Z
			local reach = enemy.Definition.Size * 0.5 + contact
			local distance = dx * dx + dz * dz
			if distance <= reach * reach then
				enemy.HitLockUntil = now + orbit.Cooldown
				EnemyRegistry.damage(enemy, orbit.Damage, orbit.IsCrit)
				-- Arco de corte: un rayito desde el filo hacia donde viene la cuchilla
				-- (la tangente al giro). El cliente lo dibuja corto y brillante.
				Remotes.CombatEffect:FireAllClients(
					"slash",
					position,
					1,
					position + tangent * Config.Orbit.SlashLength
				)
			end
		end
	end
end

function OrbitBlades.update(dt: number, now: number)
	for player, orbit in sets do
		local root = PlayerAvatar.root(player)
		-- Sin personaje no hay centro orbital: se recoge el juego entero en vez de
		-- dejar las cuchillas colgadas en el aire.
		if not root or not player.Parent then
			OrbitBlades.reset(player)
			continue
		end

		orbit.Angle += orbit.Speed * dt
		local count = #orbit.Blades
		if count == 0 then
			continue
		end

		-- A la altura del cuerpo de los enemigos, no a la del jugador: asi el barrido
		-- se ve pasar por la horda en vez de flotar por encima de ella.
		local center = Vector3.new(root.Position.X, Config.Arena.FloorY + 1.2, root.Position.Z)
		local spacing = math.pi * 2 / count

		for index, blade in orbit.Blades do
			local angle = orbit.Angle + spacing * index
			local cos, sin = math.cos(angle), math.sin(angle)
			-- Bob vertical sutil y desfasado por cuchilla, para que el enjambre no se
			-- lea como un disco muerto: cada cuchilla sube y baja mientras orbita.
			local bob = math.sin(now * Config.Orbit.BobSpeed + index * 0.9) * Config.Orbit.BobAmount
			local position = center + Vector3.new(cos, 0, sin) * orbit.Radius + Vector3.new(0, bob, 0)
			local tangent = Vector3.new(-sin, 0, cos)
			-- Orientada tangente al giro, que es como se lee una cuchilla girando.
			blade.Part.CFrame = CFrame.lookAt(position, position + tangent)
			cut(position, tangent, orbit, now)
		end
	end
end

return OrbitBlades
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Projectiles</string>
            <string name="Source"><![CDATA[--!strict
-- Proyectiles pooled y autoritativos. El servidor decide los impactos; el cliente
-- solo ve la posición replicada de la partícula.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local GameAssets = require(Shared:WaitForChild("GameAssets"))
local Pool = require(script.Parent.Parent.Utility.Pool)
local EnemyRegistry = require(script.Parent.Parent.Enemies.EnemyRegistry)

-- Sub-pasos para que un frame lento no haga que el proyectil atraviese al enemigo
-- sin comprobar el impacto.
local MAX_STEP_DISTANCE = 2

local Projectiles = {}

type Projectile = {
	Part: BasePart,
	Position: Vector3,
	Velocity: Vector3,
	Damage: number,
	IsCrit: boolean,
	Owner: Player,
	Life: number,
	-- Radio de explosión. 0 = proyectil simple que se devuelve al pool al impactar.
	BlastRadius: number,
	-- Gravedad vertical. 0 = vuelo recto; > 0 = parábola que acaba detonando.
	Gravity: number,
	-- Giro acumulado en vuelo (rad). Solo las bombas giran: las balas rectas llevan
	-- SpinRate a cero y se conservan con su orientación actual.
	Spin: number,
	SpinRate: number,
	Slot: number,
	Lease: any,
}

local projectiles: { Projectile } = {}
local container: Folder = nil
local pool: Pool.Pooled = nil

local function buildTemplate(): Part
	-- Los visuales de proyectil son modulares: si hay un modelo con nombre "Projectile"
	-- en Shared/Assets, ese modelo se usa; si no, un Part neon básico.
	local fromAssets = GameAssets.findPart("Projectile")
	if fromAssets then
		return fromAssets:Clone()
	end

	local part = Instance.new("Part")
	part.Name = "Projectile"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(0.7, 0.7, 0.7)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	return part
end

-- Rastro de las bombas: dos attachments perpendiculares al avance (así el ribete
-- tiene anchura que la cámara top-down sí ve) y un Trail apagado por defecto. Se
-- monta una sola vez por pieza; el pool recicla la pieza, no el rastro.
local function ensureBombTrail(part: Part)
	if part:FindFirstChild("BombTrail") then
		return
	end

	local attach0 = Instance.new("Attachment")
	attach0.Name = "Trail0"
	attach0.Position = Vector3.new(0.65, 0, 0)

	local attach1 = Instance.new("Attachment")
	attach1.Name = "Trail1"
	attach1.Position = Vector3.new(-0.65, 0, 0)

	local trail = Instance.new("Trail")
	trail.Name = "BombTrail"
	trail.Attachment0 = attach0
	trail.Attachment1 = attach1
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 164, 68))
	trail.Lifetime = Config.Projectile.BombTrail.Lifetime
	trail.MaxLength = Config.Projectile.BombTrail.Length
	trail.MinLength = 0.5
	trail.LightEmission = Config.Projectile.BombTrail.LightEmission
	trail.Brightness = Config.Projectile.BombTrail.Brightness
	trail.Transparency =
		NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	trail.Enabled = false
	trail.Parent = part
	attach0.Parent = part
	attach1.Parent = part
end

function Projectiles.init()
	if container then
		return
	end
	container = Instance.new("Folder")
	container.Name = "Projectiles"
	container.Parent = workspace
	pool = Pool.new(buildTemplate(), 96)
end

function Projectiles.count(): number
	return #projectiles
end

-- Camino común de los dos tipos de proyectil. La única diferencia entre una bala y
-- una bomba son los tres ultimos parametros (explosión, gravedad y giro), de modo
-- que el pool, el array y la simulacion viven en un solo sitio. La velocidad es
-- absoluta y llega ya calculada: las bombas la construyen con su arco (lob), las
-- balas con dirección * rapidez.
local function launch(
	origin: Vector3,
	velocity: Vector3,
	damage: number,
	lifetime: number,
	owner: Player,
	isCrit: boolean,
	blastRadius: number,
	gravity: number,
	spinRate: number
)
	if not pool or velocity.Magnitude < 0.01 then
		return
	end

	local explosive = blastRadius > 0
	local radius = if explosive then Config.Projectile.BombRadius else Config.Projectile.Radius
	local color = if explosive
		then Color3.fromRGB(255, 164, 68)
		elseif isCrit then Color3.fromRGB(255, 200, 60)
		else Color3.fromRGB(255, 240, 200)

	local acquired, lease = pool:Get(function(instance)
		local part = instance :: Part
		part.Size = Vector3.new(radius * 2, radius * 2, radius * 2)
		part.Color = color
		part.Material = Enum.Material.Neon
		part.Transparency = 0.1
		part.CFrame = CFrame.lookAt(origin, origin + velocity)
		part.Parent = container
		-- El rastro solo pertenece a las bombas: una bala reciclada lo apaga para
		-- no arrastrar el de la bomba anterior.
		ensureBombTrail(part)
		local trail = part:FindFirstChild("BombTrail") :: Trail?
		if trail then
			trail.Enabled = explosive
			trail.Color = ColorSequence.new(color)
		end
	end)

	table.insert(projectiles, {
		Part = acquired :: Part,
		Position = origin,
		Velocity = velocity,
		Damage = damage,
		IsCrit = isCrit,
		Owner = owner,
		Life = math.min(lifetime, Config.Projectile.MaxLifetime),
		BlastRadius = blastRadius,
		Gravity = gravity,
		Spin = 0,
		SpinRate = spinRate,
		Slot = #projectiles + 1,
		Lease = lease,
	})
end

-- Bala simple: un impacto y desaparece.
function Projectiles.spawn(
	origin: Vector3,
	direction: Vector3,
	damage: number,
	speed: number,
	lifetime: number,
	owner: Player,
	isCrit: boolean
)
	local velocity = direction.Unit * math.max(speed, Config.Projectile.SpeedFloor)
	launch(origin, velocity, damage, lifetime, owner, isCrit, 0, 0, 0)
end

-- Bomba: vuela en parábola (el arco ya viene en `velocity`) y detona al tocar el
-- suelo, al tocar un enemigo o al agotar su tiempo de vuelo.
function Projectiles.spawnBomb(
	origin: Vector3,
	velocity: Vector3,
	damage: number,
	lifetime: number,
	owner: Player,
	isCrit: boolean,
	blastRadius: number
)
	launch(
		origin,
		velocity,
		damage,
		lifetime,
		owner,
		isCrit,
		math.max(blastRadius, 1),
		Config.Projectile.Gravity,
		Config.Projectile.BombSpin
	)
end

local function release(index: number)
	local projectile = projectiles[index]
	local slot = projectile.Slot
	local last = projectiles[#projectiles]
	projectiles[slot] = last
	last.Slot = slot
	table.remove(projectiles)
	pool:Release(projectile.Part, projectile.Lease)
end

local function hitAt(position: Vector3): EnemyRegistry.Enemy?
	local best: EnemyRegistry.Enemy? = nil
	local bestDistance = math.huge
	for _, enemy in EnemyRegistry.queryRadius(position, Config.Projectile.Radius * 2) do
		local dx = enemy.Position.X - position.X
		local dz = enemy.Position.Z - position.Z
		local reach = enemy.Definition.Size * 0.5 + Config.Projectile.Radius
		local distance = dx * dx + dz * dz
		if distance <= reach * reach and distance < bestDistance then
			bestDistance = distance
			best = enemy
		end
	end
	return best
end

-- Detonacion: daña a todo lo que haya dentro del radio. Recorrer la tabla de la
-- rejilla mientras se mata es seguro: damage() saca el enemigo de la lista principal,
-- no de esa copia, y un enemigo ya muerto se ignora por su propio Alive.
local function explode(position: Vector3, damage: number, isCrit: boolean, radius: number)
	for _, enemy in EnemyRegistry.queryRadius(position, radius) do
		local dx = enemy.Position.X - position.X
		local dz = enemy.Position.Z - position.Z
		local reach = enemy.Definition.Size * 0.5 + radius
		local distance = dx * dx + dz * dz
		if distance <= reach * reach then
			EnemyRegistry.damage(enemy, damage, isCrit)
		end
	end
	Remotes.CombatEffect:FireAllClients("explosion", position, radius)
end

-- El final del vuelo: una bomba estalla a ras de suelo, una bala simple solo vuelve
-- al pool.
local function detonate(index: number)
	local projectile = projectiles[index]
	if projectile.BlastRadius > 0 then
		local position = Vector3.new(projectile.Position.X, Config.Arena.FloorY, projectile.Position.Z)
		explode(position, projectile.Damage, projectile.IsCrit, projectile.BlastRadius)
	end
	release(index)
end

local function step(index: number, dt: number)
	local projectile = projectiles[index]

	if projectile.Gravity > 0 then
		projectile.Velocity += Vector3.new(0, -projectile.Gravity * dt, 0)
	end

	local travel = projectile.Velocity * dt
	local distance = travel.Magnitude
	local steps = math.clamp(math.ceil(distance / MAX_STEP_DISTANCE), 1, 8)

	for _ = 1, steps do
		projectile.Position += travel / steps
		if projectile.Position.Y <= Config.Arena.FloorY then
			detonate(index)
			return
		end
		local enemy = hitAt(projectile.Position)
		if enemy then
			-- Una bomba no golpea dos veces al impacto: la detonacion ya incluye al
			-- enemigo que ha tocado, asi que solo se cuenta el radio.
			if projectile.BlastRadius > 0 then
				explode(projectile.Position, projectile.Damage, projectile.IsCrit, projectile.BlastRadius)
			else
				EnemyRegistry.damage(enemy, projectile.Damage, projectile.IsCrit)
			end
			release(index)
			return
		end
	end

	projectile.Life -= dt
	if projectile.Life <= 0 then
		detonate(index)
		return
	end

	-- La bomba gira alrededor de su eje de avance: el rollo alrededor de Z local no
	-- mueve los attachments del trail (están en perpendicular), así que el rastro se
	-- queda pegado a la trayectoria mientras la piedra da vueltas.
	if projectile.SpinRate > 0 then
		projectile.Spin += projectile.SpinRate * dt
		local forward = projectile.Velocity.Unit
		-- lookAt no soporta un forward paralelo al up: se desvía un pelo para que
		-- una bomba casi vertical al aterrizar no genere un CFrame NaN.
		if math.abs(forward.Y) > 0.98 then
			forward = Vector3.new(forward.X + 0.01, forward.Y, forward.Z).Unit
		end
		projectile.Part.CFrame = CFrame.lookAt(projectile.Position, projectile.Position + forward)
			* CFrame.Angles(0, 0, projectile.Spin)
	else
		projectile.Part.CFrame = CFrame.new(projectile.Position)
	end
end

function Projectiles.update(dt: number)
	for index = #projectiles, 1, -1 do
		step(index, dt)
	end
end

function Projectiles.clearAll()
	for index = #projectiles, 1, -1 do
		release(index)
	end
end

return Projectiles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">WeaponBehaviors</string>
            <string name="Source"><![CDATA[--!strict
-- Registro de comportamientos de ataque. WeaponRuntime decide cuándo dispara; aquí
-- vive únicamente cómo se ejecuta cada ataque. Añadir un arma con un patrón nuevo
-- es añadir una entrada en este mapa, sin tocar el bucle de armas ni el pool.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Stats = require(script.Parent.Parent.Stats)
local EnemyRegistry = require(script.Parent.Parent.Enemies.EnemyRegistry)
local Projectiles = require(script.Parent.Projectiles)
local OrbitBlades = require(script.Parent.OrbitBlades)

type StatBlock = { [string]: number }

export type Context = {
	player: Player,
	weaponId: string,
	stats: StatBlock,
	origin: Vector3,
	target: Vector3?,
	lookDirection: Vector3,
	now: number,
}

local function rotateY(direction: Vector3, radians: number): Vector3
	local cos, sin = math.cos(radians), math.sin(radians)
	return Vector3.new(
		direction.X * cos - direction.Z * sin,
		direction.Y,
		direction.X * sin + direction.Z * cos
	)
end

local function rollCrit(player: Player, stats: StatBlock, now: number): (number, boolean)
	local playerStats = Stats.get(player, now)
	local chance = playerStats.CriticalChance or 0
	if math.random() >= chance then
		return stats.Damage, false
	end
	return stats.Damage * (playerStats.CriticalDamage or 1.5), true
end

-- Daño a todo lo que quede dentro de un radio, en el suelo. La comparte el pulso y
-- cualquier otra fuente de área.
local function damageArea(
	position: Vector3,
	radius: number,
	damage: number,
	isCrit: boolean,
	effect: string
): number
	local hits = 0
	for _, enemy in EnemyRegistry.queryRadius(position, radius) do
		local dx = enemy.Position.X - position.X
		local dz = enemy.Position.Z - position.Z
		local reach = enemy.Definition.Size * 0.5 + radius
		local distance = dx * dx + dz * dz
		if distance <= reach * reach then
			EnemyRegistry.damage(enemy, damage, isCrit)
			hits += 1
		end
	end
	Remotes.CombatEffect:FireAllClients(effect, position, radius)
	return hits
end

-- Enemigo vivo más cercano alrededor de un punto, saltando los que ya han sido
-- tocados. Cierra la tabla de la rejilla antes de devolver, porque el llamante
-- vuelve a consultarla en el siguiente salto.
local function nearestUntouched(
	position: Vector3,
	radius: number,
	alreadyHit: { [number]: boolean }
): EnemyRegistry.Enemy?
	local best: EnemyRegistry.Enemy? = nil
	local bestDistance = radius * radius
	for _, enemy in EnemyRegistry.queryRadius(position, radius) do
		if not alreadyHit[enemy.Id] then
			local dx = enemy.Position.X - position.X
			local dz = enemy.Position.Z - position.Z
			local distance = dx * dx + dz * dz
			if distance <= bestDistance then
				bestDistance = distance
				best = enemy
			end
		end
	end
	return best
end

-- Dispara uno o varios proyectiles hacia el objetivo. Con más de una bala se
-- reparten en el cono; con una sola, van directa.
local function fireProjectiles(context: Context)
	if not context.target then
		return
	end

	local aim = (context.target - context.origin)
	if aim.Magnitude < 0.01 then
		return
	end
	aim = aim.Unit

	local muzzle = context.origin + Vector3.new(0, 1.4, 0)
	local pellets = math.max(1, math.round(context.stats.Pellets or 1))
	local spread = math.rad(context.stats.Spread or 0)
	local speed = math.max(Config.Projectile.SpeedFloor, context.stats.ProjectileSpeed or 60)
	local range = math.max(4, context.stats.Range or 40)
	local lifetime = range / speed + 0.15

	for index = 0, pellets - 1 do
		local offset = 0
		if pellets > 1 and spread > 0 then
			offset = (index / (pellets - 1) - 0.5) * spread + (math.random() - 0.5) * spread * 0.25
		end
		local direction = rotateY(aim, offset)
		local damage, isCrit = rollCrit(context.player, context.stats, context.now)
		Projectiles.spawn(muzzle, direction, damage, speed, lifetime, context.player, isCrit)
	end
end

-- Onda de daño a tu alrededor. El objetivo solo sirve para decidir si el pulso se
-- dispara: el área es el radio, y se calcula en el suelo.
local function fireNova(context: Context)
	local damage, isCrit = rollCrit(context.player, context.stats, context.now)
	local radius = math.max(2, context.stats.Radius or 8)
	local center = Vector3.new(context.origin.X, Config.Arena.FloorY, context.origin.Z)
	damageArea(center, radius, damage, isCrit, "nova")
end

-- Impacta al más cercano y salta a los siguientes, cada vez con menos daño. El
-- salto se dibuja como un segmento entre el impacto anterior y el nuevo.
local function fireChain(context: Context)
	if not context.target then
		return
	end

	local damage, isCrit = rollCrit(context.player, context.stats, context.now)
	local jumps = math.max(1, math.round(context.stats.ChainCount or 2))
	local jumpRange = math.max(4, context.stats.ChainRange or 18)
	local falloff = math.clamp(context.stats.ChainFalloff or 0.85, 0.1, 1)

	-- El primer salto nace en el arma del jugador con su propio offset Y, no en el
	-- punto apuntado: así el rayo de apertura siempre tiene longitud, y por tanto
	-- siempre se dibuja, aunque el primer objetivo esté justo delante.
	local hitY = Config.Arena.FloorY + 1
	local source = Vector3.new(context.origin.X, hitY, context.origin.Z)

	local alreadyHit: { [number]: boolean } = {}
	local current: EnemyRegistry.Enemy? =
		nearestUntouched(Vector3.new(context.target.X, hitY, context.target.Z), 1, alreadyHit)
	local from = source

	for _ = 1, jumps do
		if not current then
			break
		end
		EnemyRegistry.damage(current, damage, isCrit)
		alreadyHit[current.Id] = true

		local position = Vector3.new(current.Position.X, hitY, current.Position.Z)
		Remotes.CombatEffect:FireAllClients("chain", from, jumpRange, position)

		from = position
		current = nearestUntouched(position, jumpRange, alreadyHit)
		damage *= falloff
	end
end

-- Lanza bombas con un arco real: sube y cae. La detonación y el daño en área los
-- lleva el propio proyectil, no esta función: aquí solo se construye la velocidad
-- de lanzamiento desde el lob deseado.
local function fireBomb(context: Context)
	if not context.target then
		return
	end

	local muzzle = context.origin + Vector3.new(0, 1.4, 0)
	local flat = Vector3.new(context.target.X - muzzle.X, 0, context.target.Z - muzzle.Z)
	local flatDistance = flat.Magnitude
	if flatDistance < 0.2 then
		return
	end
	flat = flat / flatDistance

	local blast = math.max(1, context.stats.BlastRadius or 8)
	local arc = math.clamp(context.stats.Arc or 0.45, 0, 1.5)
	local speed = math.max(Config.Projectile.SpeedFloor, context.stats.ProjectileSpeed or 44)
	local count = math.max(1, math.round(context.stats.ProjectileCount or 1))

	-- La altura pico crece con la distancia al objetivo y con la stat Arc, y la
	-- velocidad vertical sale de la conservación (v² = 2·g·h): la altura es exacta
	-- y no depende del frame ni del giro del mundo.
	local gravity = Config.Projectile.Gravity
	local rise = math.clamp(
		flatDistance * 0.28 + arc * 6,
		Config.Projectile.LobHeightMin,
		Config.Projectile.LobHeightMax
	)
	local verticalSpeed = math.sqrt(2 * gravity * rise)
	local flightTime = 2 * verticalSpeed / gravity
	-- Velocidad horizontal suficiente para alcanzar al objetivo antes de caer.
	local horizontalSpeed = math.max(speed, flatDistance / math.max(flightTime, 0.01) + 1)
	local lifetime = flightTime + 0.5

	for _ = 1, count do
		-- La dispersión solo rota la orientación horizontal: todas las bombas de la
		-- andanada comparten altura y así el arco se sigue leyendo como una sola
		-- parábola.
		local scatter = (math.random() - 0.5) * math.rad(9)
		local scattered = rotateY(flat, scatter)
		local velocity = scattered * horizontalSpeed + Vector3.new(0, verticalSpeed, 0)
		local damage, isCrit = rollCrit(context.player, context.stats, context.now)
		Projectiles.spawnBomb(muzzle, velocity, damage, lifetime, context.player, isCrit, blast)
	end
end

-- Las cuchillas no son un disparo: el comportamiento solo deja el juego de piezas
-- sincronizado con las estadísticas actuales, y el movimiento y el corte por contacto
-- los lleva OrbitBlades en su propio paso del bucle.
local function sustainOrbit(context: Context)
	local damage, isCrit = rollCrit(context.player, context.stats, context.now)
	OrbitBlades.configure(context.player, context.stats, damage, isCrit)
end

return {
	Projectile = fireProjectiles,
	Nova = fireNova,
	Chain = fireChain,
	Bomb = fireBomb,
	Orbit = sustainOrbit,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">WeaponRuntime</string>
            <string name="Source"><![CDATA[--!strict
-- Bucle de armas: un único recorrido por jugador y arma para decidir cuándo dispara.
-- No sabe cómo se ejecuta el ataque (eso es WeaponBehaviors) ni qué rutas de daño
-- existen (eso es EnemyRegistry).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared:WaitForChild("Registry"))
local StatMath = require(Shared:WaitForChild("StatMath"))
local Types = require(Shared:WaitForChild("Types"))
local Run = require(script.Parent.Parent.Run)
local Stats = require(script.Parent.Parent.Stats)
local PlayerAvatar = require(script.Parent.Parent.PlayerAvatar)
local EnemyRegistry = require(script.Parent.Parent.Enemies.EnemyRegistry)
local Behaviors = require(script.Parent.WeaponBehaviors)

type StatBlock = Types.StatBlock
type StatModifier = Types.StatModifier
type Context = Behaviors.Context

local cooldowns: { [Player]: { [string]: number } } = {}

-- Los modificadores de una mejora de arma se vuelven a aplicar una vez por nivel
-- comprado: subir Gun Damage tres veces da tres veces el bonus.
local function upgradeModifiers(player: Player, weaponId: string): { StatModifier }
	local modifiers: { StatModifier } = {}
	local run = Run.get(player)
	for upgradeId, count in run.upgradeLevels do
		local definition = Registry.Upgrades[upgradeId]
		if definition and definition.TargetId == weaponId then
			for _ = 1, count do
				for _, modifier in definition.Modifiers do
					table.insert(modifiers, {
						stat = modifier.stat,
						kind = modifier.kind,
						value = modifier.value,
						source = upgradeId,
					})
				end
			end
		end
	end
	return modifiers
end

local WeaponRuntime = {}

function WeaponRuntime.statsFor(player: Player, weaponId: string): StatBlock
	local definition = Registry.Weapons[weaponId]
	local run = Run.get(player)
	local level = run.weaponLevels[weaponId] or 0
	return StatMath.weapon(definition, level, upgradeModifiers(player, weaponId), Stats.get(player))
end

function WeaponRuntime.reset(player: Player)
	cooldowns[player] = {}
end

local function fire(player: Player, weaponId: string, now: number)
	local root = PlayerAvatar.root(player)
	if not root then
		return
	end

	local definition = Registry.Weapons[weaponId]
	local behavior = Behaviors[definition.Behavior]
	if not behavior then
		return
	end

	local stats = WeaponRuntime.statsFor(player, weaponId)

	-- Regla única de objetivo: un arma que lo necesita no dispara si no hay a nadie a
	-- tiro, y un arma que no lo necesita (cuchillas orbitando) se ahorra la búsqueda.
	local target: Vector3? = nil
	if definition.RequiresTarget ~= false then
		local enemy = EnemyRegistry.closest(root.Position, math.max(4, stats.Range or 40))
		if not enemy then
			return
		end
		target = enemy.Position + Vector3.new(0, 1, 0)
	end

	local context: Context = {
		player = player,
		weaponId = weaponId,
		stats = stats,
		origin = root.Position,
		target = target,
		lookDirection = root.CFrame.LookVector,
		now = now,
	}

	behavior(context)
end

function WeaponRuntime.update(now: number)
	for _, player in PlayerAvatar.alivePlayers() do
		local perWeapon = cooldowns[player]
		if not perWeapon then
			perWeapon = {}
			cooldowns[player] = perWeapon
		end

		local run = Run.get(player)
		for weaponId, level in run.weaponLevels do
			if level > 0 then
				local readyAt = perWeapon[weaponId] or 0
				if now >= readyAt then
					local stats = WeaponRuntime.statsFor(player, weaponId)
					local attackSpeed = math.max(0.1, stats.AttackSpeed or 1)
					perWeapon[weaponId] = now + 1 / attackSpeed
					fire(player, weaponId, now)
				end
			end
		end
	end
end

return WeaponRuntime
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="65">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">MetaData</string>
            <string name="Source"><![CDATA[--!strict
-- Progresión permanente del jugador (meta data). En la Fase 1 esto NO guarda nada:
-- existe para que la frontera entre "lo que dura una partida" (Run) y "lo que se
-- guarda entre partidas" (MetaData) quede marcada desde el principio, y para que
-- añadir persistencia en la Fase 4 no toque los sistemas de gameplay.
--
-- Lo que haría falta cuando se active:
--   - DataStoreService con UpdateAsync (nunca GetAsync + SetAsync).
--   - Bloqueo de sesión para que dos servidores no escriban el mismo perfil.
--   - Guardar en límites de vida (PlayerLeaving, BindToClose), no solo al salir.
--   - Reconciliar contra la plantilla y validar números antes de escribir.
local MetaData = {}

export type Template = {
	Version: number,
	PlayerId: number,
	Currency: number,
	UnlockedCharacters: { string },
	UnlockedWeapons: { string },
	Upgrades: { [string]: number },
	Statistics: {
		Runs: number,
		BestTime: number,
		BestLevel: number,
		TotalKills: number,
	},
}

function MetaData.defaults(playerId: number): Template
	return {
		Version = 1,
		PlayerId = playerId,
		Currency = 0,
		UnlockedCharacters = {},
		UnlockedWeapons = {},
		Upgrades = {},
		Statistics = {
			Runs = 0,
			BestTime = 0,
			BestLevel = 0,
			TotalKills = 0,
		},
	}
end

return MetaData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">Profile</string>
            <string name="Source"><![CDATA[--!strict
-- Progresión permanente del jugador. Frontera Run/Meta: memoria de sesión más una
-- copia persistente en DataStore con reconciliación contra el contenido (solo se
-- aceptan misiones/mapas que existan en `Registry`) y escrituras diferidas con
-- debounce.
--
-- La autoridad sigue siendo del servidor: `RewardSystem`/`UnlockSystem` son los
-- únicos que escriben y ambos corren aquí. Nada de lo leído se cree a ciegas.
--
-- En Studio el DataStore funciona solo con "Studio Access to API Services" activado
-- (Game Settings → Security); si está apagado, este módulo degrada a sesión y avisa.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared:WaitForChild("Registry"))

local STORE_NAME = "MissionProgress"
local STORE_SCOPE = "v1"
local SAVE_DELAY = 4
local MAX_CURRENCY = 10 ^ 9

export type Profile = {
	Currency: number,
	UnlockedMissions: { [string]: boolean },
	UnlockedMaps: { [string]: boolean },
	CompletedMissions: { [string]: boolean },
}

-- Las misiones iniciales se derivan del contenido: una misión que nadie desbloquea
-- está disponible desde el principio. Así añadir contenido no toca este módulo.
local function isUnlockedByMission(missionId: string): boolean
	for _, mission in Registry.Missions do
		for _, unlocked in mission.Rewards.MissionUnlocks do
			if unlocked == missionId then
				return true
			end
		end
	end
	return false
end

local function isUnlockedByMissionReward(mapId: string): boolean
	for _, mission in Registry.Missions do
		for _, unlocked in mission.Rewards.MapUnlocks do
			if unlocked == mapId then
				return true
			end
		end
	end
	return false
end

local STARTING_MISSIONS: { string } = {}
for id in Registry.Missions do
	if not isUnlockedByMission(id) then
		table.insert(STARTING_MISSIONS, id)
	end
end
table.sort(STARTING_MISSIONS)

local STARTING_MAPS: { [string]: boolean } = {}
for _, id in STARTING_MISSIONS do
	STARTING_MAPS[Registry.Missions[id].MapId] = true
end
for id in Registry.Maps do
	if not isUnlockedByMissionReward(id) then
		STARTING_MAPS[id] = true
	end
end

local profiles: { [Player]: Profile } = {}
local loaded: { [Player]: boolean } = {}
local dirty: { [Player]: boolean } = {}
local saveScheduled: { [Player]: boolean } = {}
local loadListeners: { (Player) -> () } = {}
local store: DataStore? = nil

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, problem = pcall(function()
		store = DataStoreService:GetDataStore(STORE_NAME, STORE_SCOPE)
	end)
	if not ok then
		warn(
			`[Profile] DataStore no disponible (¿falta "Studio Access to API Services"?): {problem}. Progreso solo de sesión.`
		)
		store = nil
	end
	return store
end

local function encodedKeys(values: { [string]: boolean }): { string }
	local ids: { string } = {}
	for id in values do
		table.insert(ids, id)
	end
	return ids
end

local function encode(profile: Profile): string
	return HttpService:JSONEncode({
		v = 1,
		currency = profile.Currency,
		missions = encodedKeys(profile.UnlockedMissions),
		maps = encodedKeys(profile.UnlockedMaps),
		completed = encodedKeys(profile.CompletedMissions),
	})
end

local function sanitizeCurrency(value: unknown): number
	local number = tonumber(value)
	if number == nil or number ~= number then
		return 0
	end
	return math.clamp(math.floor(number), 0, MAX_CURRENCY)
end

local function sanitizeIds(raw: unknown, known: { [string]: any }): { [string]: boolean }
	local out: { [string]: boolean } = {}
	if type(raw) ~= "table" then
		return out
	end
	for _, id in raw do
		if type(id) == "string" and known[id] then
			out[id] = true
		end
	end
	return out
end

local Profile = {}

function Profile.get(player: Player): Profile
	local profile = profiles[player]
	if profile then
		return profile
	end
	profile = {
		Currency = 0,
		UnlockedMissions = {},
		UnlockedMaps = {},
		CompletedMissions = {},
	}
	for _, id in STARTING_MISSIONS do
		profile.UnlockedMissions[id] = true
	end
	for id in STARTING_MAPS do
		profile.UnlockedMaps[id] = true
	end
	profiles[player] = profile
	return profile
end

-- Carga asíncrona: se fusiona sobre los defaults de sesión y avisa a los
-- listeners cuando termina (Main.server reenvía la lista de misiones al jugador).
function Profile.load(player: Player)
	task.spawn(function()
		if loaded[player] then
			return
		end
		loaded[player] = true

		local datastore = getStore()
		if not datastore then
			return
		end

		local ok, raw = pcall(function()
			return datastore:GetAsync(tostring(player.UserId))
		end)
		if not ok then
			warn(`[Profile] no se pudo cargar el progreso de {player.Name}: {raw}`)
			return
		end
		if raw == nil then
			return
		end

		local stored: any = raw
		if type(raw) == "string" then
			local decoded, value = pcall(HttpService.JSONDecode, HttpService, raw)
			stored = if decoded then value else nil
		end

		local profile = Profile.get(player)
		if type(stored) == "table" then
			local currency = sanitizeCurrency(stored.currency)
			if currency > 0 then
				profile.Currency = currency
			end
			local missions = sanitizeIds(stored.missions, Registry.Missions)
			for id in missions do
				profile.UnlockedMissions[id] = true
			end
			local maps = sanitizeIds(stored.maps, Registry.Maps)
			for id in maps do
				profile.UnlockedMaps[id] = true
			end
			local completed = sanitizeIds(stored.completed, Registry.Missions)
			for id in completed do
				profile.CompletedMissions[id] = true
			end
		end

		for _, listener in loadListeners do
			listener(player)
		end
	end)
end

function Profile.save(player: Player)
	if not dirty[player] then
		return
	end
	dirty[player] = nil
	saveScheduled[player] = nil

	local profile = profiles[player]
	if not profile then
		return
	end

	local datastore = getStore()
	if not datastore then
		return
	end

	local profileData = profile
	local ok, problem = pcall(function()
		datastore:SetAsync(tostring(player.UserId), encode(profileData))
	end)
	if not ok then
		warn(`[Profile] no se pudo guardar el progreso de {player.Name}: {problem}`)
	end
end

-- Marca el perfil como pendiente de guardar y programa una escritura diferida.
function Profile.markDirty(player: Player)
	dirty[player] = true
	if saveScheduled[player] then
		return
	end
	saveScheduled[player] = true
	task.delay(SAVE_DELAY, function()
		saveScheduled[player] = nil
		Profile.save(player)
	end)
end

function Profile.onLoaded(listener: (Player) -> ()): () -> ()
	table.insert(loadListeners, listener)
	return function()
		table.remove(loadListeners, table.find(loadListeners, listener))
	end
end

-- Guarda antes de soltar la memoria: al salir el perfil sigue siendo del jugador
-- y el servidor todavía puede escribir.
function Profile.release(player: Player)
	Profile.save(player)
	profiles[player] = nil
	loaded[player] = nil
	dirty[player] = nil
	saveScheduled[player] = nil
end

function Profile.isMissionUnlocked(player: Player, missionId: string): boolean
	return Profile.get(player).UnlockedMissions[missionId] == true
end

function Profile.isMissionCompleted(player: Player, missionId: string): boolean
	return Profile.get(player).CompletedMissions[missionId] == true
end

-- Devuelve true solo la primera vez: permite informar al cliente de un desbloqueo
-- real sin duplicar el aviso en reintentos.
function Profile.unlockMission(player: Player, missionId: string): boolean
	local profile = Profile.get(player)
	if profile.UnlockedMissions[missionId] then
		return false
	end
	profile.UnlockedMissions[missionId] = true
	Profile.markDirty(player)
	return true
end

function Profile.unlockMap(player: Player, mapId: string): boolean
	local profile = Profile.get(player)
	if profile.UnlockedMaps[mapId] then
		return false
	end
	profile.UnlockedMaps[mapId] = true
	Profile.markDirty(player)
	return true
end

function Profile.completeMission(player: Player, missionId: string): boolean
	local profile = Profile.get(player)
	if profile.CompletedMissions[missionId] then
		return false
	end
	profile.CompletedMissions[missionId] = true
	Profile.markDirty(player)
	return true
end

function Profile.addCurrency(player: Player, amount: number): number
	if amount <= 0 then
		return 0
	end
	local profile = Profile.get(player)
	profile.Currency = math.min(MAX_CURRENCY, profile.Currency + amount)
	Profile.markDirty(player)
	return amount
end

-- Red de seguridad al cerrar el servidor: vuelca lo pendiente aunque nadie haya
-- pasado por PlayerRemoving. Mejor esfuerzo: dentro de BindToClose las escrituras
-- pueden fallar y se ignoran.
game:BindToClose(function()
	local datastore = getStore()
	if not datastore then
		return
	end
	for player in profiles do
		if dirty[player] then
			local profile = profiles[player]
			pcall(function()
				datastore:SetAsync(tostring(player.UserId), encode(profile))
			end)
		end
	end
end)

return Profile
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="68">
        <Properties>
          <string name="Name">Enemies</string>
        </Properties>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">EnemyAI</string>
            <string name="Source"><![CDATA[--!strict
-- Comportamiento de los enemigos. Un solo bucle para todos ellos, con un cursor
-- giratorio que refresca objetivos por tandas: así el coste no crece de golpe con
-- cientos de enemigos ni aparece un pico en un solo frame.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Stats = require(script.Parent.Parent.Stats)
local PlayerAvatar = require(script.Parent.Parent.PlayerAvatar)
local EnemyRegistry = require(script.Parent.EnemyRegistry)

type Enemy = EnemyRegistry.Enemy

local SEPARATION_WEIGHT = 1.6
local TARGETS_PER_SLICE = 8

local cursor = 0
local targets: { { player: Player, position: Vector3 } } = {}

local function collectTargets()
	table.clear(targets)
	for _, player in PlayerAvatar.alivePlayers() do
		local root = PlayerAvatar.root(player)
		if root then
			table.insert(targets, { player = player, position = root.Position })
		end
	end
end

local function nearestTarget(position: Vector3): Player?
	local best: Player? = nil
	local bestDistance = math.huge
	for _, target in targets do
		local dx = target.position.X - position.X
		local dz = target.position.Z - position.Z
		local distance = dx * dx + dz * dz
		if distance < bestDistance then
			bestDistance = distance
			best = target.player
		end
	end
	return best
end

local function isValidTarget(player: Player?): boolean
	if not player then
		return false
	end
	for _, target in targets do
		if target.player == player then
			return true
		end
	end
	return false
end

local function refreshTargets()
	local enemies = EnemyRegistry.all()
	if #enemies == 0 then
		cursor = 0
		return
	end
	local slice = math.min(#enemies, TARGETS_PER_SLICE)
	for _ = 1, slice do
		cursor = cursor % #enemies + 1
		local enemy = enemies[cursor]
		enemy.Target = nearestTarget(enemy.Position)
	end
end

local function moveEnemies(dt: number)
	local enemies = EnemyRegistry.all()
	local half = Config.Arena.HalfExtent
	local floorY = Config.Arena.FloorY

	for index = #enemies, 1, -1 do
		local enemy = enemies[index]
		local target = enemy.Target
		if not isValidTarget(target) then
			target = nil
		end

		local steer = Vector3.zero
		if target then
			for _, entry in targets do
				if entry.player == target then
					local dx = entry.position.X - enemy.Position.X
					local dz = entry.position.Z - enemy.Position.Z
					local distance = math.sqrt(dx * dx + dz * dz)
					if distance > 0.01 then
						steer = Vector3.new(dx / distance, 0, dz / distance)
					end
					break
				end
			end
		end

		-- Separación: evita que la horda se apile en un solo punto y que el jugador
		-- solo pueda golpear a un enemigo a la vez.
		local separation = Vector3.zero
		local size = enemy.Definition.Size
		for _, other in EnemyRegistry.queryRadius(enemy.Position, size * 2) do
			if other ~= enemy then
				local dx = enemy.Position.X - other.Position.X
				local dz = enemy.Position.Z - other.Position.Z
				local distance = math.sqrt(dx * dx + dz * dz)
				local minimum = size * 0.5 + other.Definition.Size * 0.5
				if distance < minimum and distance > 0.001 then
					local push = (minimum - distance) / minimum
					separation += Vector3.new(dx / distance, 0, dz / distance) * push
				end
			end
		end

		local direction = steer + separation * SEPARATION_WEIGHT
		local magnitude = direction.Magnitude
		if magnitude > 1 then
			direction /= magnitude
		end

		local next = enemy.Position + direction * enemy.Speed * dt
		next = Vector3.new(math.clamp(next.X, -half, half), floorY, math.clamp(next.Z, -half, half))

		enemy.Position = next
		-- Sin dirección (recién spawneado y sin vecinos) no hay hacia dónde mirar:
		-- CFrame.lookAt exige dos puntos distintos, así que en ese frame no se rota.
		if direction.Magnitude > 0.001 then
			enemy.Root.CFrame =
				CFrame.lookAt(next + Vector3.new(0, 1, 0), next + direction + Vector3.new(0, 1, 0))
		end
		if enemy.IsAsset then
			-- El asset no tiene un "Body" que mover; el modelo completo se coloca por su
			-- PrimaryPart. El Root sirve solo para la rejilla espacial.
			enemy.Model:PivotTo(CFrame.new(next + Vector3.new(0, size * 0.5, 0)))
		else
			enemy.Body.CFrame = CFrame.new(next + Vector3.new(0, size * 0.5, 0))
		end
	end
end

local function attackPlayers(now: number)
	local enemies = EnemyRegistry.all()
	for _, enemy in enemies do
		local target = enemy.Target
		if target and now >= enemy.NextAttackAt then
			for _, entry in targets do
				if entry.player == target then
					local dx = entry.position.X - enemy.Position.X
					local dz = entry.position.Z - enemy.Position.Z
					if dx * dx + dz * dz <= enemy.AttackRange * enemy.AttackRange then
						local stats = Stats.get(target, now)
						local applied = PlayerAvatar.damage(target, stats, enemy.Damage)
						enemy.NextAttackAt = now + enemy.AttackInterval
						if applied > 0 then
							Remotes.CombatEffect:FireAllClients("playerHurt", entry.position, 1)
						end
					end
					break
				end
			end
		end
	end
end

local EnemyAI = {}

function EnemyAI.update(dt: number, now: number)
	collectTargets()
	if #targets == 0 then
		return
	end
	refreshTargets()
	moveEnemies(dt)
	attackPlayers(now)
end

return EnemyAI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">EnemyRegistry</string>
            <string name="Source"><![CDATA[--!strict
-- Dueño de los enemigos: instanciación pooled, vida, muerte y recompensa.
-- No decide comportamiento (eso es EnemyAI) ni dificultad (eso es Difficulty).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Registry = require(Shared:WaitForChild("Registry"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local GameAssets = require(Shared:WaitForChild("GameAssets"))
local Pool = require(script.Parent.Parent.Utility.Pool)
local Grid = require(script.Parent.SpatialGrid)
local XPPickups = require(script.Parent.Parent.Pickups.XPPickups)
local ProceduralEnemies = require(script.Parent.ProceduralEnemies)

type EnemyDefinition = Types.EnemyDefinition

export type Enemy = {
	Id: number,
	Slot: number,
	Definition: EnemyDefinition,
	Model: Model,
	Root: BasePart,
	Body: BasePart,
	Health: number,
	MaxHealth: number,
	Speed: number,
	Damage: number,
	AttackInterval: number,
	AttackRange: number,
	Position: Vector3,
	NextAttackAt: number,
	-- Instante en el que este enemigo vuelve a ser vulnerable a contacto. Lo usan las
	-- armas que cortan por contacto (cuchillas orbitando) para no golpear cada frame.
	HitLockUntil: number,
	Alive: boolean,
	-- El visual de este enemigo no es la esfera de reserva, sino un modelo cargado de
	-- Creator Store. IsAsset reemplaza al Body en la colocación física.
	IsAsset: boolean,
	Target: Player?,
	Lease: any,
}

export type Scaling = {
	health: number,
	speed: number,
	damage: number,
}

local container: Folder = nil
local pool: Pool.Pooled = nil
local grid: Grid.Grid = nil
local enemies: { Enemy } = {}
local nextId = 0

-- Evento de muerte. Es el único punto por el que el sistema de misiones (y cualquier
-- objetivo) se entera de una baja sin conocer el combate: solo recibe la definición
-- del enemigo, que es dato, no lógica.
export type KillListener = (enemy: Enemy) -> ()
local killListeners: { KillListener } = {}

local BasicDefinition: Types.EnemyDefinition? = nil
pcall(function()
	BasicDefinition = Registry.Enemies["basic"]
end)

-- Proxy seguro: si el archivo de definición no existe devuelve un definition de basic.
local function DefinitionBasicProxy(): Types.EnemyDefinition
	if BasicDefinition then
		return BasicDefinition
	end
	return {
		Id = "basic",
		Name = "Crawler",
		Health = 34,
		Speed = 10.5,
		Damage = 6,
		AttackInterval = 1,
		AttackRange = 3.4,
		XPReward = 4,
		Size = 2.6,
		AttackType = "Contact",
		Tags = { "melee" },
	}
end

local function buildTemplate(): Model
	-- Plantilla por defecto: se basa en el id del enemigo si está definido, y si no
	-- en una esfera de tamaño medio y rojo oscuro.
	return ProceduralEnemies.make(DefinitionBasicProxy())
end

-- Prepara el modelo que vive en Shared/Assets para este tipo de enemigo. El nombre
-- del asset debe coincidir con el id de la definición: basic → "basic.rbx", tank →
-- "tank.rbx", etc. Si no existe ese nombre, se devuelve nile y se usa la esfera de
-- reserva sin tocar nada.
local function buildAssetTemplate(assetName: string): Model?
	local part = GameAssets.findPart(assetName)
	if not part then
		return nil
	end

	local model = Instance.new("Model")
	model.Name = "Enemy"

	local body = part:Clone()
	body.Name = "Body"
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.CanTouch = false
	body.Massless = true
	body.Parent = model

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(2, 2, 2)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Massless = true
	root.Parent = model

	model.PrimaryPart = root
	return model
end

local EnemyRegistry = {}

function EnemyRegistry.onKilled(listener: KillListener): () -> ()
	table.insert(killListeners, listener)
	return function()
		local index = table.find(killListeners, listener)
		if index then
			table.remove(killListeners, index)
		end
	end
end

function EnemyRegistry.init()
	if container then
		return
	end
	container = Instance.new("Folder")
	container.Name = "Enemies"
	container.Parent = workspace
	pool = Pool.new(buildTemplate(), 48)
	grid = Grid.new(8)
end

-- Versión de pool para los enemigos que llevan asset: se crea perezoso y sigue
-- existiendo todo lo que dure la sesión.
local poolForByDef: { [string]: Pool.Pooled } = {}

local function poolFor(definitionId: string): Pool.Pooled
	if poolForByDef[definitionId] then
		return poolForByDef[definitionId]
	end
	local template = buildAssetTemplate(definitionId)
	if not template then
		return pool
	end
	local cached = Pool.new(template, 12)
	poolForByDef[definitionId] = cached
	return cached
end

function EnemyRegistry.count(): number
	return #enemies
end

function EnemyRegistry.all(): { Enemy }
	return enemies
end

-- El índice espacial se reconstruye una vez por frame, después de que la IA haya
-- movido a los enemigos.
function EnemyRegistry.rebuildGrid()
	grid:clear()
	for _, enemy in enemies do
		grid:insert(enemy, enemy.Position)
	end
end

function EnemyRegistry.queryRadius(position: Vector3, radius: number): { Enemy }
	return grid:queryRadius(position, radius)
end

-- Enemigo vivo más cercano dentro del rango. Consume el scratch del grid, así que
-- el resultado no debe guardarse.
function EnemyRegistry.closest(position: Vector3, maxDistance: number): Enemy?
	local best: Enemy? = nil
	local bestDistance = maxDistance * maxDistance
	for _, enemy in grid:queryRadius(position, maxDistance) do
		local dx = enemy.Position.X - position.X
		local dz = enemy.Position.Z - position.Z
		local distance = dx * dx + dz * dz
		if distance <= bestDistance then
			bestDistance = distance
			best = enemy
		end
	end
	return best
end

function EnemyRegistry.spawn(definitionId: string, position: Vector3, scaling: Scaling): Enemy?
	local definition = Registry.Enemies[definitionId]
	if not definition or not pool then
		return nil
	end

	local half = Config.Arena.HalfExtent
	local clamped = Vector3.new(
		math.clamp(position.X, -half, half),
		Config.Arena.FloorY,
		math.clamp(position.Z, -half, half)
	)

	local visuals = Config.EnemyVisuals[definitionId] or {}
	local size = definition.Size
	local health = definition.Health * scaling.health
	local assetPool = poolFor(definitionId)
	local useAsset = assetPool ~= pool

	local acquired, lease = assetPool:Get(function(instance)
		local model = instance :: Model
		model.Name = `Enemy_{definitionId}`
		if useAsset then
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					part.Anchored = true
					part.CanCollide = false
					part.CanQuery = false
					part.CanTouch = false
					part.Massless = true
				end
			end
			model:PivotTo(CFrame.new(clamped + Vector3.new(0, visuals.OffsetY or size, 0)))
		else
			local body = model.Body :: BasePart
			body.Size = Vector3.new(size, size, size)
			body.Color = visuals.Color or Color3.fromRGB(200, 200, 200)
			body.CFrame = CFrame.new(clamped + Vector3.new(0, visuals.OffsetY or size * 0.5, 0))
		end
		if not useAsset then
			local root = model.Root :: BasePart
			root.Size = Vector3.new(2, 2, 2)
			root.CFrame = CFrame.new(clamped + Vector3.new(0, 1, 0))
		end
		model.Parent = container
	end)

	local model = acquired :: Model
	local root = model.Root :: BasePart
	local body: BasePart = if useAsset then model.PrimaryPart else model.Body :: BasePart

	nextId += 1
	local enemy: Enemy = {
		Id = nextId,
		Slot = 0,
		Definition = definition,
		Model = model,
		Root = root,
		Body = body,
		Health = health,
		MaxHealth = health,
		Speed = definition.Speed * scaling.speed,
		Damage = definition.Damage * scaling.damage,
		AttackInterval = definition.AttackInterval,
		AttackRange = definition.AttackRange,
		Position = clamped,
		NextAttackAt = 0,
		HitLockUntil = 0,
		Alive = true,
		IsAsset = useAsset,
		Target = nil,
		Lease = lease,
	}

	table.insert(enemies, enemy)
	enemy.Slot = #enemies
	return enemy
end

-- Único punto por el que un enemigo pierde vida. La muerte suelta la recompensa y
-- devuelve el modelo al pool.
function EnemyRegistry.damage(enemy: Enemy, amount: number, isCrit: boolean?): boolean
	if not enemy.Alive or amount <= 0 then
		return false
	end

	enemy.Health -= amount
	local center = enemy.Position + Vector3.new(0, 1, 0)
	Remotes.CombatEffect:FireAllClients("hit", center, if isCrit then 2 else 1)

	-- Flash de daño: cambia el color del cuerpo a blanco y lo restaura en unos
	-- frames. Si no hay fire al recibir hit, no hay confirmación visual de daño.
	local bodyColor = enemy.Body.Color
	enemy.Body.Color = Color3.fromRGB(255, 255, 255)
	task.delay(0.08, function()
		if enemy.Body then
			enemy.Body.Color = bodyColor
		end
	end)

	if enemy.Health > 0 then
		return false
	end

	enemy.Alive = false
	Remotes.CombatEffect:FireAllClients("death", center, 1)

	-- Avisa antes de devolver el modelo al pool: los listeners solo leen la
	-- definición y el estado del enemigo, no lo retienen.
	for _, listener in killListeners do
		listener(enemy)
	end

	local slot = enemy.Slot
	local last = enemies[#enemies]
	enemies[slot] = last
	last.Slot = slot
	table.remove(enemies)
	if enemy.IsAsset then
		poolFor(enemy.Definition.Id):Release(enemy.Model, enemy.Lease)
	else
		pool:Release(enemy.Model, enemy.Lease)
	end
	XPPickups.spawn(enemy.Position, enemy.Definition.XPReward)
	return true
end

function EnemyRegistry.clearAll()
	for index = #enemies, 1, -1 do
		local enemy = enemies[index]
		enemy.Alive = false
		if enemy.IsAsset then
			poolFor(enemy.Definition.Id):Release(enemy.Model, enemy.Lease)
		else
			pool:Release(enemy.Model, enemy.Lease)
		end
		table.remove(enemies, index)
	end
end

return EnemyRegistry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">ProceduralEnemies</string>
            <string name="Source"><![CDATA[--!strict
-- Plantilla de enemigos procedurales: no dependen de 107ignore o de un asset del
-- store. El servidor clona el resultado como modelo visual básico.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

type EnemyDefinition = Types.EnemyDefinition

local P = {}

-- Fabricacion de un enemy mínimo: Root invisible + Body con el tamaño/color del
-- definition. Sirve para cualquier clase de enemigo y se adapta a su Config.
function P.makeBasicBody(definition: EnemyDefinition, color: Color3): Model
	local model = Instance.new("Model")
	model.Name = `Enemy_{definition.Id}`

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1.6, 1.6, 1.6)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Massless = true
	root.Parent = model

	local size = definition.Size
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Shape = Enum.PartType.Ball
	body.Size = Vector3.new(size, size, size)
	body.Color = color
	body.Material = Enum.Material.Neon
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.CanTouch = false
	body.Massless = true
	body.Parent = model

	model.PrimaryPart = root
	return model
end

-- Mezcla de formas según el id para que (por ahora) cada enemigo se vea diferente
-- sin assets externos.
function P.make(definition: EnemyDefinition): Model
	local visuals = Config.EnemyVisuals[definition.Id] or {}
	local color = visuals.Color or Color3.fromRGB(214, 79, 79)
	return P.makeBasicBody(definition, color)
end

return P
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">SpatialGrid</string>
            <string name="Source"><![CDATA[--!strict
-- Hash espacial por celdas. Evita el O(n^2) de "cada enemigo contra cada enemigo"
-- en separación, impactos y selección de objetivo. Solo guarda entradas: la
-- posición vive en el propio enemigo y se escribe una vez por frame.
local Grid = {}
Grid.__index = Grid

export type Grid = typeof(setmetatable(
	{} :: {
		cellSize: number,
		buckets: { [string]: { any } },
		scratch: { any },
	},
	Grid
))

function Grid.new(cellSize: number): Grid
	return setmetatable({ cellSize = cellSize, buckets = {}, scratch = {} }, Grid)
end

function Grid:clear()
	table.clear(self.buckets)
end

-- Clave numérica de celda: una multiplicación en vez de una cadena por celda evita
-- reservar memoria en el hot path. Solo es inyectiva si el rango de celdas cabe en
-- 4096 columnas, cosa que cumple la arena; si el mapa creciera habría que revisar
-- el factor.
local function cellIndex(grid: Grid, position: Vector3): number
	return math.floor(position.X / grid.cellSize) + math.floor(position.Z / grid.cellSize) * 4096
end

function Grid:insert(entry: any, position: Vector3)
	local key = cellIndex(self, position)
	local bucket = self.buckets[key]
	if not bucket then
		bucket = {}
		self.buckets[key] = bucket
	end
	table.insert(bucket, entry)
end

-- Recorre solo las celdas que tocan el círculo de consulta. Devuelve la tabla
-- interna para no asignar en el hot path; el llamante no debe conservarla.
function Grid:queryRadius(position: Vector3, radius: number): { any }
	local results = self.scratch
	table.clear(results)

	local size = self.cellSize
	local minX = math.floor((position.X - radius) / size)
	local maxX = math.floor((position.X + radius) / size)
	local minZ = math.floor((position.Z - radius) / size)
	local maxZ = math.floor((position.Z + radius) / size)

	for cx = minX, maxX do
		for cz = minZ, maxZ do
			local bucket = self.buckets[cx + cz * 4096]
			if bucket then
				for _, entry in bucket do
					table.insert(results, entry)
				end
			end
		end
	end

	return results
end

return Grid
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="73">
        <Properties>
          <string name="Name">GameLoop</string>
          <string name="Source"><![CDATA[--!strict
-- Un solo Heartbeat para todo el servidor, con el orden explícito de los sistemas.
-- Así nadie más abre una conexión por frame y el coste por enemigo está medible.
local RunService = game:GetService("RunService")
local Match = require(script.Parent.Match)
local EnemyRegistry = require(script.Parent.Enemies.EnemyRegistry)
local EnemyAI = require(script.Parent.Enemies.EnemyAI)
local EnemySpawner = require(script.Parent.Spawning.EnemySpawner)
local Projectiles = require(script.Parent.Combat.Projectiles)
local OrbitBlades = require(script.Parent.Combat.OrbitBlades)
local WeaponRuntime = require(script.Parent.Combat.WeaponRuntime)
local XPPickups = require(script.Parent.Pickups.XPPickups)
local MissionManager = require(script.Parent.Missions.MissionManager)

-- Tras un tirón largo, un dt enorme teletransportaría enemigos y proyectiles.
local MAX_STEP = 0.1

local connection: RBXScriptConnection? = nil

local GameLoop = {}

function GameLoop.start()
	if connection then
		return
	end

	connection = RunService.Heartbeat:Connect(function(rawDt)
		local dt = math.min(rawDt, MAX_STEP)
		local now = os.clock()

		-- El reloj de partida va primero: si el estado cambia, el resto de sistemas ya
		-- ven el estado nuevo en este mismo frame.
		Match.update(dt, now)

		if not Match.isSimulating() then
			return
		end

		EnemyAI.update(dt, now)
		EnemyRegistry.rebuildGrid()
		Projectiles.update(dt)
		XPPickups.update(dt)
		-- Las cuchillas se mueven y cortan despues de mover a los enemigos, para que el
		-- corte use la posicion de este frame y no la del anterior.
		OrbitBlades.update(dt, now)
		WeaponRuntime.update(now)
		EnemySpawner.update(now, Match.getElapsed())
		-- La misión se evalúa al final del frame: los eventos de muerte de este frame
		-- ya han llegado a sus objetivos, así que una baja no se pierde hasta el
		-- siguiente. `Match` no conoce a `MissionManager`; los une este bucle.
		MissionManager.update(dt, now)
	end)
end

function GameLoop.stop()
	if connection then
		connection:Disconnect()
		connection = nil
	end
end

return GameLoop
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="74">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Arranque del servidor. Aquí se cablean las piezas en un orden explícito y se
-- instala la una y única conexión de red entrante: nada más en el servidor escucha
-- peticiones del cliente.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Stats = require(script.Parent.Stats)
local PlayerAvatar = require(script.Parent.PlayerAvatar)
local Match = require(script.Parent.Match)
local GameLoop = require(script.Parent.GameLoop)
local EnemyRegistry = require(script.Parent.Enemies.EnemyRegistry)
local XPPickups = require(script.Parent.Pickups.XPPickups)
local Projectiles = require(script.Parent.Combat.Projectiles)
local OrbitBlades = require(script.Parent.Combat.OrbitBlades)
local Admin = require(script.Parent.Admin)
local Profile = require(script.Parent.Data.Profile)
local MissionManager = require(script.Parent.Missions.MissionManager)

-- Pools y carpetas de mundo antes de que nada pueda instanciar.
EnemyRegistry.init()
XPPickups.init()
Projectiles.init()
OrbitBlades.init()
Admin.init()

-- El propietario de la partida decide qué significa recoger XP. Inyectarlo aquí
-- mantiene la dirección de dependencias en un solo sentido.
XPPickups.onCollect(Match.grantXp)

Remotes.RequestUpgrade.OnServerEvent:Connect(function(player: Player, upgradeId: unknown)
	local ok, reason = Match.handleUpgradeRequest(player, upgradeId)
	if not ok then
		warn(`[Server] elección rechazada de {player.Name}: {reason}`)
	end
end)

-- Petición de misión. El servidor valida existencia, desbloqueo y estado de partida;
-- el cliente nunca cambia de estado por su cuenta.
Remotes.RequestMission.OnServerEvent:Connect(function(player: Player, missionId: unknown)
	local ok, reason = MissionManager.requestStart(player, missionId)
	if not ok then
		warn(`[Server] misión rechazada de {player.Name}: {reason}`)
	end
end)

-- La misión observa las transiciones de `Match` sin que `Match` la conozca: reacciona
-- al fallo y suelta la ejecución al volver al lobby.
Match.onStateChanged(function(state)
	MissionManager.onMatchState(state)
	if state == "MissionSelect" then
		MissionManager.broadcastList()
		MissionManager.broadcastUpdate()
	end
end)

-- Cuando el progreso (DataStore) termina de cargar, la lista de misiones se reenvía:
-- el estado que se pintó al entrar (todo bloqueado) puede no ser el real.
Profile.onLoaded(function(player)
	MissionManager.sendList(player)
	MissionManager.sendUpdate(player)
end)

-- El servidor no emite nada por evento hasta que el cliente confirma que ya tiene
-- sus listeners registrados: asi una carta de nivel que llega durante el arranque no
-- se pierde.
Remotes.ClientReady.OnServerEvent:Connect(function(player: Player)
	Match.sendTo(player)
	MissionManager.sendList(player)
	MissionManager.sendUpdate(player)
end)

-- Carga el personaje de un jugador que no está vivo (el auto-respawn está apagado).
local function ensureCharacter(player: Player, now: number)
	if PlayerAvatar.isAlive(player) then
		return
	end
	task.spawn(function()
		local ok, problem = pcall(player.LoadCharacterAsync, player)
		if not ok then
			warn(`[Server] no se pudo cargar el personaje de {player.Name}: {problem}`)
			return
		end
		PlayerAvatar.applyStats(player, Stats.get(player, now))
	end)
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	PlayerAvatar.applyStats(player, Stats.get(player))

	humanoid.Died:Once(function()
		Match.onPlayerDied(player)
	end)
end

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		onCharacterAdded(player, player.Character)
	end

	-- Lobby jugable: el primer jugador mete la partida en selección de misión (y
	-- recarga personajes); los que entran después se unen al estado existente. Solo
	-- el servidor decide el estado; el cliente pide empezar una misión.
	if Match.getState() == "Lobby" then
		Match.returnToSelect(os.clock())
	else
		ensureCharacter(player, os.clock())
	end
	Profile.load(player)
	MissionManager.sendList(player)
	MissionManager.sendUpdate(player)
end

-- La partida es dueña del ciclo de vida del personaje: con el auto-respawn de Roblox
-- apagado, un jugador que cae vuelve a entrar por Match y no por el motor. Es una
-- propiedad del servicio Players, no del jugador, asi que se fija una sola vez aqui.
Players.CharacterAutoLoads = false

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player)
	Match.releasePlayer(player)
	Profile.release(player)
end)

GameLoop.start()

-- Cubre a quien ya estaba conectado antes de que este script cargara.
for _, player in Players:GetPlayers() do
	onPlayerAdded(player)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="75">
        <Properties>
          <string name="Name">Match</string>
          <string name="Source"><![CDATA[--!strict
-- Propietario del flujo de una partida: estado, reloj, subida de nivel y limpieza.
--
-- Es el módulo de más arriba del servidor. Ningún otro cambia el estado de la
-- partida: el bucle pregunta si se está simulando, el spawner pregunta por el tiempo
-- transcurrido y el HUD recibe el snapshot desde aquí.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Registry = require(Shared:WaitForChild("Registry"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Run = require(script.Parent.Run)
local Stats = require(script.Parent.Stats)
local PlayerAvatar = require(script.Parent.PlayerAvatar)
local EnemyRegistry = require(script.Parent.Enemies.EnemyRegistry)
local EnemySpawner = require(script.Parent.Spawning.EnemySpawner)
local WeaponRuntime = require(script.Parent.Combat.WeaponRuntime)
local Projectiles = require(script.Parent.Combat.Projectiles)
local OrbitBlades = require(script.Parent.Combat.OrbitBlades)
local XPPickups = require(script.Parent.Pickups.XPPickups)
local LevelUp = require(script.Parent.Progression.LevelUp)

type MatchState = Types.MatchState
type RunSnapshot = Types.RunSnapshot

local Match = {}

local OFFER_COUNT = 3
local SNAPSHOT_INTERVAL = 0.2
local CHOICE_COOLDOWN = 0.2

local state: MatchState = "Lobby"
local elapsed = 0
local snapshotClock = 0
local levelUpClock = 0
local resultsEndsAt = 0
local lastChoiceAt: { [Player]: number } = {}
-- En la Fase 1 sobrevivir `TargetDuration` daba la victoria. Con misiones, quien
-- decide el final es el MissionManager; este interruptor preserva el comportamiento
-- antiguo cuando no hay misión activa (lobby/solo).
local autoVictory = true
local stateListeners: { (MatchState) -> () } = {}

-- "Event", "Boss" y "Victory" están reservados: añadir un evento de partida no
-- requiere tocar el HUD ni los clientes.
local SIMULATED: { [MatchState]: boolean } = {
	Lobby = false,
	Starting = false,
	Playing = true,
	LevelUp = false,
	Event = true,
	Boss = true,
	MissionSelect = false,
	Victory = false,
	Defeat = false,
}

function Match.getState(): MatchState
	return state
end

function Match.getElapsed(): number
	return elapsed
end

function Match.isSimulating(): boolean
	return SIMULATED[state] == true
end

function Match.setState(next: MatchState)
	if state == next then
		return
	end
	state = next
	for _, listener in stateListeners do
		listener(next)
	end
	Match.broadcast()
end

-- Observadores de transición (p. ej. MissionManager). Devuelve una función para
-- darse de baja. `Match` no conoce a sus observadores: solo avisa.
function Match.onStateChanged(listener: (MatchState) -> ()): () -> ()
	table.insert(stateListeners, listener)
	return function()
		local index = table.find(stateListeners, listener)
		if index then
			table.remove(stateListeners, index)
		end
	end
end

function Match.setAutoVictory(enabled: boolean)
	autoVictory = enabled
end

-- Dev (playtest): adelanta el reloj de partida sin tocar el estado. El spawner y
-- las misiones ven el nuevo `elapsed` al instante (más presión, boss antes).
function Match.advanceTime(seconds: number)
	elapsed += seconds
	Match.broadcast()
end

local function clearWorld()
	EnemyRegistry.clearAll()
	Projectiles.clearAll()
	OrbitBlades.clearAll()
	XPPickups.clearAll()
end

local function snapshotFor(player: Player, now: number): RunSnapshot
	local run = Run.get(player)
	local stats = Stats.get(player, now)
	local humanoid = PlayerAvatar.humanoid(player)

	local weapons: { Types.WeaponView } = {}
	for weaponId, level in run.weaponLevels do
		local definition = Registry.Weapons[weaponId]
		if definition then
			table.insert(weapons, {
				Id = weaponId,
				Name = definition.Name,
				Icon = definition.Icon,
				Level = level,
				MaxLevel = definition.MaxLevel,
			})
		end
	end
	table.sort(weapons, function(a, b)
		return a.Id < b.Id
	end)

	local upgradeIds: { string } = {}
	for upgradeId, level in run.upgradeLevels do
		if level > 0 then
			table.insert(upgradeIds, upgradeId)
		end
	end
	table.sort(upgradeIds)

	local passives: { Types.PassiveView } = {}
	for _, upgradeId in upgradeIds do
		local definition = Registry.Upgrades[upgradeId]
		if definition then
			table.insert(passives, {
				Id = upgradeId,
				Name = definition.Name,
				Icon = definition.Icon,
				Level = run.upgradeLevels[upgradeId],
				MaxLevel = definition.MaxLevel,
			})
		end
	end

	return {
		State = state,
		Elapsed = elapsed,
		Health = if humanoid then humanoid.Health else 0,
		MaxHealth = stats.MaxHealth or 100,
		Level = run.level,
		XP = run.xp,
		XPToNext = Run.xpToNext(player),
		Weapons = weapons,
		Passives = passives,
		Buffs = Stats.buffTimers(player, now),
		MoveSpeed = stats.MoveSpeed or 16,
		PickupRadius = stats.PickupRadius or 0,
	}
end

function Match.pushSnapshot(player: Player)
	Remotes.RunSnapshot:FireClient(player, snapshotFor(player, os.clock()))
end

-- Único canal de estado: cada cliente recibe su estado y, si tiene una elección
-- pendiente, sus propias cartas.
function Match.sendTo(player: Player)
	local now = os.clock()
	Remotes.MatchStateChanged:FireClient(player, state, elapsed, LevelUp.pendingFor(player))
	Remotes.RunSnapshot:FireClient(player, snapshotFor(player, now))
end

function Match.broadcast()
	for _, player in Players:GetPlayers() do
		Match.sendTo(player)
	end
end

function Match.startRun(now: number)
	clearWorld()
	elapsed = 0
	snapshotClock = 0
	levelUpClock = 0
	resultsEndsAt = 0

	for _, player in Players:GetPlayers() do
		Run.reset(player)
		Stats.clear(player)
		LevelUp.clear(player)
		WeaponRuntime.reset(player)
		lastChoiceAt[player] = 0
		-- Base stats del jugador recien llegado. Puede no tener avatar todavia: el
		-- personaje se carga unas lineas mas abajo.
		PlayerAvatar.applyStats(player, Stats.get(player, now))

		task.spawn(function()
			local ok, problem = pcall(player.LoadCharacterAsync, player)
			if not ok then
				warn(`[Match] no se pudo cargar el personaje de {player.Name}: {problem}`)
			end
		end)
	end

	EnemySpawner.reset(now)
	Match.setState("Playing")
end

function Match.stopRun(final: MatchState, now: number)
	clearWorld()
	if final == "Defeat" or final == "Victory" then
		local duration = if final == "Victory" then Config.Run.VictoryDuration else Config.Run.DefeatDuration
		resultsEndsAt = now + duration
	end
	Match.setState(final)
end

-- Vuelta al lobby tras una partida. Deja a los jugadores vivos y con personaje para
-- que la selección de misión no aparezca sobre nadie muerto. `MissionManager` escucha
-- este estado y suelta la ejecución, de modo que la misión se puede reintentar.
function Match.returnToSelect(now: number)
	clearWorld()
	elapsed = 0
	snapshotClock = 0
	levelUpClock = 0
	resultsEndsAt = 0

	for _, player in Players:GetPlayers() do
		PlayerAvatar.applyStats(player, Stats.get(player, now))
		if not PlayerAvatar.isAlive(player) then
			task.spawn(function()
				local ok, problem = pcall(player.LoadCharacterAsync, player)
				if not ok then
					warn(`[Match] no se pudo recargar el personaje de {player.Name}: {problem}`)
					return
				end
				PlayerAvatar.applyStats(player, Stats.get(player, now))
			end)
		end
	end

	Match.setState("MissionSelect")
end

-- Un jugador "tiene elección pendiente" cuando hay cartas sin elegir. Los niveles
-- sin cartas posibles ya se descartaron dentro de `LevelUp.begin`.
local function hasPendingChoices(): boolean
	for _, player in Players:GetPlayers() do
		local offers = LevelUp.pendingFor(player)
		if offers and #offers > 0 then
			return true
		end
	end
	return false
end

function Match.beginLevelUp()
	for _, player in Players:GetPlayers() do
		if LevelUp.queuedLevels(player) > 0 then
			LevelUp.begin(player, OFFER_COUNT)
		end
	end
	levelUpClock = 0

	-- Sin cartas que ofrecer (p. ej. todo maxeado en modo dev) no hay motivo para
	-- congelar el reloj: la partida sigue sin interrupción.
	if not hasPendingChoices() then
		if state == "LevelUp" then
			Match.setState("Playing")
			EnemySpawner.reset(os.clock())
		end
		return
	end

	Match.setState("LevelUp")
end

function Match.grantXp(player: Player, amount: number)
	if not Match.isSimulating() then
		return
	end
	-- XPModifier vive en las estadísticas del jugador (base 1) para que cualquier
	-- pasiva futura pueda tocarlo sin que este sistema conozca la mejora.
	local modifier = Stats.get(player).XPModifier or 1
	local gained = Run.addXp(player, amount * modifier)
	if gained <= 0 then
		return
	end

	LevelUp.awardLevels(player, gained)
	Match.pushSnapshot(player)
	if state == "Playing" then
		Match.beginLevelUp()
	end
end

-- Petición del cliente. El servidor no confía en nada: la carta tiene que estar en
-- el conjunto pendiente y cada pendiente se consume una sola vez.
function Match.handleUpgradeRequest(player: Player, upgradeId: unknown): (boolean, string?)
	if state ~= "LevelUp" then
		return false, "run not paused"
	end
	if typeof(upgradeId) ~= "string" or #upgradeId > 40 then
		return false, "bad upgrade id"
	end

	local now = os.clock()
	if now - (lastChoiceAt[player] or 0) < CHOICE_COOLDOWN then
		return false, "too fast"
	end
	lastChoiceAt[player] = now

	if not LevelUp.consume(player, upgradeId :: string) then
		return false, "upgrade not offered"
	end

	Remotes.UpgradeChosen:FireClient(player, upgradeId)
	PlayerAvatar.applyStats(player, Stats.get(player, now))
	Match.pushSnapshot(player)

	-- Una sola gota puede dar varios niveles: se encadena otra carta sin volver a
	-- congelar el reloj. Si la generación ya no encuentra nada (todo maxeado), el
	-- nivel sobrante se descarta y se sigue con la comprobación de abajo.
	if LevelUp.queuedLevels(player) > 0 then
		local offers = LevelUp.begin(player, OFFER_COUNT)
		if #offers > 0 then
			Match.broadcast()
			return true, nil
		end
	end

	if not hasPendingChoices() then
		levelUpClock = 0
		Match.setState("Playing")
		EnemySpawner.reset(now)
	end
	return true, nil
end

function Match.onPlayerDied(player: Player)
	local run = Run.get(player)
	run.alive = false
	if state == "Victory" or state == "Defeat" or state == "Lobby" then
		return
	end
	if #PlayerAvatar.alivePlayers() > 0 then
		return
	end
	Match.stopRun("Defeat", os.clock())
end

function Match.releasePlayer(player: Player)
	lastChoiceAt[player] = nil
	Run.release(player)
	Stats.clear(player)
	LevelUp.clear(player)
	WeaponRuntime.reset(player)
	OrbitBlades.reset(player)
end

function Match.update(dt: number, now: number)
	if state == "Playing" then
		elapsed += dt
		snapshotClock += dt
		if snapshotClock >= SNAPSHOT_INTERVAL then
			snapshotClock = 0
			for _, player in Players:GetPlayers() do
				Match.pushSnapshot(player)
			end
		end
		-- Objetivo de la Fase 1 (sin misión). Con misión activa, `autoVictory` está
		-- apagado y es el MissionManager quien cierra la partida.
		if autoVictory and elapsed >= Config.Run.TargetDuration then
			Match.stopRun("Victory", now)
		end
		return
	end

	if state == "LevelUp" then
		levelUpClock += dt
		if levelUpClock >= Config.Run.LevelUpTimeout then
			-- Autoelección: una partida nunca queda bloqueada por un jugador ausente.
			-- Se elige la primera carta y es el servidor quien aplica la mejora.
			for _, player in Players:GetPlayers() do
				local offers = LevelUp.pendingFor(player)
				if offers and #offers > 0 then
					Match.handleUpgradeRequest(player, offers[1].Id)
				end
			end
			if state == "LevelUp" and not hasPendingChoices() then
				levelUpClock = 0
				Match.setState("Playing")
				EnemySpawner.reset(now)
			end
		end
		return
	end

	if (state == "Defeat" or state == "Victory") and now >= resultsEndsAt then
		if #Players:GetPlayers() > 0 then
			Match.returnToSelect(now)
		else
			state = "Lobby"
		end
	end
end

return Match
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="76">
        <Properties>
          <string name="Name">Missions</string>
        </Properties>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">BossSystem</string>
            <string name="Source"><![CDATA[--!strict
-- Dueño del jefe vivo. Es independiente de las misiones: una misión solo pide
-- `spawn(bossId)` y BossSystem decide dónde nace y cuándo ha caído. No tiene ninguna
-- rama por jefe concreto: cualquier definición etiquetada "boss" sirve.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Registry = require(Shared:WaitForChild("Registry"))
local PlayerAvatar = require(script.Parent.Parent.PlayerAvatar)
local EnemyRegistry = require(script.Parent.Parent.Enemies.EnemyRegistry)

export type Scaling = { health: number, speed: number, damage: number }
export type DefeatListener = (bossId: string) -> ()

local active: EnemyRegistry.Enemy? = nil
local activeId: string? = nil
local defeatListeners: { DefeatListener } = {}
local listenConnection: (() -> ())? = nil

local BossSystem = {}

local function ensureKillListener()
	if listenConnection then
		return
	end
	-- El jefe se identifica por referencia: es el enemigo exacto que devolvió spawn.
	-- Así dos jefes del mismo tipo en el futuro no se confunden.
	listenConnection = EnemyRegistry.onKilled(function(enemy)
		if not active or enemy ~= active then
			return
		end
		local bossId = activeId or enemy.Definition.Id
		active = nil
		activeId = nil
		for _, listener in defeatListeners do
			listener(bossId)
		end
	end)
end

local function randomSpawnPoint(): Vector3
	local players = PlayerAvatar.alivePlayers()
	if #players > 0 then
		local anchor = PlayerAvatar.root(players[math.random(1, #players)])
		if anchor then
			local angle = math.random() * math.pi * 2
			local distance = (Config.Arena.SpawnRadiusMin + Config.Arena.SpawnRadiusMax) * 0.5
			return anchor.Position + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		end
	end
	return Vector3.zero
end

function BossSystem.spawn(bossId: string, scaling: Scaling): EnemyRegistry.Enemy?
	if active then
		return active
	end
	local definition = Registry.Enemies[bossId]
	if not definition or not table.find(definition.Tags, "boss") then
		warn(`[BossSystem] {bossId} no es un jefe válido`)
		return nil
	end
	ensureKillListener()

	local enemy = EnemyRegistry.spawn(bossId, randomSpawnPoint(), scaling)
	if not enemy then
		return nil
	end
	active = enemy
	activeId = bossId
	return enemy
end

function BossSystem.isActive(): boolean
	return active ~= nil
end

function BossSystem.getActive(): EnemyRegistry.Enemy?
	return active
end

function BossSystem.getActiveId(): string?
	return activeId
end

function BossSystem.onDefeated(listener: DefeatListener): () -> ()
	table.insert(defeatListeners, listener)
	return function()
		local index = table.find(defeatListeners, listener)
		if index then
			table.remove(defeatListeners, index)
		end
	end
end

function BossSystem.reset()
	active = nil
	activeId = nil
end

return BossSystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">MissionManager</string>
            <string name="Source"><![CDATA[--!strict
-- Núcleo del sistema de misiones. Es el dueño de la verdad de la misión en curso:
-- estado, objetivos, jefe invocado, completion/failure, recompensas y desbloqueos.
--
-- No contiene ramas por misión/objetivo/jefe: todo sale de `Registry.Missions` y de
-- los registros modulares (`ObjectiveSystem`, `BossSystem`). Toda la autoridad es
-- servidor; el cliente solo recibe instantáneas y pide empezar.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared:WaitForChild("Registry"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Match = require(script.Parent.Parent.Match)
local Profile = require(script.Parent.Parent.Data.Profile)
local Difficulty = require(script.Parent.Parent.Spawning.Difficulty)
local EnemySpawner = require(script.Parent.Parent.Spawning.EnemySpawner)
local EnemyRegistry = require(script.Parent.Parent.Enemies.EnemyRegistry)
local ObjectiveSystem = require(script.Parent.ObjectiveSystem)
local BossSystem = require(script.Parent.BossSystem)
local RewardSystem = require(script.Parent.RewardSystem)
local UnlockSystem = require(script.Parent.UnlockSystem)

type MissionDefinition = Types.MissionDefinition
type MissionState = Types.MissionState
type MissionResult = Types.MissionResult

export type Execution = {
	definition: MissionDefinition,
	state: MissionState,
	objectives: { ObjectiveSystem.Runtime },
	bossSpawned: boolean,
	bossDefeated: boolean,
	rewarded: boolean,
}

local current: Execution? = nil
local lastResult: MissionResult? = nil

-- La HUD de misión se refresca con la misma cadencia que el HUD general: reloj,
-- objetivos y jefe no pueden quedarse congelados en la instantánea inicial.
local SNAPSHOT_INTERVAL = 0.2
local snapshotClock = 0

local MissionManager = {}

-- El evento de muerte llega una sola vez para todos: se reenvía a los objetivos de la
-- misión activa y se marca la caída del jefe. Ni el combate ni el spawner conocen a
-- las misiones; solo existe este canal de datos.
EnemyRegistry.onKilled(function(enemy)
	local execution = current
	if not execution or execution.state ~= "Active" then
		return
	end
	if table.find(enemy.Definition.Tags, "boss") then
		execution.bossDefeated = true
	end
	ObjectiveSystem.dispatch(execution.objectives, { Kind = "Kill", Enemy = enemy.Definition })
end)

local function summarizeObjectives(objectives: { ObjectiveSystem.Runtime }): { Types.MissionObjectiveState }
	local views: { Types.MissionObjectiveState } = {}
	for _, runtime in objectives do
		table.insert(views, ObjectiveSystem.view(runtime))
	end
	return views
end

local function remainingSeconds(execution: Execution): number?
	local remaining: number? = nil
	for _, runtime in execution.objectives do
		if runtime.Definition.Type == "Survive" then
			local left = math.max(0, runtime.Required - runtime.Current)
			if remaining == nil or left < remaining then
				remaining = left
			end
		end
	end
	return remaining
end

function MissionManager.snapshot(): Types.MissionSnapshot?
	local execution = current
	if not execution then
		return nil
	end

	local boss: Types.MissionBossView? = nil
	local bossDefinition = execution.definition.Boss
	if bossDefinition then
		local enemy = BossSystem.getActive()
		local definition = Registry.Enemies[bossDefinition.Id]
		boss = {
			Id = bossDefinition.Id,
			Name = if definition then definition.Name else bossDefinition.Id,
			Active = enemy ~= nil,
			Health = if enemy then enemy.Health else 0,
			MaxHealth = if enemy then enemy.MaxHealth else 0,
		}
	end

	return {
		MissionId = execution.definition.Id,
		DisplayName = execution.definition.DisplayName,
		MapId = execution.definition.MapId,
		State = execution.state,
		Elapsed = Match.getElapsed(),
		Remaining = remainingSeconds(execution),
		Objectives = summarizeObjectives(execution.objectives),
		Boss = boss,
	}
end

function MissionManager.broadcastUpdate()
	Remotes.MissionUpdate:FireAllClients(MissionManager.snapshot())
end

function MissionManager.sendUpdate(player: Player)
	Remotes.MissionUpdate:FireClient(player, MissionManager.snapshot())
end

local function summarizeObjectivesFor(definitions: { Types.MissionObjective })
	local list = {}
	for _, definition in definitions do
		table.insert(list, ObjectiveSystem.staticView(definition))
	end
	return list
end

function MissionManager.buildSummaries(player: Player): { Types.MissionSummary }
	local summaries: { Types.MissionSummary } = {}
	for id, mission in Registry.Missions do
		local state: MissionState = "Locked"
		if Profile.isMissionCompleted(player, id) then
			state = "Completed"
		elseif Profile.isMissionUnlocked(player, id) then
			state = "Available"
		end
		local map = Registry.Maps[mission.MapId]
		table.insert(summaries, {
			Id = id,
			MapId = mission.MapId,
			MapName = if map then map.DisplayName else mission.MapId,
			DisplayName = mission.DisplayName,
			Description = mission.Description,
			Duration = mission.Duration,
			State = state,
			Objectives = summarizeObjectivesFor(mission.Objectives),
			Rewards = {
				Currency = mission.Rewards.Currency,
				Missions = mission.Rewards.MissionUnlocks,
				Maps = mission.Rewards.MapUnlocks,
			},
		})
	end
	table.sort(summaries, function(a, b)
		return a.Id < b.Id
	end)
	return summaries
end

function MissionManager.sendList(player: Player)
	Remotes.MissionList:FireClient(player, MissionManager.buildSummaries(player))
end

function MissionManager.broadcastList()
	for _, player in Players:GetPlayers() do
		MissionManager.sendList(player)
	end
end

local function buildResult(execution: Execution, outcome: "Completed" | "Failed"): MissionResult
	return {
		MissionId = execution.definition.Id,
		DisplayName = execution.definition.DisplayName,
		Outcome = outcome,
		Duration = Match.getElapsed(),
		BossDefeated = execution.bossDefeated,
		Currency = 0,
		UnlockedMissions = {},
		UnlockedMaps = {},
	}
end

-- Cierre por éxito. Se llama una sola vez: el estado pasa a "Completing" antes de
-- repartir nada, así una segunda detección no duplica recompensas.
function MissionManager.complete(now: number)
	local execution = current
	if not execution or execution.state ~= "Active" then
		return
	end
	execution.state = "Completing"
	EnemySpawner.clearConfiguration()

	local players = Players:GetPlayers()
	local rewards = execution.definition.Rewards
	local result = buildResult(execution, "Completed")

	if not execution.rewarded then
		execution.rewarded = true
		RewardSystem.grant(rewards, players)
		local unlocked = UnlockSystem.apply(rewards, players)
		result.Currency = rewards.Currency
		result.UnlockedMissions = unlocked.Missions
		result.UnlockedMaps = unlocked.Maps
		for _, player in players do
			Profile.completeMission(player, execution.definition.Id)
		end
	end

	lastResult = result
	execution.state = "Completed"
	MissionManager.broadcastUpdate()
	Remotes.MissionFinished:FireAllClients(result)
	MissionManager.broadcastList()

	-- El fin de partida existente se reutiliza tal cual: limpia el mundo, muestra la
	-- pantalla de resultado y, tras la pausa, vuelve a la selección de misión.
	Match.stopRun("Victory", now)
end

-- Cierre por fallo. No reparte nada y deja la misión en Available para reintentar.
function MissionManager.fail()
	local execution = current
	if not execution or (execution.state ~= "Active" and execution.state ~= "Preparing") then
		return
	end
	execution.state = "Failed"
	EnemySpawner.clearConfiguration()
	BossSystem.reset()

	local result = buildResult(execution, "Failed")
	lastResult = result
	MissionManager.broadcastUpdate()
	Remotes.MissionFinished:FireAllClients(result)
end

function MissionManager.onMatchState(state: Types.MatchState)
	if state == "Defeat" then
		-- El fallo lo decide `Match` (todos muertos). La misión solo reacciona.
		MissionManager.fail()
	elseif state == "MissionSelect" or state == "Lobby" then
		-- Vuelta al lobby: se suelta la ejecución para poder reintentar la misión.
		current = nil
		lastResult = nil
		EnemySpawner.clearConfiguration()
		BossSystem.reset()
		Match.setAutoVictory(true)
	end
end

-- Validación autoritativa. Nada del cliente se cree: existencia, mapa, desbloqueo y
-- estado de partida se comprueban aquí.
function MissionManager.requestStart(player: Player, missionId: unknown): (boolean, string?)
	if typeof(missionId) ~= "string" or #missionId == 0 or #missionId > 60 then
		return false, "bad mission id"
	end
	local definition = Registry.Missions[missionId]
	if not definition then
		return false, "unknown mission"
	end
	if not Registry.Maps[definition.MapId] then
		return false, "unknown map"
	end
	if not Profile.isMissionUnlocked(player, missionId) then
		return false, "mission locked"
	end
	if
		current
		and (current.state == "Active" or current.state == "Preparing" or current.state == "Completing")
	then
		return false, "mission already running"
	end

	local state = Match.getState()
	if state ~= "MissionSelect" and state ~= "Lobby" then
		return false, "not in mission select"
	end

	local execution: Execution = {
		definition = definition,
		state = "Preparing",
		objectives = ObjectiveSystem.createAll(definition.Objectives),
		bossSpawned = false,
		bossDefeated = false,
		rewarded = false,
	}
	current = execution
	lastResult = nil
	snapshotClock = 0

	-- La configuración llega al spawner antes de que arranque la partida, para que la
	-- primera oleada ya sea la de la misión.
	Match.setAutoVictory(false)
	EnemySpawner.setConfiguration(definition.EnemyConfiguration, definition.DifficultyMultipliers)
	Match.startRun(os.clock())

	execution.state = "Active"
	MissionManager.broadcastUpdate()
	MissionManager.broadcastList()
	return true, nil
end

function MissionManager.update(dt: number, now: number)
	local execution = current
	if not execution or execution.state ~= "Active" or not Match.isSimulating() then
		return
	end

	snapshotClock += dt
	local elapsed = Match.getElapsed()
	ObjectiveSystem.update(execution.objectives, dt)

	local boss = execution.definition.Boss
	if boss and not execution.bossSpawned and elapsed >= (boss.SpawnAt or 0) then
		execution.bossSpawned = true
		BossSystem.spawn(boss.Id, Difficulty.evaluate(elapsed, execution.definition.DifficultyMultipliers))
		MissionManager.broadcastUpdate()
	end

	-- Actualización periódica: el reloj y los objetivos avanzan en el servidor y la
	-- HUD tiene que reflejarlo, no solo la instantánea del arranque.
	if snapshotClock >= SNAPSHOT_INTERVAL then
		snapshotClock = 0
		MissionManager.broadcastUpdate()
	end

	if ObjectiveSystem.allComplete(execution.objectives) then
		MissionManager.complete(now)
	end
end

-- Dev (playtest): adelanta los objetivos que corren por reloj (Survive) para probar
-- fases tardías sin esperar. `Match.advanceTime` hace lo mismo con el reloj de
-- partida; este método es un accesorio del admin, no parte del contrato definitivo.
function MissionManager.skipTime(seconds: number): boolean
	local execution = current
	if not execution or execution.state ~= "Active" then
		return false
	end
	for _, runtime in execution.objectives do
		if runtime.Definition.Type == "Survive" then
			local next = math.min(runtime.Required, runtime.Current + seconds)
			runtime.Current = next
			runtime.Complete = next >= runtime.Required
		end
	end
	MissionManager.broadcastUpdate()
	return true
end

function MissionManager.isActive(): boolean
	return current ~= nil and current.state == "Active"
end

function MissionManager.getState(): MissionState?
	return if current then current.state else nil
end

function MissionManager.getCurrentId(): string?
	return if current then current.definition.Id else nil
end

function MissionManager.lastResult(): MissionResult?
	return lastResult
end

return MissionManager
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">ObjectiveSystem</string>
            <string name="Source"><![CDATA[--!strict
-- Registro de tipos de objetivo. `MissionManager` nunca tiene una rama por tipo:
-- crea runtimes, los actualiza por tiempo y les reparte eventos de gameplay.
--
-- Añadir un objetivo nuevo = un módulo en `Objectives/` + una línea aquí. No se toca
-- ni la misión ni el gestor central.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))

-- Evento de gameplay normalizado. Hoy solo hay muertes; el día que exista recogida
-- de objetos o interacción, se añade una variante y los objetivos interesados la leen.
export type ObjectiveEvent =
	{ Kind: "Kill", Enemy: Types.EnemyDefinition }
	| { Kind: "BossDefeated", BossId: string }

export type Runtime = {
	Definition: Types.MissionObjective,
	Required: number,
	Current: number,
	Complete: boolean,
	Update: (runtime: Runtime, dt: number) -> (),
	HandleEvent: (runtime: Runtime, event: ObjectiveEvent) -> (),
	Label: (definition: Types.MissionObjective) -> string,
}

local Modules: {
	[string]: {
		Label: (definition: Types.MissionObjective) -> string,
		Required: (definition: Types.MissionObjective) -> number,
		Update: (runtime: Runtime, dt: number) -> (),
		HandleEvent: (runtime: Runtime, event: ObjectiveEvent) -> (),
	},
} =
	{
		Survive = require(script.Parent.Objectives.Survive),
		KillEnemy = require(script.Parent.Objectives.KillEnemy),
		KillElite = require(script.Parent.Objectives.KillElite),
		DefeatBoss = require(script.Parent.Objectives.DefeatBoss),
	}

local ObjectiveSystem = {}

function ObjectiveSystem.create(definition: Types.MissionObjective): Runtime
	local module = Modules[definition.Type]
	if not module then
		error(`[ObjectiveSystem] tipo de objetivo desconocido {tostring(definition.Type)}`)
	end
	return {
		Definition = definition,
		Required = module.Required(definition),
		Current = 0,
		Complete = false,
		Update = module.Update,
		HandleEvent = module.HandleEvent,
		Label = module.Label,
	}
end

function ObjectiveSystem.createAll(definitions: { Types.MissionObjective }): { Runtime }
	local runtimes: { Runtime } = {}
	for _, definition in definitions do
		table.insert(runtimes, ObjectiveSystem.create(definition))
	end
	return runtimes
end

function ObjectiveSystem.update(runtimes: { Runtime }, dt: number)
	for _, runtime in runtimes do
		runtime.Update(runtime, dt)
	end
end

function ObjectiveSystem.dispatch(runtimes: { Runtime }, event: ObjectiveEvent)
	for _, runtime in runtimes do
		if not runtime.Complete then
			runtime.HandleEvent(runtime, event)
		end
	end
end

-- Todos los objetivos son obligatorios en el modo actual ("All"). Si una misión
-- futura necesita "Sequential"/"Some", se añade aquí sin tocar los objetivos.
function ObjectiveSystem.allComplete(runtimes: { Runtime }): boolean
	for _, runtime in runtimes do
		if not runtime.Complete then
			return false
		end
	end
	return true
end

function ObjectiveSystem.view(runtime: Runtime): Types.MissionObjectiveState
	return {
		Type = runtime.Definition.Type,
		Label = runtime.Label(runtime.Definition),
		Current = runtime.Current,
		Required = runtime.Required,
		Complete = runtime.Complete,
	}
end

-- Descripción sin estado, para el panel de selección: etiqueta y total de un
-- objetivo antes de que exista una ejecución.
function ObjectiveSystem.staticView(
	definition: Types.MissionObjective
): { Type: Types.MissionObjectiveType, Label: string, Required: number }
	local runtime = ObjectiveSystem.create(definition)
	return {
		Type = definition.Type,
		Label = runtime.Label(definition),
		Required = runtime.Required,
	}
end

return ObjectiveSystem
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="80">
          <Properties>
            <string name="Name">Objectives</string>
          </Properties>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">DefeatBoss</string>
              <string name="Source"><![CDATA[--!strict
-- Objetivo: derrotar al jefe indicado (etiqueta "boss" en la definición). Se apoya
-- en el mismo evento de muerte que el resto: no conoce BossSystem ni la misión.
local DefeatBoss = {}

function DefeatBoss.Label(definition): string
	return string.format("Derrota al jefe (%s)", definition.TargetId or "?")
end

function DefeatBoss.Required(): number
	return 1
end

function DefeatBoss.Update() end

function DefeatBoss.HandleEvent(runtime, event)
	if runtime.Complete or event.Kind ~= "Kill" then
		return
	end
	local enemy = event.Enemy
	if not table.find(enemy.Tags, "boss") then
		return
	end
	if runtime.Definition.TargetId and enemy.Id ~= runtime.Definition.TargetId then
		return
	end
	runtime.Complete = true
	runtime.Current = runtime.Required
end

return DefeatBoss
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">KillElite</string>
              <string name="Source"><![CDATA[--!strict
-- Objetivo: eliminar N enemigos de élite (etiqueta "elite" en la definición).
local KillElite = {}

function KillElite.Label(definition): string
	return string.format("Elimina %d élite(s)", definition.Amount or 1)
end

function KillElite.Required(definition): number
	return math.max(1, definition.Amount or 1)
end

function KillElite.Update() end

function KillElite.HandleEvent(runtime, event)
	if runtime.Complete or event.Kind ~= "Kill" then
		return
	end
	if not table.find(event.Enemy.Tags, "elite") then
		return
	end
	runtime.Current += 1
	if runtime.Current >= runtime.Required then
		runtime.Complete = true
	end
end

return KillElite
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">KillEnemy</string>
              <string name="Source"><![CDATA[--!strict
-- Objetivo: eliminar N enemigos (opcionalmente de un `TargetId` concreto).
local KillEnemy = {}

function KillEnemy.Label(definition): string
	if definition.TargetId then
		return string.format("Elimina %d x %s", definition.Amount or 1, definition.TargetId)
	end
	return string.format("Elimina %d enemigos", definition.Amount or 1)
end

function KillEnemy.Required(definition): number
	return math.max(1, definition.Amount or 1)
end

function KillEnemy.Update() end

function KillEnemy.HandleEvent(runtime, event)
	if runtime.Complete or event.Kind ~= "Kill" then
		return
	end
	local definition = runtime.Definition
	local enemy = event.Enemy
	if definition.TargetId and enemy.Id ~= definition.TargetId then
		return
	end
	runtime.Current += 1
	if runtime.Current >= runtime.Required then
		runtime.Complete = true
	end
end

return KillEnemy
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">Survive</string>
              <string name="Source"><![CDATA[--!strict
-- Objetivo: sobrevivir N segundos. Puro: no conoce Roblox ni la misión.
--
-- Interfaz de objetivo (ver ObjectiveSystem):
--   Label(definition) -> string        texto para la UI
--   Required(definition) -> number     total normalizado
--   Update(runtime, dt)                avance por tiempo
--   HandleEvent(runtime, event)        avance por evento de gameplay
local Survive = {}

function Survive.Label(definition): string
	return string.format("Sobrevive %d s", math.floor(definition.Duration or 0))
end

function Survive.Required(definition): number
	return math.max(1, definition.Duration or 1)
end

function Survive.Update(runtime, dt: number)
	if runtime.Complete then
		return
	end
	runtime.Current = math.min(runtime.Required, runtime.Current + dt)
	if runtime.Current >= runtime.Required then
		runtime.Complete = true
	end
end

function Survive.HandleEvent() end

return Survive
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">RewardSystem</string>
            <string name="Source"><![CDATA[--!strict
-- Aplica las recompensas de una misión completada. Solo corre en el servidor y solo
-- desde `MissionManager` tras una victoria real: no existe ninguna ruta por la que
-- el cliente pueda pedir recompensas.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Profile = require(script.Parent.Parent.Data.Profile)

local RewardSystem = {}

-- Devuelve la moneda total repartida (0 si `rewards.Currency <= 0`).
function RewardSystem.grant(rewards: Types.MissionRewards, players: { Player }?): number
	local recipients = players or Players:GetPlayers()
	local total = 0
	for _, player in recipients do
		total += Profile.addCurrency(player, rewards.Currency)
	end
	return total
end

return RewardSystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">UnlockSystem</string>
            <string name="Source"><![CDATA[--!strict
-- Aplica los desbloqueos de una misión completada. Separado de RewardSystem para que
-- `MissionManager` no acumule la responsabilidad de toda la progresión.
--
-- Devuelve solo lo desbloqueado de verdad (primera vez), para informar al cliente sin
-- repetir avisos en reintentos.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Profile = require(script.Parent.Parent.Data.Profile)

export type Applied = {
	Missions: { string },
	Maps: { string },
}

local UnlockSystem = {}

function UnlockSystem.apply(rewards: Types.MissionRewards, players: { Player }?): Applied
	local recipients = players or Players:GetPlayers()
	local missions: { [string]: boolean } = {}
	local maps: { [string]: boolean } = {}

	for _, player in recipients do
		for _, missionId in rewards.MissionUnlocks do
			if Profile.unlockMission(player, missionId) then
				missions[missionId] = true
			end
		end
		for _, mapId in rewards.MapUnlocks do
			if Profile.unlockMap(player, mapId) then
				maps[mapId] = true
			end
		end
	end

	local unlockedMissions: { string } = {}
	for id in missions do
		table.insert(unlockedMissions, id)
	end
	table.sort(unlockedMissions)

	local unlockedMaps: { string } = {}
	for id in maps do
		table.insert(unlockedMaps, id)
	end
	table.sort(unlockedMaps)

	return { Missions = unlockedMissions, Maps = unlockedMaps }
end

return UnlockSystem
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="87">
        <Properties>
          <string name="Name">Pickups</string>
        </Properties>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">XPPickups</string>
            <string name="Source"><![CDATA[--!strict
-- Gotas de experiencia. Es un sistema de recogidas genérico: decide magnetismo,
-- atracción y recogida, pero no qué hace el juego con la recompensa; eso lo inyecta
-- el propietario de la partida con onCollect, para que este módulo no dependa del
-- estado de partida y se pueda reutilizar para otro tipo de pickup.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Pool = require(script.Parent.Parent.Utility.Pool)
local Stats = require(script.Parent.Parent.Stats)
local PlayerAvatar = require(script.Parent.Parent.PlayerAvatar)

local COLLECT_RADIUS = 2.2
local MIN_PULL = 26
local MAX_PULL = 95

type Pickup = {
	Part: BasePart,
	Position: Vector3,
	Value: number,
	Slot: number,
	Lease: any,
}

-- Lista decentes candidatos reutilizada por frame: recorrer Players y buscar la raíz
-- por cada gota multiplicaría el coste por el número de gotas.
type Candidate = {
	player: Player,
	root: BasePart,
	radius: number,
}

local pickups: { Pickup } = {}
local candidates: { Candidate } = {}
local candidateCount = 0
local container: Folder = nil
local pool: Pool.Pooled = nil
local collectHandler: ((Player, number) -> ())? = nil

local function buildTemplate(): Part
	local part = Instance.new("Part")
	part.Name = "XPPickup"
	part.Shape = Enum.PartType.Ball
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.Neon
	part.CastShadow = false
	return part
end

local XPPickups = {}

function XPPickups.init()
	if container then
		return
	end
	container = Instance.new("Folder")
	container.Name = "XPPickups"
	container.Parent = workspace
	pool = Pool.new(buildTemplate(), 64)
end

-- El propietario de la partida decide qué significa recoger XP (subir de nivel,
-- pausar la acción, avisar al cliente). Aquí solo se entrega el valor.
function XPPickups.onCollect(handler: (Player, number) -> ())
	collectHandler = handler
end

function XPPickups.count(): number
	return #pickups
end

local function applyLook(pickup: Pickup)
	local value = pickup.Value
	local size = math.clamp(0.5 + value * 0.06, 0.5, 2)
	pickup.Part.Size = Vector3.new(size, size, size)
	pickup.Part.Color = if value >= 12 then Color3.fromRGB(120, 255, 150) else Color3.fromRGB(110, 190, 255)
	pickup.Part.CFrame = CFrame.new(pickup.Position + Vector3.new(0, size * 0.5, 0))
end

-- Cuando hay demasiadas gotas en el suelo, la nueva se funde con la más cercana en
-- lugar de instanciarse. La recompensa no se pierde y el jugador ve una gota mayor.
local function mergeIntoClosest(position: Vector3, value: number): Pickup?
	local best: Pickup? = nil
	local bestDistance = Config.Pickups.MergeRadius * Config.Pickups.MergeRadius
	for _, pickup in pickups do
		local dx = pickup.Position.X - position.X
		local dz = pickup.Position.Z - position.Z
		local distance = dx * dx + dz * dz
		if distance <= bestDistance then
			bestDistance = distance
			best = pickup
		end
	end
	if best then
		best.Value += value
		applyLook(best)
	end
	return best
end

function XPPickups.spawn(position: Vector3, value: number): Pickup?
	if not pool or value <= 0 then
		return nil
	end

	if #pickups >= Config.Pickups.MaxActive then
		return mergeIntoClosest(position, value)
	end

	local acquired, lease = pool:Get(function(instance)
		local part = instance :: Part
		part.Transparency = 0.15
		part.Parent = container
	end)

	local pickup: Pickup = {
		Part = acquired :: Part,
		Position = position,
		Value = value,
		Slot = #pickups + 1,
		Lease = lease,
	}
	-- El tamaño comunica el valor de un vistazo y evita tener que etiquetar nada.
	applyLook(pickup)
	table.insert(pickups, pickup)
	return pickup
end

local function release(index: number)
	local pickup = pickups[index]
	local slot = pickup.Slot
	local last = pickups[#pickups]
	pickups[slot] = last
	last.Slot = slot
	table.remove(pickups)
	pool:Release(pickup.Part, pickup.Lease)
end

local function refreshCandidates(now: number)
	candidateCount = 0
	for _, player in PlayerAvatar.alivePlayers() do
		local root = PlayerAvatar.root(player)
		if root then
			candidateCount += 1
			local slot = candidates[candidateCount]
			if slot then
				slot.player = player
				slot.root = root
				slot.radius = Stats.get(player, now).PickupRadius or 0
			else
				table.insert(candidates, {
					player = player,
					root = root,
					radius = Stats.get(player, now).PickupRadius or 0,
				})
			end
		end
	end
end

local function updatePickup(index: number, dt: number)
	local pickup = pickups[index]

	-- Un solo recorrido decide quién atrae cada gota. En cooperativo la XP es
	-- compartida, así que vale con el jugador vivo más cercano dentro de su radio.
	local owner: Player? = nil
	local ownerRoot: BasePart? = nil
	local closest = math.huge
	local radius = 0

	for slot = 1, candidateCount do
		local candidate = candidates[slot]
		local root = candidate.root
		local dx = root.Position.X - pickup.Position.X
		local dz = root.Position.Z - pickup.Position.Z
		local distance = math.sqrt(dx * dx + dz * dz)
		if distance <= candidate.radius and distance < closest then
			owner = candidate.player
			ownerRoot = root
			closest = distance
			radius = candidate.radius
		end
	end

	if owner and ownerRoot then
		if closest <= COLLECT_RADIUS then
			if collectHandler then
				collectHandler(owner, pickup.Value)
			end
			release(index)
			return
		end

		-- La atracción acelera al acercarse, así que el efecto "imán" se lee sin
		-- necesidad de un tween por gota.
		local closeness = 1 - math.clamp(closest / math.max(radius, 0.001), 0, 1)
		local pull = MIN_PULL + (MAX_PULL - MIN_PULL) * closeness
		local direction = ownerRoot.Position - pickup.Position
		local distance = direction.Magnitude
		if distance > 0.01 then
			pickup.Position += (direction / distance) * pull * dt
		end
	end

	local size = pickup.Part.Size.X
	pickup.Part.CFrame = CFrame.new(pickup.Position + Vector3.new(0, size * 0.5, 0))
end

function XPPickups.update(dt: number)
	if #pickups == 0 then
		return
	end
	refreshCandidates(os.clock())
	for index = #pickups, 1, -1 do
		updatePickup(index, dt)
	end
end

function XPPickups.clearAll()
	for index = #pickups, 1, -1 do
		release(index)
	end
end

return XPPickups
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="89">
        <Properties>
          <string name="Name">PlayerAvatar</string>
          <string name="Source"><![CDATA[--!strict
-- Puente entre las estadísticas de la partida y el avatar del jugador.
-- El Humanoid es la representación física de la vida y la velocidad; las cifras
-- autoritativas viven en Stats, aquí solo se las proyectamos.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))

type StatBlock = Types.StatBlock

local PlayerAvatar = {}

function PlayerAvatar.humanoid(player: Player): Humanoid?
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChildOfClass("Humanoid")
end

function PlayerAvatar.root(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function PlayerAvatar.isAlive(player: Player): boolean
	local humanoid = PlayerAvatar.humanoid(player)
	return humanoid ~= nil and humanoid.Health > 0
end

-- Si sube la vida máxima, el jugador recibe la diferencia en vida actual: un +25
-- de salud máxima se siente como una cura y no como una cura desperdiciada.
function PlayerAvatar.applyStats(player: Player, stats: StatBlock)
	local humanoid = PlayerAvatar.humanoid(player)
	if not humanoid then
		return
	end

	local maxHealth = math.max(1, stats.MaxHealth or humanoid.MaxHealth)
	local previousMax = humanoid.MaxHealth
	humanoid.MaxHealth = maxHealth
	if maxHealth > previousMax and humanoid.Health > 0 then
		humanoid.Health = math.min(maxHealth, humanoid.Health + (maxHealth - previousMax))
	end

	humanoid.WalkSpeed = stats.MoveSpeed or 16
end

-- La armadura resta daño plano con un suelo del 25% del daño original, para que
-- nunca llegue a ser invulnerable.
function PlayerAvatar.damage(player: Player, stats: StatBlock, amount: number): number
	local humanoid = PlayerAvatar.humanoid(player)
	if not humanoid or humanoid.Health <= 0 or amount <= 0 then
		return 0
	end
	local armor = stats.Armor or 0
	local applied = math.max(amount * 0.25, amount - armor)
	applied = math.min(applied, humanoid.Health)
	humanoid.Health = humanoid.Health - applied
	return applied
end

function PlayerAvatar.heal(player: Player, amount: number)
	local humanoid = PlayerAvatar.humanoid(player)
	if not humanoid or humanoid.Health <= 0 or amount <= 0 then
		return
	end
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
end

function PlayerAvatar.teleport(player: Player, position: Vector3)
	local root = PlayerAvatar.root(player)
	if root then
		root.CFrame = CFrame.new(position + Vector3.new(0, 4, 0))
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

function PlayerAvatar.alivePlayers(): { Player }
	local alive = {}
	for _, player in Players:GetPlayers() do
		if PlayerAvatar.isAlive(player) then
			table.insert(alive, player)
		end
	end
	return alive
end

return PlayerAvatar
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="90">
        <Properties>
          <string name="Name">Progression</string>
        </Properties>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">LevelUp</string>
            <string name="Source"><![CDATA[--!strict
-- Selección de mejora. Es el dueño del ciclo "ofrezco cartas → el jugador elige una
-- → la aplico". El estado de partida y el reloj los lleva Match; aquí solo se sabe
-- qué carta está pendiente y qué hay que aplicarle al jugador.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared:WaitForChild("Registry"))
local UpgradeOffers = require(Shared:WaitForChild("UpgradeOffers"))
local Types = require(Shared:WaitForChild("Types"))
local Run = require(script.Parent.Parent.Run)
local Stats = require(script.Parent.Parent.Stats)

type UpgradeOffer = Types.UpgradeOffer

local LevelUp = {}

local queued: { [Player]: number } = {}
local pending: { [Player]: { UpgradeOffer } } = {}

function LevelUp.queuedLevels(player: Player): number
	return queued[player] or 0
end

function LevelUp.awardLevels(player: Player, count: number)
	queued[player] = (queued[player] or 0) + count
end

function LevelUp.pendingFor(player: Player): { UpgradeOffer }?
	return pending[player]
end

function LevelUp.begin(player: Player, offerCount: number): { UpgradeOffer }
	local luck = Stats.get(player).Luck or 1
	local offers = UpgradeOffers.generate(Run.view(player), luck, math.random, offerCount)
	if #offers == 0 then
		-- Nada que ofrecer (p. ej. todo maxeado en modo dev): el nivel pendiente no
		-- puede resolverse, se descarta y no se congela la partida.
		queued[player] = 0
		pending[player] = nil
		return offers
	end
	-- Esta carta resuelve un nivel; los que quedan se encadenan al consumirla.
	queued[player] = math.max(0, (queued[player] or 0) - 1)
	pending[player] = offers
	return offers
end

local function apply(player: Player, offer: UpgradeOffer)
	local run = Run.get(player)
	local definition = Registry.Upgrades[offer.Id]

	run.upgradeLevels[offer.Id] = (run.upgradeLevels[offer.Id] or 0) + 1

	if offer.Kind == "NewWeapon" then
		local weaponId = offer.TargetId
		if weaponId then
			run.weaponLevels[weaponId] = math.max(1, run.weaponLevels[weaponId] or 0)
		end
	elseif offer.TargetId == nil then
		-- Las mejoras globales entran en el sistema de estadísticas, que es el único
		-- que escribe sobre los valores base.
		for _, modifier in definition.Modifiers do
			Stats.add(player, modifier)
		end
	end
	-- Las mejoras dirigidas a un arma no se registran aquí: WeaponRuntime las lee
	-- desde run.upgradeLevels y las aplica sobre las estadísticas de ese arma.
end

-- Consume la carta elegida. Devolver false significa "no era una oferta vigente":
-- el motivo concreto no le interesa al servidor, solo que no se aplicó nada.
function LevelUp.consume(player: Player, upgradeId: string): boolean
	local offers = pending[player]
	if not offers then
		return false
	end

	local chosen: UpgradeOffer? = nil
	for _, offer in offers do
		if offer.Id == upgradeId then
			chosen = offer
			break
		end
	end
	if not chosen then
		return false
	end

	pending[player] = nil
	apply(player, chosen)
	return true
end

function LevelUp.clear(player: Player)
	queued[player] = nil
	pending[player] = nil
end

return LevelUp
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="92">
        <Properties>
          <string name="Name">Run</string>
          <string name="Source"><![CDATA[--!strict
-- Estado de partida de un jugador: nivel, XP, armas y mejoras. Es memoria volátil;
-- al terminar la partida se descarta. Nada de esto se guarda (eso es MetaData).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared:WaitForChild("Registry"))
local Progression = require(Shared:WaitForChild("Progression"))
local Types = require(Shared:WaitForChild("Types"))

type RunView = Types.RunView

export type Run = {
	player: Player,
	level: number,
	xp: number,
	alive: boolean,
	weaponLevels: { [string]: number },
	upgradeLevels: { [string]: number },
}

local runs: { [Player]: Run } = {}

local function create(player: Player): Run
	local run: Run = {
		player = player,
		level = 1,
		xp = 0,
		alive = true,
		weaponLevels = { [Registry.StartingWeaponId] = 1 },
		upgradeLevels = {},
	}
	runs[player] = run
	return run
end

local Run = {}

function Run.get(player: Player): Run
	return runs[player] or create(player)
end

function Run.release(player: Player)
	runs[player] = nil
end

function Run.reset(player: Player)
	create(player)
end

function Run.addXp(player: Player, amount: number): number
	local run = runs[player]
	if not run or amount <= 0 then
		return 0
	end
	local level, xp, gained = Progression.addXp(run.level, run.xp, amount)
	run.level = level
	run.xp = xp
	return gained
end

function Run.view(player: Player): RunView
	local run = Run.get(player)
	return {
		level = run.level,
		weaponLevels = run.weaponLevels,
		upgradeLevels = run.upgradeLevels,
	}
end

function Run.xpToNext(player: Player): number
	local run = Run.get(player)
	return Progression.xpForNext(run.level)
end

return Run
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="93">
        <Properties>
          <string name="Name">Spawning</string>
        </Properties>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">Difficulty</string>
            <string name="Source"><![CDATA[--!strict
-- La dificultad es una función pura del tiempo jugado. Todos los números viven en
-- Config: ningún sistema multiplica su propia copia de "cuánto escala".
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

export type Profile = {
	health: number,
	speed: number,
	damage: number,
	spawnInterval: number,
	batchSize: number,
	maxAlive: number,
}

local Difficulty = {}

-- Evaluate difficulty with optional mission missionMultipliers The default config is a
-- straight function of elapsed time; a mission can ease that curve or boost
-- particular stats. The returned profile is the single channel between
-- difficulty and spawners.
function Difficulty.evaluate(
	elapsedSeconds: number,
	multipliers: {
		EnemyHealthMultiplier: number?,
		EnemyDamageMultiplier: number?,
		EnemySpawnRateMultiplier: number?,
	}?
): Profile
	local minutes = math.max(0, elapsedSeconds) / 60
	local settings = multipliers or {}
	-- `EnemySpawnRateMultiplier > 1` = más presión: el intervalo BAJA y la tanda y el
	-- tope de vivos SUBEN. No toca la velocidad: una misión no debe volver a los
	-- enemigos más rápidos por el simple hecho de spawnear más.
	local rate = math.max(0.05, settings.EnemySpawnRateMultiplier or 1)
	local baseInterval = Config.Spawn.BaseInterval - minutes * Config.Spawn.IntervalDecayPerMinute
	local baseAlive = Config.Spawn.BaseMaxAlive + minutes * Config.Spawn.MaxAlivePerMinute
	return {
		health = (1 + minutes * Config.Scaling.HealthPerMinute) * (settings.EnemyHealthMultiplier or 1),
		speed = math.min(Config.Scaling.MaxSpeedMultiplier, 1 + minutes * Config.Scaling.SpeedPerMinute),
		damage = (1 + minutes * Config.Scaling.DamagePerMinute) * (settings.EnemyDamageMultiplier or 1),
		spawnInterval = math.max(Config.Spawn.MinInterval, baseInterval / rate),
		batchSize = math.max(
			1,
			math.floor((Config.Spawn.BaseBatch + minutes * Config.Spawn.BatchPerMinute) * rate)
		),
		maxAlive = math.max(Config.Spawn.BaseMaxAlive, math.floor(baseAlive * rate)),
	}
end

return Difficulty
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">EnemySpawner</string>
            <string name="Source"><![CDATA[--!strict
-- Spawner independiente del GameManager. Decide qué aparece, cuándo y dónde, pero
-- no sabe nada de comportamiento ni de daño: solo llama a EnemyRegistry.spawn.
--
-- La configuración de enemigos llega desde la misión (`setConfiguration`) y es el
-- único canal entre contenido y spawn: añadir una misión no toca este archivo.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Registry = require(Shared:WaitForChild("Registry"))
local Types = require(Shared:WaitForChild("Types"))
local PlayerAvatar = require(script.Parent.Parent.PlayerAvatar)
local Difficulty = require(script.Parent.Difficulty)
local EnemyRegistry = require(script.Parent.Parent.Enemies.EnemyRegistry)

type Group = { enemyId: string, weight: number }

-- Lista por defecto cuando no hay misión activa (Fase 1): un único enemigo básico.
local DEFAULT_GROUPS: { Group } = {
	{ enemyId = "basic", weight = 1 },
}

local activeGroups: { Group }? = nil
local activeMultipliers: Types.MissionDifficulty? = nil
local nextSpawnAt = 0

local EnemySpawner = {}

function EnemySpawner.reset(now: number)
	nextSpawnAt = now + Config.Run.EnemySpawnGrace
end

-- Traduce la configuración de la misión a la lista ponderada que usa el spawner.
-- Deshabilitar un enemigo o darle peso 0 lo saca del sorteo; `EliteChance` es un
-- multiplicador de peso sobre los enemigos etiquetados "elite".
function EnemySpawner.setConfiguration(
	enemyConfiguration: Types.EnemyConfiguration,
	multipliers: Types.MissionDifficulty
)
	local groups: { Group } = {}
	for enemyId, entry in enemyConfiguration do
		if entry.Enabled and entry.Weight > 0 then
			local definition = Registry.Enemies[enemyId]
			local weight = entry.Weight
			if multipliers.EliteChance and definition and table.find(definition.Tags, "elite") then
				weight *= 1 + multipliers.EliteChance
			end
			table.insert(groups, { enemyId = enemyId, weight = weight })
		end
	end
	table.sort(groups, function(a, b)
		return a.enemyId < b.enemyId
	end)
	activeGroups = groups
	activeMultipliers = multipliers
end

function EnemySpawner.clearConfiguration()
	activeGroups = nil
	activeMultipliers = nil
end

function EnemySpawner.hasConfiguration(): boolean
	return activeGroups ~= nil
end

local function pickEnemyId(groups: { Group }): string?
	local total = 0
	for _, group in groups do
		total += group.weight
	end
	if total <= 0 then
		return nil
	end

	local target = math.random() * total
	local accumulated = 0
	for _, group in groups do
		accumulated += group.weight
		if target <= accumulated then
			return group.enemyId
		end
	end
	return groups[#groups].enemyId
end

local function randomSpawnPoint(): Vector3?
	local players = PlayerAvatar.alivePlayers()
	if #players == 0 then
		return nil
	end
	local anchor = PlayerAvatar.root(players[math.random(1, #players)])
	if not anchor then
		return nil
	end

	-- Nace en un anillo alrededor de un jugador, nunca encima: así el jugador
	-- siempre tiene salida y el spawner no depende de un punto fijo del mapa.
	local angle = math.random() * math.pi * 2
	local distance = Config.Arena.SpawnRadiusMin
		+ math.random() * (Config.Arena.SpawnRadiusMax - Config.Arena.SpawnRadiusMin)
	return anchor.Position + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
end

function EnemySpawner.update(now: number, elapsed: number)
	if now < nextSpawnAt then
		return
	end

	local groups = activeGroups or DEFAULT_GROUPS
	local profile = Difficulty.evaluate(elapsed, activeMultipliers)
	nextSpawnAt = now + profile.spawnInterval

	for _ = 1, profile.batchSize do
		if EnemyRegistry.count() >= profile.maxAlive then
			return
		end
		local enemyId = pickEnemyId(groups)
		local position = randomSpawnPoint()
		if enemyId and position then
			EnemyRegistry.spawn(enemyId, position, profile)
		end
	end
end

return EnemySpawner
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="96">
        <Properties>
          <string name="Name">Stats</string>
          <string name="Source"><![CDATA[--!strict
-- Estadísticas por jugador. Es el único dueño de los modificadores de una partida:
-- nadie más escribe en Config.PlayerBaseStats, así que las pasivas y los buffs
-- temporales se acumulan aquí y se resuelven con el módulo puro StatMath.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local StatMath = require(Shared:WaitForChild("StatMath"))
local Types = require(Shared:WaitForChild("Types"))

type StatBlock = Types.StatBlock
type StatModifier = Types.StatModifier

type Entry = {
	modifier: StatModifier,
	expiresAt: number?,
}

local entries: { [Player]: { Entry } } = {}
local cache: { [Player]: StatBlock } = {}
local nextExpiry: { [Player]: number? } = {}

local function listFor(player: Player): { Entry }
	local list = entries[player]
	if not list then
		list = {}
		entries[player] = list
	end
	return list
end

local function prune(player: Player, now: number): { StatModifier }
	-- listFor y no entries[player]: un get() legitimo puede llegar sin modificadores
	-- todavia (jugador recien limpiado al arrancar la partida), y un jugador sin
	-- modificadores debe resolver simplemente las estadisticas base.
	local list = listFor(player)
	local modifiers: { StatModifier } = {}
	local kept: { Entry } = {}
	local soonest: number? = nil

	for _, entry in list do
		if entry.expiresAt then
			if entry.expiresAt <= now then
				continue
			end
			if soonest == nil or entry.expiresAt < soonest then
				soonest = entry.expiresAt
			end
		end
		table.insert(kept, entry)
		table.insert(modifiers, entry.modifier)
	end

	entries[player] = kept
	nextExpiry[player] = soonest
	return modifiers
end

local Stats = {}

function Stats.add(player: Player, modifier: StatModifier)
	local entry: Entry = { modifier = modifier }
	if modifier.duration then
		entry.expiresAt = os.clock() + modifier.duration
	end
	table.insert(listFor(player), entry)
	cache[player] = nil
end

-- Quita todos los modificadores de una fuente concreta: al mejorar un arma se
-- reemplaza su lista en lugar de sumar encima de la anterior.
function Stats.removeSource(player: Player, source: string)
	local list = entries[player]
	if not list then
		return
	end
	local kept = {}
	for _, entry in list do
		if entry.modifier.source ~= source then
			table.insert(kept, entry)
		end
	end
	entries[player] = kept
	cache[player] = nil
end

function Stats.clear(player: Player)
	entries[player] = nil
	cache[player] = nil
	nextExpiry[player] = nil
end

-- Se recalcula solo cuando cambia algo o cuando vence un buff temporal, para que
-- llamarlo en cada frame no genere basura.
function Stats.get(player: Player, now: number?): StatBlock
	local clock = now or os.clock()
	local cached = cache[player]
	local due = nextExpiry[player]
	if cached and (due == nil or clock < due) then
		return cached
	end

	local modifiers = prune(player, clock)
	local stats = StatMath.resolve(Config.PlayerBaseStats, modifiers)
	cache[player] = stats
	return stats
end

-- Segundos restantes de los buffs temporales, para el HUD.
function Stats.buffTimers(player: Player, now: number?): { { Name: string, Remaining: number } }
	local clock = now or os.clock()
	local list = entries[player]
	local timers = {}
	if not list then
		return timers
	end
	for _, entry in list do
		if entry.expiresAt and entry.expiresAt > clock then
			table.insert(timers, {
				Name = entry.modifier.source,
				Remaining = entry.expiresAt - clock,
			})
		end
	end
	return timers
end

return Stats
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="97">
        <Properties>
          <string name="Name">Utility</string>
        </Properties>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">Pool</string>
            <string name="Source"><![CDATA[--!strict
-- Pool de instancias con token de propiedad. El llamante recibe un token junto al
-- objeto y debe devolverlo al liberar; así una referencia retrasada (por ejemplo un
-- impacto pendiente) no puede devolver al pool un objeto que ya fue reciclado.
local Pool = {}
Pool.__index = Pool

export type Pooled = {
	Get: (self: Pool, transform: (Instance) -> ()) -> (Instance, any),
	Release: (self: Pool, instance: Instance, lease: any) -> boolean,
	Count: (self: Pool) -> number,
	Destroy: (self: Pool) -> (),
}

function Pool.new(template: Instance, prewarm: number?): Pool
	local self = setmetatable({
		_template = template,
		_available = {},
		_leases = {},
		_created = 0,
	}, Pool)

	for _ = 1, prewarm or 0 do
		local instance = template:Clone()
		instance.Parent = nil
		table.insert(self._available, instance)
		self._created += 1
	end

	return self
end

function Pool:Get(apply: (Instance) -> ()): (Instance, any)
	local instance = table.remove(self._available)
	if not instance then
		instance = self._template:Clone()
		self._created += 1
	end
	local lease = {}
	self._leases[instance] = lease
	apply(instance)
	return instance, lease
end

function Pool:Release(instance: Instance, lease: any): boolean
	if lease == nil or self._leases[instance] ~= lease then
		return false
	end
	self._leases[instance] = nil
	instance.Parent = nil
	table.insert(self._available, instance)
	return true
end

function Pool:Count(): number
	return #self._available
end

function Pool:Destroy()
	for _, instance in self._available do
		instance:Destroy()
	end
	table.clear(self._available)
	table.clear(self._leases)
end

return Pool
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
